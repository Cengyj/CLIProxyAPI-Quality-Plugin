+	})
+	if err != nil || !strings.Contains(callback, "fixture-code") || !reflect.DeepEqual(phases, []string{"runtime_start", "session"}) {
+		t.Fatalf("native entrypoint or streamed identity failed: %v %v", phases, err)
+	}
+}
+
+func TestNativeRuntimeManifestRejectsInvalidBundles(t *testing.T) {
+	for _, scenario := range []string{"unknown_version", "legacy_version", "wrong_engine", "wrong_schema", "string_schema", "wrong_platform", "wrong_arch", "node_field", "browser_field", "unknown_field", "wrong_entrypoint", "modified_entrypoint", "missing_entrypoint", "unlisted_file", "not_executable", "writable_entrypoint", "permissive_root", "permissive_manifest", "symlink_entrypoint", "symlink_directory", "path_escape", "missing_declared_file"} {
+		t.Run(scenario, func(t *testing.T) {
+			r, root := nativeRuntimeFixture(t, successScript)
+			raw, err := os.ReadFile(r.manifestPath)
+			if err != nil {
+				t.Fatal(err)
+			}
+			doc := ojson.NewDoc(raw)
+			set := func(path string, value any) {
+				t.Helper()
+				if err := doc.Set(path, value); err != nil {
+					t.Fatal(err)
+				}
+			}
+			entrypoint := filepath.Join(root, "bin", "login-runtime")
+			switch scenario {
+			case "unknown_version":
+				set("runtime_version", "2.0.1")
+			case "legacy_version":
+				set("runtime_version", "1.2.2")
+			case "wrong_engine":
+				set("engine", "official_browser_forms")
+			case "wrong_schema":
+				set("schema_version", 3)
+			case "string_schema":
+				set("schema_version", "2")
+			case "wrong_platform":
+				set("platform", "unsupported")
+			case "wrong_arch":
+				set("arch", "unsupported")
+			case "node_field":
+				set("node", "")
+			case "browser_field":
+				set("browser", nil)
+			case "unknown_field":
+				set("fallback", "bin/node")
+			case "wrong_entrypoint":
+				set("entrypoint", "../login-runtime")
+			case "modified_entrypoint":
+				if err := os.WriteFile(entrypoint, []byte("changed"), 0700); err != nil {
+					t.Fatal(err)
+				}
+			case "missing_entrypoint":
+				if err := os.Remove(entrypoint); err != nil {
+					t.Fatal(err)
+				}
+			case "unlisted_file":
+				if err := os.WriteFile(filepath.Join(root, "extra"), nil, 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "not_executable", "writable_entrypoint":
+				mode := os.FileMode(0600)
+				if scenario == "writable_entrypoint" {
+					mode = 0770
+				}
+				if err := os.Chmod(entrypoint, mode); err != nil {
+					t.Fatal(err)
+				}
+			case "permissive_root":
+				if err := os.Chmod(root, 0755); err != nil {
+					t.Fatal(err)
+				}
+			case "symlink_entrypoint":
+				if err := os.Remove(entrypoint); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Symlink("/bin/sh", entrypoint); err != nil {
+					t.Fatal(err)
+				}
+			case "symlink_directory":
+				if err := os.Rename(filepath.Join(root, "bin"), filepath.Join(root, "real-bin")); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Symlink("real-bin", filepath.Join(root, "bin")); err != nil {
+					t.Fatal(err)
+				}
+			case "path_escape", "missing_declared_file":
+				files := map[string]string{}
+				for key, value := range ojson.ParseBytes(raw).Get("files").Map() {
+					files[key] = value.String()
+				}
+				name := "missing"
+				if scenario == "path_escape" {
+					name = "../outside"
+				}
+				files[name] = strings.Repeat("a", 64)
+				set("files", files)
+			}
+			if err := os.WriteFile(r.manifestPath, doc.Bytes(), 0600); err != nil {
+				t.Fatal(err)
+			}
+			if scenario == "permissive_manifest" {
+				if err := os.Chmod(r.manifestPath, 0644); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := r.Capabilities(); err == nil || err.Error() != "runtime_invalid" {
+				t.Fatalf("invalid native bundle accepted: %v", err)
+			}
+		})
+	}
+}
