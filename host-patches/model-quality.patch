diff --git a/internal/pluginhost/management_v8.go b/internal/pluginhost/management_v8.go
new file mode 100644
index 0000000..6d6cf1c
--- /dev/null
+++ b/internal/pluginhost/management_v8.go
@@ -0,0 +1,40 @@
+package pluginhost
+
+import (
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+	log "github.com/sirupsen/logrus"
+)
+
+func (h *Host) registerManagementV8(routes map[string]managementRouteRecord, record capabilityRecord, items []pluginapi.ManagementRoute, reserved map[string]struct{}) {
+	prefix := "/v8/management/plugins/" + record.id
+	for _, item := range items {
+		method := strings.ToUpper(strings.TrimSpace(item.Method))
+		path := strings.TrimSpace(item.Path)
+		if strings.HasPrefix(path, prefix+"/") {
+			path = strings.TrimPrefix(path, prefix)
+		}
+		if !strings.HasPrefix(path, "/") {
+			path = "/" + path
+		}
+		if item.Handler == nil || path == "/" || strings.Contains(path, "..") || strings.Contains(path, "//") || strings.ContainsAny(path, "*:?%# \t\r\n") || strings.ContainsAny(method, " \t\r\n") || method == "" {
+			continue
+		}
+		fullPath := prefix + strings.TrimRight(path, "/")
+		key := managementRouteKey(method, fullPath)
+		if _, conflict := reserved[key]; conflict {
+			continue
+		}
+		if _, conflict := routes[key]; conflict {
+			log.Warnf("pluginhost: conflicting v8 plugin route %s", key)
+			continue
+		}
+		// Native quota endpoints retain their dedicated handlers.
+		if path == "/quota" {
+			continue
+		}
+		item.Path, item.Method = fullPath, method
+		routes[key] = managementRouteRecord{pluginID: record.id, path: record.path, version: record.version, schemaVersion: record.plugin.SchemaVersion, route: item}
+	}
+}
