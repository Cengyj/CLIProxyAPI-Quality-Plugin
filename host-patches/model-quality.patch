+func privateAuthFixture(t *testing.T, root string) []string {
+	t.Helper()
+	private := filepath.Join(root, ".credential-login", "runtime", "manifest.json")
+	if err := os.MkdirAll(filepath.Dir(private), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(private, []byte(`{"type":"codex","access_token":"private-runtime-material"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	alias := filepath.Join(root, "alias.json")
+	if err := os.Symlink(private, alias); err != nil {
+		t.Fatal(err)
+	}
+	dangling := filepath.Join(root, "dangling.json")
+	if err := os.Symlink(filepath.Join(root, ".credential-login", "not-yet-created.json"), dangling); err != nil {
+		t.Fatal(err)
+	}
+	return []string{private, alias, dangling}
+}
+func TestRemoteStoresExcludeReservedLoginPaths(t *testing.T) {
+	root := t.TempDir()
+	paths := privateAuthFixture(t, root)
+	uploads := 0
+	object := &ObjectTokenStore{authDir: root, putObjectFn: func(context.Context, string, []byte, string) error { uploads++; return nil }}
+	git := NewGitTokenStore("", "", "", "")
+	git.SetBaseDir(root)
+	postgres := &PostgresStore{authDir: root, persistAuthFn: func(context.Context, string, []byte) error { uploads++; return nil }}
+	for _, store := range []auth.Store{object, git, postgres} {
+		for _, p := range paths {
+			if _, err := store.Save(context.Background(), &auth.Auth{ID: p, FileName: p, Provider: "codex", Metadata: map[string]any{"type": "codex"}, Attributes: map[string]string{"path": p}}); err == nil {
+				t.Fatal("reserved save accepted")
+			}
+			if err := store.Delete(context.Background(), p); err == nil {
+				t.Fatal("reserved delete accepted")
+			}
+		}
+	}
+	for _, p := range paths {
+		if a, err := object.readAuthFile(p, root); err != nil || a != nil {
+			t.Fatal("object store read private file")
+		}
+		if a, err := git.readAuthFile(p, root); err != nil || a != nil {
+			t.Fatal("git store read private file")
+		}
+		if err := object.PersistAuthFiles(context.Background(), "watcher", p); err != nil {
+			t.Fatal(err)
+		}
+		if err := git.PersistAuthFiles(context.Background(), "watcher", p); err != nil {
+			t.Fatal(err)
+		}
+		if err := postgres.syncAuthFile(context.Background(), p, p); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := postgres.absoluteAuthPath(p); err == nil {
+			t.Fatal("postgres imported reserved remote path")
+		}
+	}
+	if uploads != 0 {
+		t.Fatal("private material reached remote storage")
+	}
+	if err := os.WriteFile(filepath.Join(root, "public.json"), []byte(`{"type":"claude","access_token":"ordinary"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	listed, err := object.List(context.Background())
+	if err != nil || len(listed) != 1 || listed[0].FileName != "public.json" {
+		t.Fatalf("reserved list isolation failed: %v %v", listed, err)
+	}
+	if err = clearAuthMirror(root); err != nil {
+		t.Fatal(err)
+	}
+	for _, p := range paths {
+		if _, err = os.Lstat(p); err != nil {
+			t.Fatal("mirror cleanup deleted private state or its alias")
+		}
+	}
+	if _, err = os.Stat(filepath.Join(root, "public.json")); !os.IsNotExist(err) {
+		t.Fatal("ordinary stale mirror file survived reset")
+	}
+}
+func TestGitReservedFilesNeverEnterAuthCommit(t *testing.T) {
+	root := t.TempDir()
+	remote := setupGitRemoteRepository(t, root, "master", testBranchSpec{name: "master", contents: "offline\n"})
+	store := NewGitTokenStore(remote, "", "", "")
+	store.SetBaseDir(filepath.Join(root, "workspace", "auths"))
+	if err := store.EnsureRepository(); err != nil {
+		t.Fatal(err)
+	}
+	paths := privateAuthFixture(t, store.AuthDir())
+	if err := store.PersistAuthFiles(context.Background(), "ignore private", paths...); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.Save(context.Background(), &auth.Auth{ID: "public.json", FileName: "public.json", Provider: "claude", Metadata: map[string]any{"type": "claude", "access_token": "ordinary"}}); err != nil {
+		t.Fatal(err)
+	}
+	listed, err := store.List(context.Background())
+	if err != nil || len(listed) != 1 {
+		t.Fatalf("git scan included private files: %v %v", listed, err)
+	}
+	assertRemoteTreePath(t, remote, "master", "auths/public.json", true)
+	assertRemoteTreePath(t, remote, "master", "auths/.credential-login/runtime/manifest.json", false)
+	assertRemoteTreePath(t, remote, "master", "auths/alias.json", false)
+}
