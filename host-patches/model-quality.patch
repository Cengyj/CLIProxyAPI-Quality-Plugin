+			stream := &runtimeProgressOutput{failed: make(chan error, 1), request: runtimeTestRequest()}
+			defer stream.clear()
+			_, _ = stream.Write([]byte(scenario.output))
+			final, err := stream.finish()
+			if err == nil || err.Error() != "runtime_protocol_error" || len(final) != 0 {
+				t.Fatalf("invalid stream accepted: %v", err)
+			}
