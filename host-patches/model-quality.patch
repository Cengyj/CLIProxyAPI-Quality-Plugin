+++ b/internal/pluginhost/auth_reserved_path_test.go
@@ -0,0 +1,64 @@
+package pluginhost
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestHostAuthCallbacksExcludePrivateLoginState(t *testing.T) {
+	root := t.TempDir()
+	private := filepath.Join(root, ".credential-login", "runtime", "manifest.json")
+	if err := os.MkdirAll(filepath.Dir(private), 0700); err != nil {
+		t.Fatal(err)
+	}
+	secret := []byte(`{"type":"codex","access_token":"private-login-material"}`)
+	if err := os.WriteFile(private, secret, 0600); err != nil {
+		t.Fatal(err)
+	}
+	alias := filepath.Join(root, "alias.json")
+	if err := os.Symlink(private, alias); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "ordinary.json"), []byte(`{"type":"claude"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	h := New()
+	h.runtimeConfig = &config.Config{AuthDir: root}
+	list, err := h.listAuthFilesFromDisk()
+	if err != nil || len(list) != 1 || list[0].Name != "ordinary.json" {
+		t.Fatalf("disk list exposed private data: %v %v", list, err)
+	}
+	h.SetAuthManager(coreauth.NewManager(nil, nil, nil))
+	for _, p := range []string{private, alias} {
+		a := &coreauth.Auth{ID: p, FileName: filepath.Base(p), Provider: "codex", Attributes: map[string]string{"path": p}}
+		a.EnsureIndex()
+		if _, err = h.currentAuthManager().Register(context.Background(), a); err != nil {
+			t.Fatal(err)
+		}
+		if entry := h.buildHostAuthFileEntry(a); entry != nil {
+			t.Fatal("private auth visible through runtime entry")
+		}
+		if _, _, err = h.authPhysicalJSONByIndex(a.Index); err == nil {
+			t.Fatal("private auth readable through plugin")
+		}
+		if _, err = h.buildAuthsFromFileData(context.Background(), p, secret); err == nil {
+			t.Fatal("private path accepted as auth source")
+		}
+	}
+	if _, err = h.saveAuthFile(context.Background(), "alias.json", []byte(`{"type":"claude"}`)); err == nil {
+		t.Fatal("plugin save followed private symlink")
+	}
+	raw, err := os.ReadFile(private)
+	if err != nil || string(raw) != string(secret) {
+		t.Fatal("private login file changed")
+	}
+	list, err = h.listAuthFiles()
+	if err != nil || len(list) != 0 {
+		t.Fatal("manager list exposed reserved credential records")
+	}
+}
diff --git a/internal/pluginhost/credential_login.go b/internal/pluginhost/credential_login.go
new file mode 100644
index 0000000..86f1655
--- /dev/null
+++ b/internal/pluginhost/credential_login.go
@@ -0,0 +1,70 @@
+package pluginhost
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/authlogin"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginabi"
+)
+
+// CredentialLoginOwner binds work to the active native instance, excluding
+// retired instances that remain loaded solely to release an owned quality pause.
+func (h *Host) CredentialLoginOwner() (authlogin.Owner, error) {
+	if h == nil {
+		return authlogin.Owner{}, errors.New("plugin_unavailable")
+	}
+	h.mu.Lock()
+	lp := h.loaded["model-quality"]
+	if lp == nil || lp.client == nil || lp.callbackInstance == nil || !lp.registered || !lp.credentialLoginReady || lp.needsRecovery {
+		h.mu.Unlock()
+		return authlogin.Owner{}, errors.New("plugin_unavailable")
+	}
+	generation := lp.credentialLoginGeneration
+	h.mu.Unlock()
+	valid := func() bool {
+		h.mu.Lock()
+		defer h.mu.Unlock()
+		return h.loaded["model-quality"] == lp && lp.credentialLoginGeneration == generation && lp.credentialLoginReady && !lp.needsRecovery && !lp.callbackInstance.closed.Load()
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	raw, err := h.callCredentialLoginControl(ctx, lp, pluginabi.MethodCredentialLoginCapabilities, []byte(`{}`))
+	if err != nil || !ojson.ValidBytes(raw) || !ojson.GetBytes(raw, "ok").Bool() || ojson.GetBytes(raw, "result.version").Int() != 1 || !valid() {
+		return authlogin.Owner{}, errors.New("plugin_unavailable")
+	}
+	return authlogin.Owner{ID: uuid.NewString(), Valid: valid, Prepare: func(ctx context.Context, authID, identity, preparationID string) error {
+		if !valid() {
+			return errors.New("plugin_unavailable")
+		}
+		d := ojson.NewDocString(`{}`)
+		for key, value := range map[string]string{"auth_id": authID, "expected_identity": identity, "preparation_id": preparationID} {
+			if err := d.Set(key, value); err != nil {
+				return errors.New("plugin_unavailable")
+			}
+		}
+		raw, err := h.callCredentialLoginControl(ctx, lp, pluginabi.MethodCredentialLoginPrepare, d.Bytes())
+		if err != nil || !ojson.ValidBytes(raw) || !ojson.GetBytes(raw, "ok").Bool() || !ojson.GetBytes(raw, "result.ready").Bool() || ojson.GetBytes(raw, "result.preparation_id").String() != preparationID || !valid() {
+			return errors.New("plugin_unavailable")
+		}
+		return nil
+	}}, nil
+}
+
+// callCredentialLoginControl contains native panics before they can escape an
+// asynchronous commit goroutine and fail the whole host process.
+func (h *Host) callCredentialLoginControl(ctx context.Context, lp *loadedPlugin, method string, request []byte) ([]byte, error) {
+	var raw []byte
+	err, ok := h.safePluginAction(ctx, lp.id, method, func() error {
+		var callErr error
+		raw, callErr = lp.client.Call(ctx, method, request)
+		return callErr
+	})
+	if !ok || err != nil || len(raw) > 16<<10 {
+		return nil, errors.New("plugin_unavailable")
+	}
+	return raw, nil
+}
