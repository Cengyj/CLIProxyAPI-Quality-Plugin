+func TestLoginHealthEvidenceStableAndReauthorizationClearsOldFailure(t *testing.T) {
+	m := newLoginTestManager(t, t.TempDir())
+	a := loginTestExisting(t, m)
+	failureAt := time.Date(2026, 11, 1, 0, 0, 0, 0, time.UTC)
+	m.mu.Lock()
+	m.auths[a.ID].RequiresSignIn = true
+	m.auths[a.ID].RenewalEventAt = failureAt
+	m.mu.Unlock()
+	before, err := m.LoginHealth(a.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.mu.Lock()
+	m.auths[a.ID].Generation++
+	m.auths[a.ID].UpdatedAt = failureAt.Add(time.Hour)
+	m.mu.Unlock()
+	after, err := m.LoginHealth(a.ID)
+	if err != nil || before.Fingerprint != after.Fingerprint || after.FailureObservedAt != failureAt {
+		t.Fatalf("unrelated writes changed evidence: %+v %+v %v", before, after, err)
+	}
+	m.mu.Lock()
+	m.auths[a.ID].RequiresSignIn = false
+	m.auths[a.ID].Status = StatusError
+	m.auths[a.ID].Unavailable = true
+	m.auths[a.ID].LastError = &Error{Code: "unauthorized", HTTPStatus: 401}
+	m.mu.Unlock()
+	after, err = m.LoginHealth(a.ID)
+	if err != nil || before.Fingerprint != after.Fingerprint {
+		t.Fatalf("refined failure classification must retain retry budget: %+v %v", after, err)
+	}
+	result, err := m.CommitLoginCandidate(context.Background(), LoginCommitRequest{
+		CommitID: "automatic-repair", Candidate: loginTestCandidate(a.ID, "repaired"), Expected: after.Snapshot,
+		ExpectedFailureFingerprint: after.Fingerprint,
+		Prepare:                    func(context.Context, string, string) error { return nil },
+	})
+	if err != nil || result.State != "committed" {
+		t.Fatalf("automatic same identity repair: %+v %v", result, err)
+	}
+	healthy, err := m.LoginHealth(a.ID)
+	if err != nil || healthy.RequiresReauth || healthy.Fingerprint != "" || healthy.AutoEligible || healthy.IdentityVersion == before.IdentityVersion {
+		t.Fatalf("old failure survived repair: %+v %v", healthy, err)
+	}
+	m.mu.Lock()
+	m.auths[a.ID].RequiresSignIn = true
+	m.mu.Unlock()
+	newFailure, err := m.LoginHealth(a.ID)
+	if err != nil || !newFailure.AutoEligible || newFailure.Fingerprint == before.Fingerprint {
+		t.Fatalf("new grant must have new evidence: %+v %v", newFailure, err)
+	}
+}
