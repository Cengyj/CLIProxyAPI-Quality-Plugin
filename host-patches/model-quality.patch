+package authlogin
+
+import (
+	"context"
+	"os"
+	"reflect"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	bolt "go.etcd.io/bbolt"
+)
+
+func TestLoginLogsLifecyclePersistenceAndPrivacy(t *testing.T) {
+	opts := offlineOptions(t)
+	now := time.Now().UTC()
+	var ticks atomic.Uint64
+	opts.Now = func() time.Time { return now.Add(time.Duration(ticks.Add(1)) * time.Millisecond) }
+	requests := make(chan RuntimeRequest, 1)
+	opts.Runtime = offlineRuntime{run: func(_ context.Context, request RuntimeRequest) (string, error) {
+		requests <- request
+		return offlineCallback(request.State), nil
+	}}
+	s := offlineService(t, opts)
+	job, err := s.Start(offlineStart())
+	if err != nil {
+		t.Fatal(err)
+	}
+	job = waitLogin(t, s, job.ID, "awaiting_commit")
+	request := <-requests
+	if _, err = s.Commit(context.Background(), job.ID, job.CandidateID, job.Revision); err != nil {
+		t.Fatal(err)
+	}
+	waitLogin(t, s, job.ID, "committed")
+	logs, err := s.Logs(job.ID)
+	if err != nil || logs.Legacy || logs.JobID != job.ID {
+		t.Fatalf("invalid log envelope: %+v %v", logs, err)
+	}
+	want := []string{"queued", "running", "exchanging", "awaiting_commit", "committing", "committed"}
+	if len(logs.Entries) != len(want) {
+		t.Fatalf("lost transitions: %+v", logs.Entries)
+	}
+	var previous time.Time
+	for i, entry := range logs.Entries {
+		stamp, parseErr := time.Parse(time.RFC3339Nano, entry.Time)
+		if entry.ID != uint64(i+1) || entry.Status != want[i] || entry.Level != "info" || parseErr != nil || !stamp.After(previous) {
+			t.Fatalf("invalid ordered event %d: %+v", i, entry)
+		}
+		previous = stamp
+	}
+	raw, err := Encode(logs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, secret := range []string{request.Credentials.Email, request.Credentials.Password, request.Credentials.TOTPSecret, request.AuthorizationURL, request.State, "OFFLINE_CODE_SECRET", "OFFLINE_REFRESH_SECRET", "access_token", "id_token", "authorization_url"} {
+		if secret == "" || strings.Contains(string(raw), secret) {
+			t.Fatal("log response exposed private acquisition data or used an empty fixture")
+		}
+	}
+	logs.Entries[0].Status = "changed-client-copy"
+	stable, err := s.Logs(job.ID)
+	if err != nil || stable.Entries[0].Status != "queued" {
+		t.Fatal("log read exposed mutable internal state")
+	}
+	if err = s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	s = offlineService(t, opts)
+	restored, err := s.Logs(job.ID)
+	if err != nil || !reflect.DeepEqual(stable, restored) {
+		t.Fatalf("restart changed terminal history: %+v %v", restored, err)
+	}
+	if _, err = s.Logs("missing-job"); err == nil || err.Error() != "not_found" {
+		t.Fatal("unknown job logs did not return not_found")
+	}
+}
+
+func testLogJournal(t *testing.T) *journal {
+	t.Helper()
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	j, err := openJournal(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = j.db.Close() })
+	return j
+}
+
+func TestJournalLogsOnlyChangedDiagnosticsAndBoundedHistory(t *testing.T) {
+	j := testLogJournal(t)
+	now := time.Date(2026, 11, 16, 12, 0, 0, 0, time.UTC)
+	j.now = func() time.Time { return now }
+	record := storedJob{View: Job{ID: "bounded", Status: "queued", Phase: "queued"}, Created: now, Updated: now}
+	save := func() {
+		t.Helper()
+		if err := j.save(record); err != nil {
+			t.Fatal(err)
+		}
+		now = now.Add(time.Second)
+	}
+	read := func() JobLogs {
+		t.Helper()
+		logs, err := j.logs(record.View.ID)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return logs
+	}
+	save()
+	record.View.Revision++
+	record.View.AuthorizationURL = "PRIVATE_AUTHORIZATION_URL"
+	record.View.Email = "private@example.test"
+	record.View.VaultError = "vault_unavailable"
+	save()
+	if got := read(); len(got.Entries) != 1 {
+		t.Fatalf("unchanged status generated an event: %+v", got)
+	}
+	for _, mutate := range []func(){
+		func() { record.View.Status, record.View.Phase = "running", "authorization" },
+		func() { record.View.ErrorCode = "credentials_rejected" },
+		func() { record.View.ErrorStage = "password" },
+		func() { record.View.ErrorReason = "upstream_rejected" },
+		func() { record.View.Phase = "review" },
+	} {
+		mutate()
+		save()
+	}
+	if got := read(); len(got.Entries) != 6 || got.Entries[5].ErrorStage != "password" || got.Entries[5].ErrorReason != "upstream_rejected" {
+		t.Fatalf("diagnostic-only changes lost: %+v", got)
+	}
+	for i := 0; i < maxJobLogEntries+7; i++ {
+		if i%2 == 0 {
+			record.View.Phase = "queued"
+		} else {
+			record.View.Phase = "review"
+		}
+		save()
+	}
+	logs := read()
+	if len(logs.Entries) != maxJobLogEntries || logs.Entries[0].ID != 14 || logs.Entries[len(logs.Entries)-1].ID != 213 {
+		t.Fatalf("history cap or stable IDs invalid: %+v", logs)
+	}
+	for i := 1; i < len(logs.Entries); i++ {
+		if logs.Entries[i].ID != logs.Entries[i-1].ID+1 || logs.Entries[i].Time <= logs.Entries[i-1].Time {
+			t.Fatal("history order changed during truncation")
+		}
+	}
+	if _, err := j.logs("missing"); err == nil || err.Error() != "not_found" {
+		t.Fatal("journal returned logs for an unknown job")
+	}
+}
+
+func TestJournalLogsLegacyDoesNotInventHistory(t *testing.T) {
+	j := testLogJournal(t)
+	now := time.Now().UTC()
+	// Encode the old shape without event fields to exercise gob compatibility.
+	old := struct {
+		View             Job
+		Created, Updated time.Time
+	}{View: Job{ID: "legacy", Status: "committed"}, Created: now, Updated: now}
+	if err := j.db.Update(func(tx *bolt.Tx) error { return putGob(tx, "jobs", old.View.ID, old) }); err != nil {
+		t.Fatal(err)
+	}
+	assertEmpty := func() {
+		t.Helper()
+		logs, err := j.logs(old.View.ID)
+		if err != nil || !logs.Legacy || logs.Entries == nil || len(logs.Entries) != 0 {
+			t.Fatalf("legacy history invented or envelope invalid: %+v %v", logs, err)
+		}
+	}
+	assertEmpty()
+	record := storedJob{View: old.View, Created: now, Updated: now}
+	if err := j.save(record); err != nil {
+		t.Fatal(err)
+	}
+	assertEmpty()
+	record.View.Status = "failed"
+	record.View.ErrorCode = "storage_unavailable"
+	if err := j.save(record); err != nil {
+		t.Fatal(err)
+	}
+	logs, err := j.logs(old.View.ID)
+	if err != nil || !logs.Legacy || len(logs.Entries) != 1 || logs.Entries[0].Status != "failed" || logs.Entries[0].ID != 1 {
+		t.Fatalf("real change on a legacy job was not recorded: %+v %v", logs, err)
+	}
+}
+
+func TestJournalLogsConcurrentSavesDoNotDuplicateEvents(t *testing.T) {
+	j := testLogJournal(t)
+	record := storedJob{View: Job{ID: "concurrent", Status: "running", Phase: "authorization"}}
+	const writers = 16
+	results := make(chan error, writers)
+	for i := 0; i < writers; i++ {
+		go func() { results <- j.save(record) }()
+	}
+	for i := 0; i < writers; i++ {
+		if err := <-results; err != nil {
+			t.Fatal(err)
+		}
+	}
+	logs, err := j.logs(record.View.ID)
+	if err != nil || len(logs.Entries) != 1 || logs.Entries[0].ID != 1 || logs.Entries[0].Status != "running" {
+		t.Fatalf("concurrent state saves duplicated or lost the event: %+v %v", logs, err)
+	}
+}
+
+func TestLoginLogsRestoreRecordsActualInterruption(t *testing.T) {
+	opts := offlineOptions(t)
+	s := offlineService(t, opts)
+	job, err := s.Start(StartRequest{ConsumerPlugin: "model-quality", Method: "browser", Intent: "import"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	before, err := s.Logs(job.ID)
+	if err != nil || len(before.Entries) != 2 {
+		t.Fatalf("missing browser start transitions: %+v %v", before, err)
+	}
+	if err = s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	s = offlineService(t, opts)
+	after, err := s.Logs(job.ID)
+	if err != nil || len(after.Entries) != 3 || !reflect.DeepEqual(before.Entries, after.Entries[:2]) || after.Entries[2].Status != "interrupted" || after.Entries[2].Level != "warn" {
+		t.Fatalf("restart fabricated or lost transitions: %+v %v", after, err)
+	}
+}
+
+func TestSafeLogEntryRejectsUnboundedRuntimeMaterial(t *testing.T) {
+	secret := "PRIVATE_PASSWORD_TOTP_TOKEN_AUTH_URL_UPSTREAM_BODY"
+	entry := safeLogEntry(Job{Status: secret, Phase: secret, ErrorCode: secret, ErrorStage: secret, ErrorReason: secret, AuthorizationURL: secret, Email: secret, MaskedEmail: secret, CandidateID: secret, VaultError: secret, TargetAuthID: secret})
+	raw, err := Encode(entry)
+	if err != nil || strings.Contains(string(raw), secret) || entry.Status != "unknown" || entry.ErrorCode != "login_failed" || entry.Phase != "" || entry.ErrorStage != "" || entry.ErrorReason != "" {
+		t.Fatalf("unsafe event projection: %s %v", raw, err)
+	}
+	for status, level := range map[string]string{"committed": "info", "interaction_required": "warn", "failed": "error", "commit_unknown": "error"} {
+		if got := safeLogEntry(Job{Status: status}); got.Level != level {
+			t.Fatalf("wrong event level for %s: %s", status, got.Level)
+		}
+	}
+}
