+	}
+	if err = s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	restarted := offlineService(t, opts)
+	before := runs.Load()
+	account = runDueOfflineAccount(t, restarted, account.ID)
+	if runs.Load() != before || account.LastJobID != auto.LastJobID || !account.AttentionRequired {
+		t.Fatal("restart replayed an interaction-required job")
