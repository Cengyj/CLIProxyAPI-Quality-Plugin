+package auth
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/codex"
+)
+
+var loginCredentialKeys = []string{"id_token", "access_token", "refresh_token", "account_id", "last_refresh", "email", "expired", "plan_type"}
+var loginPolicyKeys = []string{"type", "disabled", "proxy_url", "prefix", "priority", "weight", "excluded_models", "excluded-models", "models", "headers", "use_siwc", "auth_kind", "source_backend", "quota-policy", "cooldown-disabled", "disable-cooling", "request-retry", "websockets", "session-affinity", "force-cooldown", "http-headers"}
+
+// loginCommitIntent contains only hashes and source identity, never OAuth material.
+// It shares the host authority's durable transaction with identity changes, but is
+// separate from quality pauses and from the login service's task database.
+type loginCommitIntent struct {
+	CommitID, AuthID, Principal, Path                   string
+	IsNew                                               bool
+	OldIdentity, NextIdentity, OldGrant, CandidateGrant string
+	Policy                                              LoginSnapshot
+	State                                               string
+	CreatedAt                                           time.Time
+}
+
+func (i loginCommitIntent) pending() bool {
+	return i.State == "committing" || i.State == "saved_not_adopted" || i.State == "commit_unknown"
+}
+func (i loginCommitIntent) result() LoginCommitResult {
+	return LoginCommitResult{CommitID: i.CommitID, AuthID: i.AuthID, IdentityVersion: i.NextIdentity, Principal: i.Principal, State: i.State}
+}
+func fmtLoginUint(n uint64) string { return strconv.FormatUint(n, 10) }
+func fmtLoginBool(b bool) string   { return strconv.FormatBool(b) }
+func loginDiskPolicy(raw []byte) string {
+	doc := ojson.NewDoc(nil)
+	parsed := ojson.ParseBytes(raw)
+	for _, key := range loginPolicyKeys {
+		value := parsed.Get(key)
+		if value.Exists() {
+			_ = doc.Set(key, value.Value())
+		}
+	}
+	return loginHash(doc.String())
+}
+func (m *Manager) loginIntent(commitID string) (loginCommitIntent, bool) {
+	q := m.quality.Load()
+	if q == nil {
+		return loginCommitIntent{}, false
+	}
+	q.mu.RLock()
+	defer q.mu.RUnlock()
+	intent, ok := q.loginCommits[commitID]
+	return intent, ok
+}
+
+// LoginCommitStatus retrieves a secret-free durable receipt or pending outcome.
+func (m *Manager) LoginCommitStatus(commitID string) (LoginCommitResult, error) {
+	intent, ok := m.loginIntent(commitID)
+	if !ok {
+		return LoginCommitResult{}, errors.New("login_commit_not_found")
+	}
+	return intent.result(), nil
+}
+
+// LoginPending reports the narrow commit fence. It never represents a quality pause.
+func (m *Manager) LoginPending(authID string) bool {
+	q := m.quality.Load()
+	if q == nil {
+		return false
+	}
+	q.mu.RLock()
+	defer q.mu.RUnlock()
+	return q.loginPendingLocked(authID)
+}
+func (q *qualityState) loginPendingLocked(authID string) bool {
+	for _, intent := range q.loginCommits {
+		if intent.AuthID == authID && intent.pending() {
+			return true
+		}
+	}
+	return false
+}
+func (m *Manager) loginSaveIntent(intent loginCommitIntent) error {
+	q := m.quality.Load()
+	if q == nil {
+		return errors.New("quality_authority_unavailable")
+	}
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	if q.closed || q.fault != nil {
+		return errors.New("quality_authority_unavailable")
+	}
+	old, exists := q.loginCommits[intent.CommitID]
+	q.loginCommits[intent.CommitID] = intent
+	if err := q.saveLocked(); err != nil {
+		if exists {
+			q.loginCommits[intent.CommitID] = old
+		} else {
+			delete(q.loginCommits, intent.CommitID)
+		}
+		q.fault = err
+		return errors.New("login_journal_unavailable")
+	}
+	return nil
+}
+func (m *Manager) loginAbort(intent loginCommitIntent, reason string) (LoginCommitResult, error) {
+	raw, err := os.ReadFile(intent.Path)
+	safe := intent.IsNew && os.IsNotExist(err)
+	if err == nil {
+		metadata, ok := ojson.ParseBytes(raw).Value().(map[string]any)
+		safe = ok && loginGrant(&Auth{Provider: "codex", Metadata: metadata}) == intent.OldGrant
+	}
+	intent.State = "aborted"
+	if !safe {
+		intent.State = "commit_unknown"
+	}
+	if errSave := m.loginSaveIntent(intent); errSave != nil {
+		return intent.result(), errSave
+	}
+	return intent.result(), errors.New(reason)
+}
+
+// loginIdentityLocked is called with the quality authority lock held. Pending
+// candidates always receive the intent's exact incarnation, including on restart.
+func (q *qualityState) loginIdentityLocked(a *Auth) (bool, error) {
+	for _, intent := range q.loginCommits {
+		if !intent.pending() || intent.AuthID != a.ID {
+			continue
+		}
+		if loginGrant(a) != intent.CandidateGrant {
+			return true, nil
+		}
+		old := q.identities[a.ID]
+		if old.Version != "" && old.Version != intent.OldIdentity && old.Version != intent.NextIdentity {
+			return true, errors.New("login_identity_conflict")
+		}
+		next := qualityIdentity{Version: intent.NextIdentity, Grant: intent.CandidateGrant}
+		if old == next {
+			return true, nil
+		}
+		q.identities[a.ID] = next
+		if err := q.saveLocked(); err != nil {
+			q.identities[a.ID] = old
+			q.fault = err
+			return true, errors.New("login_identity_unavailable")
+		}
+		return true, nil
+	}
+	return false, nil
+}
+
+func (m *Manager) loginPublish(intent loginCommitIntent, metadata map[string]any) (*Auth, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	current := m.auths[intent.AuthID]
+	updated := current.Clone()
+	if updated == nil {
+		updated = &Auth{ID: intent.AuthID, Provider: "codex", FileName: filepath.Base(intent.Path), Status: StatusDisabled, Disabled: true, CreatedAt: time.Now(), Attributes: map[string]string{}}
+	}
+	if updated.Attributes == nil {
+		updated.Attributes = map[string]string{}
+	}
+	updated.Attributes["path"] = intent.Path
+	updated.Attributes["source"] = intent.Path
+	updated.Attributes[AttributeSourceBackend] = AuthSourceFile
+	updated.Metadata = metadata
+	if plan, ok := metadata["plan_type"].(string); ok {
+		updated.Attributes["plan_type"] = plan
+	}
+	updated.Storage = nil
+	updated.CodexRefreshPatch = nil
+	updated.ClearFileSnapshot()
+	// Preserve quota, model cooldowns, disable intent and all unrelated owners.
+	// Only authentication observations tied to the replaced outer grant are reset.
+	updated.RejectedAccessToken = ""
+	updated.RejectedRefreshToken = ""
+	updated.RenewalWarnedRefreshToken = ""
+	updated.RequiresSignIn = updated.RejectedSIWCRefreshToken != ""
+	updated.RefreshError = nil
+	updated.RefreshFailures = 0
+	updated.NextRefreshAfter = time.Time{}
+	updated.RenewalEventAt = time.Time{}
+	updated.InferenceVerified = false
+	updated.LastInferenceVerifiedAt = time.Time{}
+	updated.RenewalVerified = false
+	updated.LastRenewalVerifiedAt = time.Time{}
+	loginClearOuterGrantFailure(updated)
+	updated.AdoptedAt = time.Now()
+	updated.AdoptedGrantHash = AuthGrantFingerprint(updated)
+	updated.UpdatedAt = time.Now()
+	if m.authEpochs == nil {
+		m.authEpochs = map[string]uint64{}
+	}
+	m.authEpochs[updated.ID] = max(m.authEpochs[updated.ID], updated.RegistrationEpoch) + 1
+	updated.RegistrationEpoch = m.authEpochs[updated.ID]
+	updated.CredentialVersion = max(updated.CredentialVersion, 1) + 1
+	updated.Generation++
+	updated.EnsureIndex()
+	q := m.quality.Load()
+	if q == nil {
+		return nil, errors.New("quality_authority_unavailable")
+	}
+	q.mu.Lock()
+	if q.closed || q.fault != nil {
+		q.mu.Unlock()
+		return nil, errors.New("quality_authority_unavailable")
+	}
+	handled, err := q.loginIdentityLocked(updated)
+	q.mu.Unlock()
+	if err != nil {
+		return nil, err
+	}
+	if !handled {
+		return nil, errors.New("login_intent_missing")
+	}
+	m.auths[updated.ID] = updated
+	m.notifyAuthChangeLocked(updated.ID)
+	return updated.Clone(), nil
+}
+func (m *Manager) loginNotify(ctx context.Context, a *Auth, isNew bool) {
+	if !isNew {
+		m.finishAuthUpdate(ctx, a, false)
+		return
+	}
+	m.rebuildAPIKeyModelAliasFromRuntimeConfig()
+	if m.scheduler != nil {
+		m.scheduler.upsertAuth(a.Clone())
+	}
+	m.structuralEpoch.Add(1)
+	m.queueRefreshReschedule(a.ID)
+	m.hook.OnAuthRegistered(ctx, a.Clone())
+}
+
+// ReconcileLoginCommits must run after loading auth files and before enabling the
+// login management service. It never repeats login or exchange and never restores
+// old tokens. Ambiguous files stay fenced until an operator resolves the source.
+func (m *Manager) ReconcileLoginCommits(ctx context.Context, adopt func(context.Context, *Auth) error) error {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	m.loginCommitMu.Lock()
+	defer m.loginCommitMu.Unlock()
+	q := m.quality.Load()
+	if q == nil {
+		return errors.New("quality_authority_unavailable")
+	}
+	q.mu.RLock()
+	intents := []loginCommitIntent{}
+	for _, intent := range q.loginCommits {
+		if intent.pending() {
+			intents = append(intents, intent)
+		}
+	}
+	q.mu.RUnlock()
+	sort.Slice(intents, func(i, j int) bool { return intents[i].CommitID < intents[j].CommitID })
+	var allErrors []error
+	for _, intent := range intents {
+		release, err := m.lockAuthMutationWithPersistCancel(ctx, intent.AuthID, nil)
+		if err != nil {
+			return err
+		}
+		var committed *Auth
+		err = codex.WithFileLock(intent.Path, func() error {
+			raw, errRead := os.ReadFile(intent.Path)
+			if intent.IsNew && os.IsNotExist(errRead) {
+				intent.State = "aborted"
+				return m.loginSaveIntent(intent)
+			}
+			metadata, ok := ojson.ParseBytes(raw).Value().(map[string]any)
+			if errRead != nil || !ok {
+				intent.State = "commit_unknown"
+				_ = m.loginSaveIntent(intent)
+				return errors.New("login_reconcile_source_unknown")
+			}
+			disk := &Auth{Provider: "codex", Metadata: metadata}
+			grant := loginGrant(disk)
+			if grant == intent.OldGrant {
+				q.mu.RLock()
+				identity := q.identities[intent.AuthID]
+				q.mu.RUnlock()
+				if identity.Version != intent.OldIdentity {
+					return errors.New("login_reconcile_identity_conflict")
+				}
+				intent.State = "aborted"
+				return m.loginSaveIntent(intent)
+			}
+			if grant != intent.CandidateGrant {
+				intent.State = "commit_unknown"
+				_ = m.loginSaveIntent(intent)
+				return errors.New("login_reconcile_source_unknown")
+			}
+			principal, errPrincipal := LoginPrincipalFromAuth(disk)
+			if errPrincipal != nil || principal.Key() != intent.Principal {
+				return errors.New("login_reconcile_identity_conflict")
+			}
+			root, errRoot := m.loginRoot()
+			if errRoot != nil {
+				return errRoot
+			}
+			checked, errPath := filepath.EvalSymlinks(intent.Path)
+			relative, errRel := filepath.Rel(root, checked)
+			info, errInfo := os.Lstat(intent.Path)
+			if errPath != nil || errRel != nil || relative == ".." || filepath.IsAbs(relative) || len(relative) > 3 && relative[:3] == ".."+string(filepath.Separator) || errInfo != nil || !info.Mode().IsRegular() {
+				return errors.New("login_reconcile_source_conflict")
+			}
+			intent.State = "saved_not_adopted"
+			if errSave := m.loginSaveIntent(intent); errSave != nil {
+				return errSave
+			}
+			var errPublish error
+			committed, errPublish = m.loginPublish(intent, metadata)
+			return errPublish
+		})
+		release()
+		if err == nil && committed != nil {
+			m.loginNotify(ctx, committed, intent.IsNew)
+			if adopt != nil {
+				err = adopt(ctx, committed.Clone())
+			}
+			if err == nil {
+				intent.State = "committed"
+				err = m.loginSaveIntent(intent)
+			}
+		}
+		if err != nil {
+			allErrors = append(allErrors, err)
+		}
+	}
+	return errors.Join(allErrors...)
+}
+
+// writeLoginFileAtomic reports whether the new grant may already be on disk.
+// A failed directory sync after publication is an unknown outcome, never a retry.
+func writeLoginFileAtomic(path string, data []byte, create bool) (published bool, err error) {
+	dir := filepath.Dir(path)
+	file, err := os.CreateTemp(dir, ".credential-login-*")
+	if err != nil {
+		return false, err
+	}
+	temp := file.Name()
+	defer func() { _ = file.Close(); _ = os.Remove(temp) }()
+	if err = file.Chmod(0600); err != nil {
+		return false, err
+	}
+	if _, err = file.Write(data); err != nil {
+		return false, err
+	}
+	if err = file.Sync(); err != nil {
+		return false, err
+	}
+	if err = file.Close(); err != nil {
+		return false, err
+	}
+	if create {
+		err = os.Link(temp, path)
+	} else {
+		err = os.Rename(temp, path)
+	}
+	if err != nil {
+		return false, err
+	}
+	published = true
+	directory, err := os.Open(dir)
+	if err != nil {
+		return true, err
+	}
+	defer func() { _ = directory.Close() }()
+	if err = directory.Sync(); err != nil {
+		return true, err
+	}
+	return true, nil
+}
+
+// preserveLoginFileRestrictions protects the saved candidate's watcher echo.
+// Ordinary file normalization must not clear restrictions preserved by login.
+func (m *Manager) preserveLoginFileRestrictions(current, incoming *Auth) bool {
+	if current == nil || incoming == nil || current.Disabled != incoming.Disabled || loginGrant(current) != loginGrant(incoming) {
+		return false
+	}
+	q := m.quality.Load()
+	if q == nil {
+		return false
+	}
+	q.mu.RLock()
+	owned := false
+	for _, intent := range q.loginCommits {
+		if intent.AuthID == current.ID && intent.State == "committed" && intent.CandidateGrant == loginGrant(current) {
+			owned = true
+			break
+		}
+	}
+	q.mu.RUnlock()
+	if !owned {
+		return false
+	}
+	snapshot := current.Clone()
+	incoming.Status = snapshot.Status
+	incoming.StatusMessage = snapshot.StatusMessage
+	incoming.Unavailable = snapshot.Unavailable
+	incoming.NextRetryAfter = snapshot.NextRetryAfter
+	incoming.LastError = snapshot.LastError
+	incoming.Quota = snapshot.Quota
+	incoming.ModelStates = snapshot.ModelStates
+	incoming.cooldownRecordedSeq = snapshot.cooldownRecordedSeq
+	incoming.forceCooldownUntil = snapshot.forceCooldownUntil
+	incoming.credQuotaForceUntil = snapshot.credQuotaForceUntil
+	incoming.forceCooldownSeeded = snapshot.forceCooldownSeeded
+	return true
+}
+
+// loginClearOuterGrantFailure removes authentication evidence about the old
+// outer grant while retaining every timed, quota and model restriction.
+func loginClearOuterGrantFailure(a *Auth) {
+	if a == nil || a.RequiresSignIn {
+		return
+	}
+	authenticationError := a.LastError != nil && (isUnauthorizedError(a.LastError) || isInvalidGrantResultError(a.LastError))
+	if !authenticationError {
+		return
+	}
+	a.LastError = nil
+	if strings.Contains(strings.ToLower(a.StatusMessage), "unauthorized") || isInvalidGrantErrorMessage(a.StatusMessage) {
+		a.StatusMessage = ""
+	}
+	hasModelRestriction := false
+	for _, state := range a.ModelStates {
+		if state != nil && (state.Unavailable || state.Quota.Exceeded || !state.NextRetryAfter.IsZero()) {
+			hasModelRestriction = true
+			break
+		}
+	}
+	if !a.Disabled && a.Status != StatusDisabled && !a.Quota.Exceeded && a.NextRetryAfter.IsZero() && a.forceCooldownUntil.IsZero() && a.credQuotaForceUntil.IsZero() && !hasModelRestriction {
+		a.Unavailable = false
+		if a.Status == StatusError {
+			a.Status = StatusActive
+		}
+	}
+}
