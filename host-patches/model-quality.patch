index 0000000..9fc1b05
--- /dev/null
+++ b/sdk/cliproxy/service_credential_login.go
@@ -0,0 +1,64 @@
+package cliproxy
+
+import (
+	"context"
+	"errors"
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+// credentialLoginAdoptHook publishes already committed credentials into local
+// routing without reentering ordinary auth updates, clearing cooldowns, or making
+// upstream/model-discovery calls. Login supports native Codex file credentials only.
+func (s *Service) credentialLoginAdoptHook() coreauth.PostAuthHook {
+	return func(ctx context.Context, a *coreauth.Auth) error {
+		if s == nil || s.coreManager == nil || a == nil || a.Provider != "codex" {
+			return errors.New("login_adoption_unavailable")
+		}
+		if ctx != nil && ctx.Err() != nil {
+			return ctx.Err()
+		}
+		current, ok := s.coreManager.GetByID(a.ID)
+		if !ok || current.RegistrationEpoch != a.RegistrationEpoch || coreauth.AuthGrantFingerprint(current) != coreauth.AuthGrantFingerprint(a) {
+			return errors.New("login_adoption_conflict")
+		}
+		s.ensureExecutorsForAuthWithContext(ctx, current, false)
+		if _, ok = s.coreManager.Executor("codex"); !ok {
+			return errors.New("login_executor_unavailable")
+		}
+		cfg := s.currentConfig()
+		fence := newModelRegistrationFence(current, cfg)
+		published := false
+		if current.Disabled {
+			published = s.unregisterModelsForAuthFenced(current, fence)
+		} else {
+			var models []*ModelInfo
+			switch strings.ToLower(strings.TrimSpace(current.Attributes["plan_type"])) {
+			case "plus":
+				models = registry.GetCodexPlusModels()
+			case "team", "business", "go":
+				models = registry.GetCodexTeamModels()
+			case "free":
+				models = registry.GetCodexFreeModels()
+			default:
+				models = registry.GetCodexProModels()
+			}
+			excluded := oauthExcludedModelsForConfig(cfg, "codex", coreauth.AuthKindOAuth)
+			if own := strings.TrimSpace(current.Attributes["excluded_models"]); own != "" {
+				excluded = strings.Split(own, ",")
+			}
+			models = applyExcludedModels(models, excluded)
+			models = applyOAuthModelAliasForAuth(cfg, "codex", coreauth.AuthKindOAuth, current.Attributes, models)
+			models = s.appendPluginModels("codex", models, excluded)
+			models = applyOAuthSettingsForAuth(cfg, "codex", coreauth.AuthKindOAuth, models)
+			models = applyModelPrefixes(models, current.Prefix, cfg != nil && cfg.ForceModelPrefix)
+			published = s.registerResolvedModelsForAuthFenced(current, fence, "codex", models)
+		}
+		if !published {
+			return errors.New("login_adoption_conflict")
+		}
+		return s.coreManager.SyncLoginRegistryState(current.ID, current.RegistrationEpoch)
+	}
+}
