+func (s *loginTestStore) LoginFileStoreRoot() string { return s.root }
+func (s *loginTestStore) Save(_ context.Context, a *Auth) (string, error) {
+	path := filepath.Join(s.root, a.ID)
+	doc := ojson.NewDoc(nil)
+	for k, v := range a.Metadata {
+		if err := doc.Set(k, v); err != nil {
+			return "", err
+		}
+	}
+	if err := doc.Set("disabled", a.Disabled); err != nil {
+		return "", err
+	}
+	_, err := writeLoginFileAtomic(path, doc.Bytes(), false)
+	return path, err
+}
+func (s *loginTestStore) Delete(_ context.Context, id string) error {
+	return os.Remove(filepath.Join(s.root, id))
+}
+func (s *loginTestStore) List(context.Context) ([]*Auth, error) {
+	entries, err := os.ReadDir(s.root)
+	if err != nil {
+		return nil, err
+	}
+	out := []*Auth{}
+	for _, entry := range entries {
+		if !strings.HasSuffix(entry.Name(), ".json") {
+			continue
+		}
+		path := filepath.Join(s.root, entry.Name())
+		raw, errRead := os.ReadFile(path)
+		if errRead != nil {
+			return nil, errRead
+		}
+		metadata, ok := ojson.ParseBytes(raw).Value().(map[string]any)
+		if !ok {
+			continue
+		}
+		disabled, _ := metadata["disabled"].(bool)
+		a := &Auth{ID: entry.Name(), FileName: entry.Name(), Provider: "codex", Metadata: metadata, Disabled: disabled, Status: StatusActive, Attributes: map[string]string{"path": path, "source_backend": "file"}}
+		if disabled {
+			a.Status = StatusDisabled
+		}
+		out = append(out, a)
+	}
+	return out, nil
+}
+func loginTestJWT(account, user, nonce string) string {
+	doc := ojson.NewDoc(nil)
+	_ = doc.Set("https://api\\.openai\\.com/auth", map[string]string{"chatgpt_account_id": account, "chatgpt_user_id": user})
+	_ = doc.Set("email", "offline@example.test")
+	_ = doc.Set("sub", user)
+	_ = doc.Set("nonce", nonce)
+	return "e30." + base64.RawURLEncoding.EncodeToString(doc.Bytes()) + ".signature"
+}
+func loginTestCandidate(id, nonce string) *Auth {
+	token := loginTestJWT("offline-account", "offline-user", nonce)
+	return &Auth{ID: id, FileName: id, Provider: "codex", Status: StatusActive, Metadata: map[string]any{"type": "codex", "account_id": "offline-account", "email": "offline@example.test", "id_token": token, "access_token": token, "refresh_token": "offline-refresh-" + nonce, "plan_type": "plus"}}
