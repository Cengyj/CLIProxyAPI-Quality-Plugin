+type qualityTransportFunc func(*http.Request) (*http.Response, error)
+
+func (f qualityTransportFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+type qualityPreparingExecutor struct {
+	qualityTestExecutor
+	prepared, proceed chan struct{}
+	submitted         atomic.Int64
+}
+
+func (e *qualityPreparingExecutor) Execute(ctx context.Context, _ *Auth, _ ex.Request, _ ex.Options) (ex.Response, error) {
+	client := httptransport.Decorate(ctx, &http.Client{Transport: qualityTransportFunc(func(r *http.Request) (*http.Response, error) {
+		e.submitted.Add(1)
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader("21")), Header: make(http.Header)}, nil
+	})})
+	close(e.prepared)
+	<-e.proceed
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, "http://offline.invalid/model", strings.NewReader("{}"))
+	if err != nil {
+		return ex.Response{}, err
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		return ex.Response{}, err
+	}
+	return ex.Response{}, resp.Body.Close()
+}
+func TestQualityPauseDuringPreparationStopsFinalTransportSubmission(t *testing.T) {
+	m, _, a := newQualityManager(t, filepath.Join(t.TempDir(), "quality.db"))
+	e := &qualityPreparingExecutor{prepared: make(chan struct{}), proceed: make(chan struct{})}
+	m.RegisterExecutor(e)
+	result := make(chan error, 1)
+	go func() {
+		_, err := m.Execute(context.Background(), []string{a.Provider}, ex.Request{Model: "quality-model-a"}, ex.Options{})
+		result <- err
+	}()
+	<-e.prepared
+	pauseQualityTest(t, m, a, "model-quality", "action-1")
+	close(e.proceed)
+	if err := <-result; err == nil {
+		t.Fatal("request prepared before pause was admitted afterward")
+	}
+	if e.submitted.Load() != 0 {
+		t.Fatal("paused request reached final upstream transport")
+	}
+}
+
+func TestQualityConfigKeyExcludedAllRemainsOperatorDisable(t *testing.T) {
+	m, _, a := newQualityManager(t, filepath.Join(t.TempDir(), "quality.db"))
+	p := pauseQualityTest(t, m, a, "model-quality", "action-1")
+	current, _ := m.GetByID(a.ID)
+	current.Attributes["excluded_models"] = "*"
+	if _, err := m.Update(context.Background(), current); err != nil {
+		t.Fatal(err)
+	}
+	target, _ := m.QualityTarget(a.ID)
+	if !target.OperatorDisabled || target.NativeDisabled || target.EffectiveAvailable {
+		t.Fatal("config exclusion mislabeled as native Enabled")
+	}
+	if _, err := m.QualityRetestContext(context.Background(), "model-quality", "instance", p); err == nil {
+		t.Fatal("config disabled key retested")
+	}
+	if _, err := m.ReleaseQualityVerified(context.Background(), "model-quality", p, []string{"quality-model-a"}); err == nil {
+		t.Fatal("config disabled key recovered")
+	}
+	if _, err := m.ReleaseQuality(context.Background(), "model-quality", p); err != nil {
+		t.Fatal(err)
+	}
+	current, _ = m.GetByID(a.ID)
+	if current.Attributes["excluded_models"] != "*" {
+		t.Fatal("release cleared config exclusion")
+	}
+	target, _ = m.QualityTarget(a.ID)
+	p.ActionID = "action-2"
+	p.IdentityVersion = target.IdentityVersion
+	if _, err := m.PauseQuality(context.Background(), "model-quality", p); err == nil {
+		t.Fatal("claimed an operator-disabled credential")
+	}
+}
+
+func TestQualityComparisonIgnoresProviderRoutingAliases(t *testing.T) {
+	for _, kind := range []string{"api_key", "email"} {
+		t.Run(kind, func(t *testing.T) {
+			m, _, a := newQualityManager(t, filepath.Join(t.TempDir(), "quality.db"))
+			if kind == "email" {
+				a.Metadata = map[string]any{"email": "same-account@example.test", "access_token": "fake-access-token"}
+				var err error
+				a, err = m.Update(context.Background(), a)
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			b := a.Clone()
+			b.ID += "-provider-alias"
+			b.Provider = "different-routing-label"
+			if _, err := m.Register(context.Background(), b); err != nil {
+				t.Fatal(err)
+			}
+			first, err := m.QualityTarget(a.ID)
+			if err != nil {
+				t.Fatal(err)
+			}
+			alias, err := m.QualityTarget(b.ID)
+			if err != nil {
