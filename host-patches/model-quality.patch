index 0000000..b633a75
--- /dev/null
+++ b/sdk/pluginapi/quality.go
@@ -0,0 +1,52 @@
+package pluginapi
+
+import "time"
+
+// QualityPause is a durable credential-wide restriction and its CAS identity.
+type QualityPause struct {
+	AuthID          string    `json:"auth_id"`
+	OwnerPlugin     string    `json:"owner_plugin"`
+	RuleID          string    `json:"rule_id"`
+	RuleRevision    uint64    `json:"rule_revision"`
+	ActionID        string    `json:"action_id"`
+	ActionRevision  uint64    `json:"action_revision"`
+	EvidenceRunID   string    `json:"evidence_run_id"`
+	IdentityVersion string    `json:"identity_version"`
+	Reason          string    `json:"reason"`
+	CreatedAt       time.Time `json:"created_at"`
+}
+
+// ModelEvidence describes observed conditions without exposing request secrets.
+type ModelEvidence struct {
+	PayloadConfigVersion string `json:"payload_config_version"`
+	Verified             bool   `json:"verified"`
+	Reason               string `json:"reason,omitempty"`
+	RequestedModel       string `json:"requested_model"`
+	ResolvedModel        string `json:"resolved_model,omitempty"`
+	AuthID               string `json:"auth_id,omitempty"`
+	PayloadFingerprint   string `json:"payload_fingerprint,omitempty"`
+	ConditionsChanged    bool   `json:"conditions_changed"`
+	Path                 string `json:"path,omitempty"`
+}
+
+// QualityTarget is a stable, redacted management snapshot.
+type QualityTarget struct {
+	PayloadConfigVersion string   `json:"payload_config_version"`
+	ComparisonIdentity   string   `json:"comparison_identity"`
+	AuthID               string   `json:"auth_id"`
+	AuthIndex            string   `json:"auth_index"`
+	Provider             string   `json:"provider"`
+	Type                 string   `json:"type"`
+	IdentityVersion      string   `json:"identity_version"`
+	ManualDisabled       bool     `json:"manual_disabled"`
+	QualityPaused        bool     `json:"quality_paused"`
+	EffectiveAvailable   bool     `json:"effective_available"`
+	Reasons              []string `json:"reasons"`
+	CanPause             bool     `json:"can_pause"`
+	// CanRetest remains false under manual-release-only capability v2.
+	CanRetest         bool                        `json:"can_retest"`
+	UnsupportedReason string                      `json:"unsupported_reason,omitempty"`
+	Pauses            []QualityPause              `json:"pauses"`
+	Models            []string                    `json:"models"`
+	Reasoning         map[string]*ThinkingSupport `json:"reasoning"`
+}
