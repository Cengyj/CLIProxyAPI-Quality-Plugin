+func TestAutomaticLoginCommitRechecksEvidenceBeforeWrite(t *testing.T) {
+	for _, stage := range []string{"before_commit", "during_prepare"} {
+		t.Run(stage, func(t *testing.T) {
+			root := t.TempDir()
+			m := newLoginTestManager(t, root)
+			a := loginTestExisting(t, m)
+			m.mu.Lock()
+			m.auths[a.ID].RequiresSignIn = true
+			m.mu.Unlock()
+			h, err := m.LoginHealth(a.ID)
+			if err != nil {
+				t.Fatal(err)
+			}
+			original, err := os.ReadFile(filepath.Join(root, a.ID))
+			if err != nil {
+				t.Fatal(err)
+			}
+			clearFailure := func() {
+				m.mu.Lock()
+				m.auths[a.ID].RequiresSignIn = false
+				m.mu.Unlock()
+			}
+			if stage == "before_commit" {
+				clearFailure()
+			}
+			_, err = m.CommitLoginCandidate(context.Background(), LoginCommitRequest{
+				CommitID: "guarded-repair", Candidate: loginTestCandidate(a.ID, "repaired"), Expected: h.Snapshot,
+				ExpectedFailureFingerprint: h.Fingerprint,
+				Prepare: func(context.Context, string, string) error {
+					clearFailure()
+					return nil
+				},
+			})
+			if err == nil {
+				t.Fatal("obsolete failure was repaired automatically")
+			}
+			actual, errRead := os.ReadFile(filepath.Join(root, a.ID))
+			if errRead != nil || string(actual) != string(original) {
+				t.Fatal("guarded commit changed credential file")
+			}
+		})
+	}
+}
