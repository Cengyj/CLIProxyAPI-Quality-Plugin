new file mode 100644
index 0000000..e028303
--- /dev/null
+++ b/sdk/httptransport/admission.go
@@ -0,0 +1,61 @@
+package httptransport
+
+import (
+	"context"
+	"net/http"
+)
+
+type admissionKey struct{}
+type decorationSuppressedKey struct{}
+
+// WithAdmission installs a trusted host admission check outside business payloads.
+// Admission is checked at transport submission, after all request preparation.
+func WithAdmission(ctx context.Context, check func() error) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, admissionKey{}, check)
+}
+
+// CheckAdmission rejects a new transport submission but never cancels an admitted response.
+func CheckAdmission(ctx context.Context) error {
+	if ctx == nil {
+		return nil
+	}
+	check, _ := ctx.Value(admissionKey{}).(func() error)
+	if check != nil {
+		return check()
+	}
+	return nil
+}
+func decorateAdmission(ctx context.Context, client *http.Client) *http.Client {
+	if ctx == nil || client == nil {
+		return client
+	}
+	if suppressed, _ := ctx.Value(decorationSuppressedKey{}).(bool); suppressed {
+		return client
+	}
+	check, _ := ctx.Value(admissionKey{}).(func() error)
+	if check == nil {
+		return client
+	}
+	next := client.Transport
+	if next == nil {
+		next = http.DefaultTransport
+	}
+	clone := *client
+	clone.Transport = admissionTransport{next, check}
+	return &clone
+}
+
+type admissionTransport struct {
+	next  http.RoundTripper
+	check func() error
+}
+
+func (t admissionTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if err := t.check(); err != nil {
+		return nil, err
+	}
+	return t.next.RoundTrip(req)
+}
