+
+	"github.com/MoeForge/moego/base64"
+	"github.com/MoeForge/moego/ojson"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/codex"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/authlogin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	runtimeexecutor "github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/api/handlers"
+	storeauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/auth"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+type nativeLoginWorker struct{ calls atomic.Int64 }
+
+func (w *nativeLoginWorker) Capabilities() error { return nil }
+func (w *nativeLoginWorker) Run(_ context.Context, r authlogin.RuntimeRequest) (string, error) {
+	w.calls.Add(1)
+	return codex.RedirectURI + "?code=offline-code&state=" + url.QueryEscape(r.State), nil
+}
+func nativeLoginToken() string {
+	d := ojson.NewDocString(`{}`)
+	_ = d.Set("iss", "https://auth.openai.com")
+	_ = d.Set("aud", codex.ClientID)
+	_ = d.Set("exp", time.Now().Add(time.Hour).Unix())
+	_ = d.Set("sub", "offline-user")
+	_ = d.Set("email", "offline@example.test")
+	_ = d.Set("https://api\\.openai\\.com/auth", map[string]string{"chatgpt_account_id": "offline-account", "chatgpt_user_id": "offline-user"})
+	return "e30." + base64.RawURLEncoding.EncodeToString(d.Bytes()) + ".offline"
+}
+func TestCredentialLoginNativeWorkflow(t *testing.T) {
+	library := os.Getenv("MODEL_QUALITY_LIBRARY")
+	if library == "" {
+		t.Skip("set MODEL_QUALITY_LIBRARY to built native plugin")
+	}
+	dir := t.TempDir()
+	pluginDir := filepath.Join(dir, "plugins")
+	authDir := filepath.Join(dir, "auths")
+	for _, p := range []string{pluginDir, authDir} {
+		if err := os.MkdirAll(p, 0700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	raw, err := os.ReadFile(library)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(filepath.Join(pluginDir, "model-quality"+filepath.Ext(library)), raw, 0700); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := config.ParseConfigBytes([]byte(fmt.Sprintf("plugins:\n  enabled: true\n  dir: %q\n  configs:\n    model-quality:\n      enabled: true\n      data_dir: %q\n", pluginDir, filepath.Join(dir, "plugin-state"))))
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg.AuthDir = authDir
+	store := storeauth.NewFileTokenStore()
+	store.SetBaseDir(authDir)
+	manager := coreauth.NewManager(store, nil, nil)
+	manager.SetConfig(cfg)
+	if err = manager.OpenQualityState(filepath.Join(dir, "authority.db")); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = manager.CloseQualityState() })
+	manager.RegisterExecutor(runtimeexecutor.NewCodexExecutor(cfg))
+	host := New()
+	host.SetAuthManager(manager)
+	host.SetModelExecutor(handlers.NewBaseAPIHandlers(&cfg.SDKConfig, manager))
+	host.ApplyConfig(context.Background(), cfg)
+	t.Cleanup(host.ShutdownAll)
+	host.RegisterManagementRoutes(context.Background(), nil)
+	worker := &nativeLoginWorker{}
+	var exchanges atomic.Int64
+	var clock atomic.Int64
+	clock.Store(time.Now().UTC().UnixNano())
+	now := func() time.Time { return time.Unix(0, clock.Load()).UTC() }
+	token := nativeLoginToken()
+	service, err := authlogin.New(authlogin.Options{Dir: filepath.Join(authDir, ".credential-login"), Config: cfg, Manager: manager, Owner: host.CredentialLoginOwner, Runtime: worker, Now: now, Adopt: func(context.Context, *coreauth.Auth) error { return nil }, Exchange: func(_ context.Context, code string, p *codex.PKCECodes, _ string) (*codex.CodexAuthBundle, error) {
+		if code != "offline-code" || p.CodeVerifier == "" {
+			t.Error("lost host PKCE")
+		}
+		exchanges.Add(1)
+		return &codex.CodexAuthBundle{TokenData: codex.CodexTokenData{IDToken: token, AccessToken: token, RefreshToken: fmt.Sprintf("offline-refresh-%d", exchanges.Load()), Expire: time.Now().Add(time.Hour).Format(time.RFC3339)}}, nil
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = service.Close() })
+	wait := func(id, status string) authlogin.Job {
+		t.Helper()
+		deadline := time.NewTimer(10 * time.Second)
+		defer deadline.Stop()
+		tick := time.NewTicker(10 * time.Millisecond)
+		defer tick.Stop()
+		for {
+			job, e := service.Detail(id)
+			if e != nil {
