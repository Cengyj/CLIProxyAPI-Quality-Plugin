diff --git a/internal/pluginhost/quality_callbacks.go b/internal/pluginhost/quality_callbacks.go
new file mode 100644
index 0000000..65f2b0b
--- /dev/null
+++ b/internal/pluginhost/quality_callbacks.go
@@ -0,0 +1,179 @@
+package pluginhost
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginabi"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+func (h *Host) callHostQuality(ctx context.Context, method string, body []byte) ([]byte, error) {
+	if method == pluginabi.MethodHostQualityCapabilities {
+		return marshalRPCResult(map[string]any{"version": 2, "manual_release_only": true, "quality_retest": false, "automatic_recovery": false, "management_v8": true, "model_operations": true, "quality_pause": true, "evidence_paths": []string{"openai-compatible/chat/completions"}})
+	}
+	if method == pluginabi.MethodHostQualityReleaseVerified {
+		return nil, fmt.Errorf("automatic_recovery_disabled_manual_release_required")
+	}
+	manager := h.currentAuthManager()
+	if manager == nil {
+		return nil, fmt.Errorf("quality authority unavailable")
+	}
+	if method == pluginabi.MethodHostQualityTargets {
+		var req struct {
+			AuthID string `json:"auth_id"`
+		}
+		if len(body) > 0 {
+			if !ojson.ValidBytes(body) {
+				return nil, fmt.Errorf("invalid quality target JSON")
+			}
+			req.AuthID = ojson.GetBytes(body, "auth_id").String()
+		}
+		targets := manager.QualityTargets()
+		if req.AuthID != "" {
+			t, err := manager.QualityTarget(req.AuthID)
+			if err != nil {
+				return nil, err
+			}
+			targets = []coreauth.QualityTarget{t}
+		}
+		out := make([]pluginapi.QualityTarget, 0, len(targets))
+		for _, t := range targets {
+			out = append(out, h.qualityTarget(t))
+		}
+		return marshalRPCResult(map[string]any{"targets": out})
+	}
+	if method == pluginabi.MethodHostQualityActions {
+		return marshalRPCResult(map[string]any{"actions": manager.QualityActions()})
+	}
+	owner := hostCallbackPluginIDFromContext(ctx)
+	instance := hostCallbackInstanceFromContext(ctx)
+	if owner == "" || instance == nil || instance.closed.Load() {
+		return nil, fmt.Errorf("quality mutation requires active native plugin identity")
+	}
+	if h.qualityHomeEnabled() {
+		return nil, fmt.Errorf("quality actions unsupported under Home control")
+	}
+	if method == pluginabi.MethodHostQualityActionStatus {
+		status, action, err := manager.QualityActionStatus(owner, ojson.GetBytes(body, "action_id").String())
+		if err != nil {
+			return nil, err
+		}
+		return marshalRPCResult(map[string]any{"status": status, "action": action})
+	}
+	var pause coreauth.QualityPause
+	if !ojson.ValidBytes(body) {
+		return nil, fmt.Errorf("invalid quality action JSON")
+	}
+	pause = qualityPauseFromJSON(body)
+	if pause.OwnerPlugin != "" && pause.OwnerPlugin != owner {
+		return nil, fmt.Errorf("quality owner mismatch")
+	}
+	pause.OwnerPlugin = owner
+	if method == pluginabi.MethodHostQualityPause {
+		p, err := manager.PauseQuality(ctx, owner, pause)
+		if err != nil {
+			return nil, err
+		}
+		return marshalRPCResult(map[string]any{"action": p})
+	}
+	if method != pluginabi.MethodHostQualityRelease {
+		return nil, fmt.Errorf("unsupported quality operation")
+	}
+	releaseCtx, err := h.manualQualityReleaseContext(ctx, body, pause)
+	if err != nil {
+		return nil, err
+	}
+	t, err := manager.ReleaseQuality(releaseCtx, owner, pause)
+	if err != nil {
+		return nil, err
+	}
+	return marshalRPCResult(map[string]any{"target": h.qualityTarget(t)})
+}
+
+func (h *Host) qualityHomeEnabled() bool {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return h.runtimeConfig != nil && h.runtimeConfig.Home.Enabled
+}
+
+func (h *Host) qualityTarget(t coreauth.QualityTarget) pluginapi.QualityTarget {
+	h.mu.Lock()
+	cfg := h.runtimeConfig
+	h.mu.Unlock()
+	configVersion := ""
+	if cfg != nil {
+		configVersion = coreexecutor.PayloadConfigurationFingerprint(cfg.Payload)
+	}
+	out := pluginapi.QualityTarget{PayloadConfigVersion: configVersion, ComparisonIdentity: t.ComparisonIdentity, AuthID: t.AuthID, AuthIndex: t.AuthIndex, Provider: t.Provider, Type: t.Kind, IdentityVersion: t.IdentityVersion, ManualDisabled: t.OperatorDisabled, QualityPaused: t.QualityPaused, EffectiveAvailable: t.EffectiveAvailable, Reasons: t.UnavailableReasons, CanPause: t.CanPause, CanRetest: t.CanRetest, UnsupportedReason: t.UnsupportedReason, Models: []string{}, Reasoning: map[string]*pluginapi.ThinkingSupport{}, Pauses: []pluginapi.QualityPause{}}
+	for _, p := range t.Pauses {
+		out.Pauses = append(out.Pauses, pluginapi.QualityPause(p))
+	}
+	for _, m := range registry.GetGlobalRegistry().GetModelsForClient(t.AuthID) {
+		if m == nil {
+			continue
+		}
+		out.Models = append(out.Models, m.ID)
+		if m.Thinking != nil {
+			out.Reasoning[m.ID] = &pluginapi.ThinkingSupport{Min: m.Thinking.Min, Max: m.Thinking.Max, ZeroAllowed: m.Thinking.ZeroAllowed, DynamicAllowed: m.Thinking.DynamicAllowed, Levels: append([]string(nil), m.Thinking.Levels...)}
+		} else {
+			out.Reasoning[m.ID] = nil
+		}
+	}
+	if h.qualityHomeEnabled() {
+		out.CanPause = false
+		out.CanRetest = false
+		out.UnsupportedReason = "Home authority does not expose quality controls"
+	}
+	return out
+}
+
+func (h *Host) qualityModelContext(ctx context.Context, req pluginapi.HostModelExecutionRequest) (context.Context, error) {
+	if req.QualityRetest != nil {
+		return nil, fmt.Errorf("quality_retest_disabled_manual_release_required")
+	}
+	return ctx, nil
+}
+
+type manualQualityReleaseScopeKey struct{}
+type manualQualityReleaseScope struct {
+	ruleID, actionID string
+	actionRevision   uint64
+}
+
+// Only a live authenticated v8 release request grants the one-action manual mutation scope.
+func withManualQualityReleaseScope(ctx context.Context, pluginID string, req pluginapi.ManagementRequest) context.Context {
+	if req.Method != "POST" || req.Path != "/v8/management/plugins/"+pluginID+"/actions/release" || !ojson.ValidBytes(req.Body) {
+		return ctx
+	}
+	body := ojson.ParseBytes(req.Body)
+	scope := manualQualityReleaseScope{ruleID: body.Get("rule_id").String(), actionID: body.Get("action_id").String(), actionRevision: body.Get("action_revision").Uint()}
+	if scope.ruleID == "" || scope.actionID == "" || scope.actionRevision == 0 {
+		return ctx
+	}
+	return context.WithValue(ctx, manualQualityReleaseScopeKey{}, scope)
+}
+func (h *Host) manualQualityReleaseContext(ctx context.Context, body []byte, pause coreauth.QualityPause) (context.Context, error) {
+	id := ojson.GetBytes(body, "host_callback_id").String()
+	callbackCtx, owner, instance, exists := h.lookupCallbackContext(id)
+	if !exists || owner != hostCallbackPluginIDFromContext(ctx) || instance == nil || instance != hostCallbackInstanceFromContext(ctx) || instance.closed.Load() {
+		return nil, fmt.Errorf("manual_release_requires_active_management_request")
+	}
+	if err := callbackCtx.Err(); err != nil {
+		return nil, err
+	}
+	scope, ok := callbackCtx.Value(manualQualityReleaseScopeKey{}).(manualQualityReleaseScope)
+	if !ok || scope.ruleID != pause.RuleID || scope.actionID != pause.ActionID || scope.actionRevision != pause.ActionRevision {
+		return nil, fmt.Errorf("manual_release_scope_mismatch")
+	}
+	return callbackCtx, nil
+}
+
+func qualityPauseFromJSON(body []byte) coreauth.QualityPause {
+	d := ojson.ParseBytes(body)
+	return coreauth.QualityPause{AuthID: d.Get("auth_id").String(), OwnerPlugin: d.Get("owner_plugin").String(), RuleID: d.Get("rule_id").String(), RuleRevision: d.Get("rule_revision").Uint(), ActionID: d.Get("action_id").String(), ActionRevision: d.Get("action_revision").Uint(), EvidenceRunID: d.Get("evidence_run_id").String(), IdentityVersion: d.Get("identity_version").String(), Reason: d.Get("reason").String(), CreatedAt: d.Get("created_at").Time()}
+}
