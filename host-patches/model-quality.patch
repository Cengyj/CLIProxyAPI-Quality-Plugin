+func TestAutomaticLoginCommitRechecksConsentAfterPrepare(t *testing.T) {
+	for _, stage := range []string{"before_commit", "during_prepare"} {
+		t.Run(stage, func(t *testing.T) {
+			root := t.TempDir()
+			m := newLoginTestManager(t, root)
+			a := loginTestExisting(t, m)
+			m.mu.Lock()
+			m.auths[a.ID].RequiresSignIn = true
+			m.mu.Unlock()
+			health, err := m.LoginHealth(a.ID)
+			if err != nil {
+				t.Fatal(err)
+			}
+			before, err := os.ReadFile(filepath.Join(root, a.ID))
+			if err != nil {
+				t.Fatal(err)
+			}
+			var allowed atomic.Bool
+			allowed.Store(stage == "during_prepare")
+			prepared := false
+			_, err = m.CommitLoginCandidate(context.Background(), LoginCommitRequest{
+				CommitID: "consent-guarded", Candidate: loginTestCandidate(a.ID, "repaired"), Expected: health.Snapshot,
+				ExpectedFailureFingerprint: health.Fingerprint,
+				AutoConsentGuard: func() error {
+					if !allowed.Load() {
+						return errors.New("automation_disabled")
+					}
+					return nil
+				},
+				Prepare: func(context.Context, string, string) error {
+					prepared = true
+					allowed.Store(false)
+					return nil
+				},
+			})
+			if err == nil || err.Error() != "automation_disabled" || prepared != (stage == "during_prepare") {
+				t.Fatalf("revoked consent accepted or incorrect preparation: prepared=%v err=%v", prepared, err)
+			}
+			after, readErr := os.ReadFile(filepath.Join(root, a.ID))
+			current, healthErr := m.LoginHealth(a.ID)
+			if readErr != nil || string(after) != string(before) || healthErr != nil || current.IdentityVersion != health.IdentityVersion || !current.RequiresReauth || m.LoginPending(a.ID) {
+				t.Fatal("revoked consent changed credential or retained a pending fence")
+			}
+		})
+	}
