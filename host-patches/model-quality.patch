+type qualityTestExecutor struct {
+	calls   atomic.Int64
+	started chan struct{}
+	finish  chan struct{}
+	fail    bool
+}
+
+func (e *qualityTestExecutor) Identifier() string { return "quality-test" }
+func (e *qualityTestExecutor) Execute(ctx context.Context, a *Auth, r ex.Request, o ex.Options) (ex.Response, error) {
+	e.calls.Add(1)
+	if e.started != nil {
+		close(e.started)
+		select {
+		case <-e.finish:
+		case <-ctx.Done():
+			return ex.Response{}, ctx.Err()
+		}
+	}
+	if e.fail {
+		return ex.Response{}, &Error{HTTPStatus: 503, Message: "synthetic failure"}
+	}
+	return ex.Response{Payload: []byte(`{"choices":[{"message":{"content":"21"},"finish_reason":"stop"}]}`)}, nil
+}
+func (e *qualityTestExecutor) ExecuteStream(ctx context.Context, a *Auth, r ex.Request, o ex.Options) (*ex.StreamResult, error) {
+	e.calls.Add(1)
+	ch := make(chan ex.StreamChunk, 1)
+	ch <- ex.StreamChunk{Payload: []byte("data: [DONE]\n\n")}
+	close(ch)
+	return &ex.StreamResult{Chunks: ch}, nil
+}
+func (e *qualityTestExecutor) CountTokens(context.Context, *Auth, ex.Request, ex.Options) (ex.Response, error) {
+	e.calls.Add(1)
+	return ex.Response{Payload: []byte(`{"tokens":1}`)}, nil
+}
+func (e *qualityTestExecutor) Refresh(_ context.Context, a *Auth) (*Auth, error) { return a, nil }
+func (e *qualityTestExecutor) HttpRequest(context.Context, *Auth, *http.Request) (*http.Response, error) {
+	return nil, errors.New("unused")
