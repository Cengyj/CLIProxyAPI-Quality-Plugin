+		t.Fatal("full reload included private runtime files")
+	}
+	if auths := w.SnapshotCoreAuths(); len(auths) != 1 || auths[0].ID != "normal.json" {
+		t.Fatalf("snapshot includes private auths: %d", len(auths))
+	}
+	privateAuth := &coreauth.Auth{ID: "private", Provider: "codex", Attributes: map[string]string{coreauth.AttributePath: alias}}
+	if ok := w.dispatchPersistedAuthUpdate(AuthUpdate{Action: AuthUpdateActionAdd, Auth: privateAuth}); ok {
+		t.Fatal("accepted private persisted auth")
+	}
+	if ok := w.dispatchRuntimeAuthUpdate(AuthUpdate{Action: AuthUpdateActionAdd, Auth: privateAuth}); ok {
+		t.Fatal("accepted private runtime auth")
+	}
+	if w.currentAuths["private"] != nil {
