+package pluginhost
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"testing"
+
+	"github.com/MoeForge/moego/ojson"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginabi"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+type qualityManagementPlugin struct{ calls int }
+
+func (p *qualityManagementPlugin) RegisterManagement(_ context.Context, r pluginapi.ManagementRegistrationRequest) (pluginapi.ManagementRegistrationResponse, error) {
+	return pluginapi.ManagementRegistrationResponse{RoutesV8: []pluginapi.ManagementRoute{{Method: "POST", Path: r.V8BasePath + "/runs", Handler: p}, {Method: "GET", Path: "../other", Handler: p}, {Method: "GET", Path: "/runs/:id", Handler: p}}, Resources: []pluginapi.ResourceRoute{{Path: "/index.html", Handler: p}}}, nil
+}
+func (p *qualityManagementPlugin) HandleManagement(_ context.Context, r pluginapi.ManagementRequest) (pluginapi.ManagementResponse, error) {
+	p.calls++
+	return pluginapi.ManagementResponse{StatusCode: 202, Body: []byte(r.Path)}, nil
+}
+func TestQualityV8RouteNamespacesAndExactMatch(t *testing.T) {
+	p := &qualityManagementPlugin{}
+	h := newHostWithRecords(capabilityRecord{id: "model-quality", plugin: pluginapi.Plugin{SchemaVersion: 8, Capabilities: pluginapi.Capabilities{ManagementAPI: p}}})
+	h.RegisterManagementRoutes(context.Background(), nil)
+	for _, tc := range []struct {
+		method, path string
+		want         bool
+	}{{"POST", "/v8/management/plugins/model-quality/runs", true}, {"GET", "/v8/management/plugins/model-quality/runs", false}, {"POST", "/v0/management/plugins/model-quality/runs", false}, {"GET", "/v8/management/plugins/model-quality/runs/x", false}, {"GET", "/v8/management/plugins/other", false}} {
+		rec := httptest.NewRecorder()
+		if got := h.ServeManagementHTTP(rec, httptest.NewRequest(tc.method, tc.path, nil)); got != tc.want {
+			t.Fatalf("%s %s = %v", tc.method, tc.path, got)
+		}
+	}
+	if p.calls != 1 {
+		t.Fatalf("unexpected calls %d", p.calls)
+	}
+	if h.ServeManagementHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/v0/resource/plugins/model-quality/index.html", nil)) {
+		t.Fatal("resource is not management route")
+	}
+}
+
+func TestQualityNativeCallbackOwnershipAndStableTargets(t *testing.T) {
+	m := coreauth.NewManager(nil, nil, nil)
+	if err := m.OpenQualityState(filepath.Join(t.TempDir(), "quality.db")); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := m.CloseQualityState(); err != nil {
+			t.Error(err)
+		}
+	})
+	a, err := m.Register(context.Background(), &coreauth.Auth{ID: "offline-a", Provider: "offline", Status: coreauth.StatusActive, Attributes: map[string]string{"api_key": "synthetic"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := New()
+	h.SetAuthManager(m)
+	target, err := m.QualityTarget(a.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := pluginapi.QualityPause{AuthID: a.ID, OwnerPlugin: "model-quality", RuleID: "r", RuleRevision: 1, ActionID: "a", ActionRevision: 1, EvidenceRunID: "run", IdentityVersion: target.IdentityVersion, Reason: "test"}
+	d := ojson.NewDocString(`{}`)
+	for key, value := range map[string]any{"auth_id": p.AuthID, "owner_plugin": p.OwnerPlugin, "rule_id": p.RuleID, "rule_revision": p.RuleRevision, "action_id": p.ActionID, "action_revision": p.ActionRevision, "evidence_run_id": p.EvidenceRunID, "identity_version": p.IdentityVersion, "reason": p.Reason} {
+		_ = d.Set(key, value)
+	}
+	body := d.Bytes()
+	if _, err = h.callFromPlugin(context.Background(), pluginabi.MethodHostQualityPause, body); err == nil {
+		t.Fatal("untrusted pause accepted")
+	}
+	ctx := withHostCallbackIdentity(context.Background(), "model-quality", &hostCallbackInstance{})
+	if _, err = h.callFromPlugin(ctx, pluginabi.MethodHostQualityPause, body); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = h.callFromPlugin(withHostCallbackIdentity(context.Background(), "other", &hostCallbackInstance{}), pluginabi.MethodHostQualityRelease, body); err == nil {
+		t.Fatal("foreign release accepted")
+	}
+	raw, err := h.callFromPlugin(ctx, pluginabi.MethodHostQualityTargets, []byte(`{"auth_id":"offline-a"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	res, err := decodeRPCEnvelope[struct {
+		Targets []pluginapi.QualityTarget `json:"targets"`
+	}](raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(res.Targets) != 1 || !res.Targets[0].QualityPaused || res.Targets[0].ManualDisabled {
+		t.Fatalf("invalid paused target %+v", res)
+	}
+	req := pluginapi.HostModelExecutionRequest{AuthID: a.ID, ForcedProvider: "offline", QualityRetest: &p}
+	if _, err = h.qualityModelContext(context.Background(), req); err == nil {
+		t.Fatal("untrusted retest accepted")
+	}
+	if _, err = h.qualityModelContext(ctx, req); err == nil {
+		t.Fatal("native plugin retest accepted")
+	}
+	if res.Targets[0].CanRetest {
+		t.Fatal("target advertised retired retest bypass")
+	}
+	if _, err = h.callFromPlugin(ctx, pluginabi.MethodHostQualityReleaseVerified, body); err == nil {
+		t.Fatal("automatic recovery accepted")
+	}
+	if _, err = h.callFromPlugin(ctx, pluginabi.MethodHostQualityRelease, body); err == nil {
+		t.Fatal("background release accepted")
+	}
+	req.AuthID = "other"
+	if _, err = h.qualityModelContext(ctx, req); err == nil {
+		t.Fatal("mismatched target accepted")
+	}
+	statusBody := []byte(`{"action_id":"a"}`)
+	statusRaw, err := h.callFromPlugin(ctx, pluginabi.MethodHostQualityActionStatus, statusBody)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ojson.GetBytes(statusRaw, "result.status").String() != "active" {
+		t.Fatalf("status %s", statusRaw)
+	}
+	instance := hostCallbackInstanceFromContext(ctx)
+	releaseScope := withManualQualityReleaseScope(ctx, "model-quality", pluginapi.ManagementRequest{Method: "POST", Path: "/v8/management/plugins/model-quality/actions/release", Body: body})
+	callbackID, closeCallback := h.openCallbackContextForPluginInstance(releaseScope, "model-quality", instance)
+	releaseDoc := ojson.NewDoc(body)
+	_ = releaseDoc.Set("host_callback_id", callbackID)
+	releaseBody := releaseDoc.Bytes()
+	if _, err = h.callFromPlugin(ctx, pluginabi.MethodHostQualityRelease, releaseBody); err != nil {
+		t.Fatal(err)
+	}
+	closeCallback()
+	if _, err = h.callFromPlugin(ctx, pluginabi.MethodHostQualityRelease, releaseBody); err == nil {
+		t.Fatal("expired management callback accepted")
+	}
+
+	statusRaw, err = h.callFromPlugin(ctx, pluginabi.MethodHostQualityActionStatus, statusBody)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ojson.GetBytes(statusRaw, "result.status").String() != "released" {
+		t.Fatalf("status %s", statusRaw)
+	}
+}
+
+func TestQualityReleaseScopeRequiresMatchingAuthenticatedAction(t *testing.T) {
+	h := New()
+	instance := &hostCallbackInstance{}
+	ctx := withHostCallbackIdentity(context.Background(), "model-quality", instance)
+	action := coreauth.QualityPause{RuleID: "rule", ActionID: "action", ActionRevision: 1}
+	for _, tc := range []struct {
+		name, method, path, rule, action string
+		revision                         uint64
+		allowed                          bool
+	}{
+		{"release", "POST", "/v8/management/plugins/model-quality/actions/release", "rule", "action", 1, true},
+		{"resource", "GET", "/v0/resource/plugins/model-quality/index.html", "rule", "action", 1, false},
+		{"run", "POST", "/v8/management/plugins/model-quality/runs", "rule", "action", 1, false},
+		{"wrong_action", "POST", "/v8/management/plugins/model-quality/actions/release", "rule", "different", 1, false},
+		{"wrong_rule", "POST", "/v8/management/plugins/model-quality/actions/release", "different", "action", 1, false},
+		{"wrong_revision", "POST", "/v8/management/plugins/model-quality/actions/release", "rule", "action", 2, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			doc := ojson.NewDocString(`{}`)
+			_ = doc.Set("rule_id", tc.rule)
+			_ = doc.Set("action_id", tc.action)
+			_ = doc.Set("action_revision", tc.revision)
+			scoped := withManualQualityReleaseScope(ctx, "model-quality", pluginapi.ManagementRequest{Method: tc.method, Path: tc.path, Body: doc.Bytes()})
+			id, closeCallback := h.openCallbackContextForPluginInstance(scoped, "model-quality", instance)
+			defer closeCallback()
+			request := ojson.NewDocString(`{}`)
+			_ = request.Set("host_callback_id", id)
+			if _, err := h.manualQualityReleaseContext(ctx, request.Bytes(), action); (err == nil) != tc.allowed {
+				t.Fatalf("scope allowed=%v, err=%v", tc.allowed, err)
+			}
+			foreign := withHostCallbackIdentity(context.Background(), "model-quality", &hostCallbackInstance{})
+			if _, err := h.manualQualityReleaseContext(foreign, request.Bytes(), action); err == nil {
+				t.Fatal("foreign instance release allowed")
+			}
+		})
+	}
+	raw, err := h.callFromPlugin(ctx, pluginabi.MethodHostQualityCapabilities, []byte(`{}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ojson.GetBytes(raw, "result.version").Int() != 2 || !ojson.GetBytes(raw, "result.manual_release_only").Bool() || ojson.GetBytes(raw, "result.quality_retest").Bool() || ojson.GetBytes(raw, "result.automatic_recovery").Bool() {
+		t.Fatal(string(raw))
+	}
+}
+
+func TestQualityReleaseScopeRejectsClosedInstanceAndCancelledRequest(t *testing.T) {
+	for _, name := range []string{"closed_instance", "cancelled_request"} {
+		t.Run(name, func(t *testing.T) {
+			h := New()
+			instance := &hostCallbackInstance{}
+			ctx := withHostCallbackIdentity(context.Background(), "model-quality", instance)
+			requestCtx, cancel := context.WithCancel(ctx)
+			defer cancel()
+			action := coreauth.QualityPause{RuleID: "rule", ActionID: "action", ActionRevision: 1}
+			scoped := withManualQualityReleaseScope(requestCtx, "model-quality", pluginapi.ManagementRequest{
+				Method: "POST", Path: "/v8/management/plugins/model-quality/actions/release",
+				Body: []byte(`{"rule_id":"rule","action_id":"action","action_revision":1}`),
+			})
+			id, closeCallback := h.openCallbackContextForPluginInstance(scoped, "model-quality", instance)
+			defer closeCallback()
+			request := ojson.NewDocString(`{}`)
+			_ = request.Set("host_callback_id", id)
+			if _, err := h.manualQualityReleaseContext(ctx, request.Bytes(), action); err != nil {
+				t.Fatalf("active scope rejected: %v", err)
+			}
+			if name == "closed_instance" {
+				instance.closed.Store(true)
+			} else {
+				cancel()
+			}
+			if _, err := h.manualQualityReleaseContext(ctx, request.Bytes(), action); err == nil {
+				t.Fatal("inactive manual release scope accepted")
+			}
+		})
+	}
+}
