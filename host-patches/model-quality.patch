+		t.Run(scenario.name, func(t *testing.T) {
+			r, _ := nativeRuntimeFixture(t, "cat >/dev/null\n"+scenario.script)
+			callback, err := r.Run(context.Background(), runtimeTestRequest())
+			if callback != "" || err == nil || err.Error() != scenario.code {
+				t.Fatalf("native output bypassed validation: %v", err)
+			}
+			if scenario.name == "runtime_start_error" {
+				diagnostic, ok := err.(*runtimeDiagnosticError)
