+func TestAutomaticLoginRechecksHealthAfterQueued(t *testing.T) {
+	for _, state := range []string{"paused", "disabled", "cooldown", "failure_cleared", "identity_changed", "unchanged", "consent_revoked", "manual_paused"} {
+		t.Run(state, func(t *testing.T) {
+			opts := offlineOptions(t)
+			var runs atomic.Int32
+			var followup atomic.Bool
+			opts.Runtime = offlineRuntime{run: func(_ context.Context, request RuntimeRequest) (string, error) {
+				runs.Add(1)
+				if followup.Load() {
+					return "", errors.New("interaction_required")
+				}
+				return offlineCallback(request.State), nil
+			}}
+			s := offlineService(t, opts)
+			account := bindOfflineAccount(t, s)
+			terminalOfflineFailure(t, opts.Manager, account.AuthID)
+			health, err := opts.Manager.LoginHealth(account.AuthID)
+			if err != nil || !health.AutoEligible {
+				t.Fatalf("initial failure is not eligible: %+v / %v", health, err)
+			}
+			before := runs.Load()
+			followup.Store(true)
+
+			// Holding the runtime slot freezes the job after durable admission.
+			select {
+			case s.slot <- struct{}{}:
+			case <-time.After(5 * time.Second):
+				t.Fatal("runtime slot did not become available")
+			}
+			var releaseOnce sync.Once
+			release := func() { releaseOnce.Do(func() { <-s.slot }) }
+			defer release()
+			var consent atomic.Bool
+			consent.Store(true)
+			request := offlineStart()
+			request.Intent, request.TargetAuthID = "reauthorize", account.AuthID
+			request.ExpectedIdentityVersion = health.IdentityVersion
+			request.automatic = state != "manual_paused"
+			if request.automatic {
+				request.autoEvidence = health.Fingerprint
+				request.autoGuard = func() error {
+					if !consent.Load() {
+						return errors.New("automation_disabled")
+					}
+					return nil
+				}
+			}
+			job, err := s.Start(request)
+			if err != nil || job.Status != "queued" {
+				t.Fatalf("job did not queue: %+v / %v", job, err)
+			}
+
+			switch state {
+			case "paused", "manual_paused":
+				target, err := opts.Manager.QualityTarget(account.AuthID)
+				if err != nil {
+					t.Fatal(err)
+				}
+				_, err = opts.Manager.PauseQuality(context.Background(), "model-quality", auth.QualityPause{
+					AuthID: account.AuthID, OwnerPlugin: "model-quality", RuleID: "offline-rule", RuleRevision: 1,
+					ActionID: "offline-action", ActionRevision: 1, IdentityVersion: target.IdentityVersion,
+					EvidenceRunID: "offline-evidence", Reason: "offline fixture",
+				})
+				if err != nil {
+					t.Fatal(err)
+				}
+			case "consent_revoked":
+				consent.Store(false)
+			case "unchanged":
+			default:
+				current, ok := opts.Manager.GetByID(account.AuthID)
+				if !ok {
+					t.Fatal("credential missing")
+				}
+				switch state {
+				case "disabled":
+					current.Disabled, current.Metadata["disabled"] = true, true
+				case "cooldown":
+					current.NextRetryAfter = time.Now().Add(time.Hour)
+				case "failure_cleared":
+					current.Unavailable, current.Status, current.LastError = false, auth.StatusActive, nil
+				case "identity_changed":
+					bundle := offlineBundle(t, time.Now(), "replacement-offline-account")
+					current.Metadata["id_token"] = bundle.TokenData.IDToken
+					current.Metadata["access_token"] = bundle.TokenData.AccessToken
+					current.Metadata["account_id"] = "replacement-offline-account"
+					current.Metadata["refresh_token"] = "OFFLINE_REPLACEMENT_GRANT"
+				}
+				if _, err := opts.Manager.Update(context.Background(), current); err != nil {
+					t.Fatal(err)
+				}
+			}
+			release()
+
+			expectedStatus, expectedCode, expectedRuns := "failed", "policy_changed", before
+			if state == "unchanged" || state == "manual_paused" {
+				expectedStatus, expectedCode, expectedRuns = "interaction_required", "interaction_required", before+1
+			} else if state == "consent_revoked" {
+				expectedCode = "automation_disabled"
+			}
+			result := waitLogin(t, s, job.ID, expectedStatus)
+			if result.ErrorCode != expectedCode || runs.Load() != expectedRuns {
+				t.Fatalf("unexpected execution result: %+v, runtime calls %d (want %d)", result, runs.Load(), expectedRuns)
+			}
+			if state == "paused" || state == "manual_paused" {
+				target, err := opts.Manager.QualityTarget(account.AuthID)
+				if err != nil || !target.QualityPaused {
+					t.Fatalf("login attempt changed quality pause: %+v / %v", target, err)
+				}
+			}
+		})
+	}
+}
+
+func TestAutomaticLoginRechecksBeforeExchange(t *testing.T) {
+	for _, scenario := range []struct{ boundary, state string }{
+		{"runtime_completed", "paused"},
+		{"runtime_completed", "consent_revoked"},
+		{"runtime_completed", "paused_and_consent_revoked"},
+		{"queued_callback", "paused"},
+		{"queued_callback", "consent_revoked"},
+	} {
+		t.Run(scenario.boundary+"/"+scenario.state, func(t *testing.T) {
+			opts := offlineOptions(t)
+			var exchanges atomic.Int32
+			originalExchange := opts.Exchange
+			opts.Exchange = func(ctx context.Context, code string, pkce *codex.PKCECodes, proxy string) (*codex.CodexAuthBundle, error) {
+				exchanges.Add(1)
+				return originalExchange(ctx, code, pkce, proxy)
+			}
+			s := offlineService(t, opts)
+			account := bindOfflineAccount(t, s)
+			terminalOfflineFailure(t, opts.Manager, account.AuthID)
+			health, err := opts.Manager.LoginHealth(account.AuthID)
+			if err != nil || !health.AutoEligible {
+				t.Fatalf("initial failure is not eligible: %+v / %v", health, err)
+			}
+			before := exchanges.Load()
+			entered, resume := make(chan struct{}), make(chan struct{})
+			var releaseOnce sync.Once
+			release := func() { releaseOnce.Do(func() { close(resume) }) }
+			if scenario.boundary == "queued_callback" {
+				s.slot <- struct{}{}
+				release = func() { releaseOnce.Do(func() { <-s.slot }) }
+			}
+			defer release()
+			var consent atomic.Bool
+			consent.Store(true)
+			var guardCalls atomic.Int32
+			request := offlineStart()
+			request.Intent, request.TargetAuthID = "reauthorize", account.AuthID
+			request.ExpectedIdentityVersion = health.IdentityVersion
+			request.automatic, request.autoEvidence = true, health.Fingerprint
+			if scenario.boundary == "queued_callback" {
+				request.Method = "browser"
+			}
+			request.autoGuard = func() error {
+				if guardCalls.Add(1) == 2 && scenario.boundary == "runtime_completed" {
+					// The real runtime has returned its callback and the exchange
+					// worker has acquired its slot. Hold its consent check here.
+					close(entered)
+					<-resume
+				}
+				if !consent.Load() {
+					return errors.New("automation_disabled")
+				}
+				return nil
+			}
+			job, err := s.Start(request)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if scenario.boundary == "queued_callback" {
+				s.mu.Lock()
+				callback := offlineCallback(s.jobs[job.ID].state)
+				s.mu.Unlock()
+				if _, err = s.Callback(job.ID, callback); err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				select {
+				case <-entered:
+				case <-time.After(5 * time.Second):
+					t.Fatal("completed runtime did not reach the exchange check")
+				}
+			}
+			s.mu.Lock()
+			session := s.jobs[job.ID]
+			callback := offlineCallback(session.state)
+			consumed, hasPKCE, status := session.consumed, session.pkce != nil, session.record.View.Status
+			s.mu.Unlock()
+			if !consumed || hasPKCE || status != "exchanging" || exchanges.Load() != before {
+				t.Fatal("callback was not consumed exactly once before exchange")
+			}
+			if scenario.state != "consent_revoked" {
+				target, err := opts.Manager.QualityTarget(account.AuthID)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if _, err = opts.Manager.PauseQuality(context.Background(), "model-quality", auth.QualityPause{
+					AuthID: account.AuthID, OwnerPlugin: "model-quality", RuleID: "offline-rule", RuleRevision: 1,
+					ActionID: "offline-action", ActionRevision: 1, IdentityVersion: target.IdentityVersion,
+					EvidenceRunID: "offline-evidence", Reason: "offline fixture",
+				}); err != nil {
+					t.Fatal(err)
+				}
+			}
+			expectedCode := "policy_changed"
+			if scenario.state != "paused" {
+				consent.Store(false)
+				expectedCode = "automation_disabled"
+			}
+			release()
+			result := waitLogin(t, s, job.ID, "failed")
+			expectedGuards := int32(2)
+			if scenario.boundary == "queued_callback" {
+				expectedGuards = 1
+			}
+			if result.ErrorCode != expectedCode || result.CandidateID != "" || exchanges.Load() != before || guardCalls.Load() != expectedGuards {
+				t.Fatalf("unexpected blocked exchange: %+v, exchanges %d", result, exchanges.Load())
+			}
+			if _, err := s.Callback(job.ID, callback); err == nil || err.Error() != "already_consumed" {
+				t.Fatalf("blocked callback became replayable: %v", err)
+			}
+			if exchanges.Load() != before {
+				t.Fatal("callback replay submitted another token exchange")
+			}
+		})
+	}
+}
