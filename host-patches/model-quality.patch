diff --git a/sdk/cliproxy/executor/evidence.go b/sdk/cliproxy/executor/evidence.go
new file mode 100644
index 0000000..3899f5e
--- /dev/null
+++ b/sdk/cliproxy/executor/evidence.go
@@ -0,0 +1,156 @@
+package executor
+
+import (
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"reflect"
+	"sort"
+	"sync"
+
+	"github.com/MoeForge/moego/ojson"
+)
+
+type evidenceContextKey struct{}
+
+// ExecutionEvidence is a read-only observation of a verified outbound path.
+type ExecutionEvidence struct {
+	PayloadConfigVersion                                                    string
+	Verified                                                                bool
+	Reason, RequestedModel, ResolvedModel, AuthID, PayloadFingerprint, Path string
+	ConditionsChanged                                                       bool
+}
+
+// EvidenceCollector compares frozen caller conditions with the final outbound payload.
+// It deliberately remains unknown for paths without a final observation hook.
+type EvidenceCollector struct {
+	mu               sync.Mutex
+	body             []byte
+	expectedAuth     string
+	result           ExecutionEvidence
+	observations     int
+	upstreamComplete bool
+}
+
+func WithEvidenceCollector(ctx context.Context, model, authID string, body []byte) (context.Context, *EvidenceCollector) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	c := &EvidenceCollector{body: append([]byte(nil), body...), expectedAuth: authID, result: ExecutionEvidence{RequestedModel: model, Reason: "final execution conditions were not observed"}}
+	return context.WithValue(ctx, evidenceContextKey{}, c), c
+}
+
+func (c *EvidenceCollector) Snapshot() ExecutionEvidence {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.result
+}
+
+// ObserveOpenAIQualityPayload runs after the final payload barrier without changing the payload.
+func ObserveOpenAIQualityPayload(ctx context.Context, authID, resolvedModel, fromProtocol, path string, final []byte, configVersion ...string) {
+	if ctx == nil {
+		return
+	}
+	c, _ := ctx.Value(evidenceContextKey{}).(*EvidenceCollector)
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.observations++
+	c.result.Verified = false
+	c.result.AuthID, c.result.ResolvedModel, c.result.Path = authID, resolvedModel, path
+	if len(configVersion) > 0 {
+		c.result.PayloadConfigVersion = configVersion[0]
+	}
+	c.result.PayloadFingerprint = qualityPayloadFingerprint(final, resolvedModel)
+	if fromProtocol != "openai" || path != "openai-compatible/chat/completions" || !ojson.ValidBytes(final) || !ojson.ValidBytes(c.body) || c.expectedAuth == "" || authID != c.expectedAuth {
+		c.result.Reason = "execution path or credential cannot be compared"
+		return
+	}
+	expected := qualityComparablePayload(c.body)
+	actual := qualityComparablePayload(final)
+	c.result.ConditionsChanged = !reflect.DeepEqual(expected, actual) || ojson.GetBytes(final, "model").String() != resolvedModel
+	if c.result.ConditionsChanged {
+		c.result.Verified = false
+		c.result.Reason = "final payload differs from frozen test conditions"
+		return
+	}
+	if c.observations != 1 {
+		c.result.Verified = false
+		c.result.Reason = "multiple upstream attempts require independent evidence"
+		return
+	}
+	c.result.Verified = true
+	c.result.Reason = ""
+}
+
+func qualityComparablePayload(body []byte) map[string]any {
+	d := ojson.ParseBytes(body).Value()
+	m, _ := d.(map[string]any)
+	// These are transport/session fields, not question or reasoning conditions.
+	delete(m, "model")
+	delete(m, "stream")
+	delete(m, "stream_options")
+	delete(m, "prompt_cache_key")
+	if v, ok := m["max_tokens"]; ok {
+		m["max_completion_tokens"] = v
+		delete(m, "max_tokens")
+	}
+	return m
+}
+
+// qualityPayloadFingerprint excludes independent session/transport decoration so
+// different credentials and samples with the same conditions remain comparable.
+func qualityPayloadFingerprint(body []byte, model string) string {
+	m := qualityComparablePayload(body)
+	if m == nil {
+		return ""
+	}
+	m["model"] = model
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	d := ojson.NewDocString(`{}`)
+	for _, k := range keys {
+		if err := d.Set(ojson.Escape(k), m[k]); err != nil {
+			return ""
+		}
+	}
+	return fmt.Sprintf("%x", sha256.Sum256(d.Bytes()))
+}
+
+// PayloadConfigurationFingerprint identifies one immutable payload-rule snapshot.
+func PayloadConfigurationFingerprint(value any) string {
+	d := ojson.NewDocString(`{}`)
+	if err := d.Set("payload", value); err != nil {
+		return ""
+	}
+	return fmt.Sprintf("%x", sha256.Sum256(d.Bytes()))
+}
+
+// FinalizeQualityStreamEvidence records the actual upstream terminal observation.
+// Translator-synthesized completion and a clean early EOF are not proof of completion.
+func FinalizeQualityStreamEvidence(ctx context.Context, complete bool) {
+	if ctx == nil {
+		return
+	}
+	c, _ := ctx.Value(evidenceContextKey{}).(*EvidenceCollector)
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.upstreamComplete = complete
+	if !complete {
+		c.result.Verified = false
+		c.result.Reason = "upstream stream ended without a verified terminal marker"
+	}
+}
+func (c *EvidenceCollector) UpstreamComplete() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.upstreamComplete
+}
