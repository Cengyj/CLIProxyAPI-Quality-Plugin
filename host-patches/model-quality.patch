+++ b/internal/api/handlers/management/quality.go
@@ -0,0 +1,46 @@
+package management
+
+import (
+	"io"
+	"net/http"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/gin-gonic/gin"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	log "github.com/sirupsen/logrus"
+)
+
+// ListQualityPauses remains available when the originating plugin is unloaded.
+func (h *Handler) ListQualityPauses(c *gin.Context) {
+	if h.authManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "quality authority unavailable"})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"actions": h.authManager.QualityActions(), "targets": h.authManager.QualityTargets()})
+}
+
+// ReleaseQualityPause releases one exact owned restriction after management authentication.
+func (h *Handler) ReleaseQualityPause(c *gin.Context) {
+	if h.authManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "quality authority unavailable"})
+		return
+	}
+	body, err := io.ReadAll(http.MaxBytesReader(c.Writer, c.Request.Body, 16384))
+	if err != nil || !ojson.ValidBytes(body) {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid or oversized quality binding"})
+		return
+	}
+	d := ojson.ParseBytes(body)
+	p := coreauth.QualityPause{AuthID: d.Get("auth_id").String(), OwnerPlugin: d.Get("owner_plugin").String(), RuleID: d.Get("rule_id").String(), RuleRevision: d.Get("rule_revision").Uint(), ActionID: d.Get("action_id").String(), ActionRevision: d.Get("action_revision").Uint(), IdentityVersion: d.Get("identity_version").String()}
+	if p.AuthID == "" || p.OwnerPlugin == "" || p.ActionID == "" || p.IdentityVersion == "" || p.RuleRevision == 0 || p.ActionRevision == 0 {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "complete ownership binding required"})
+		return
+	}
+	target, err := h.authManager.ReleaseQualityAdministratively(c.Request.Context(), p)
+	if err != nil {
+		c.JSON(http.StatusConflict, gin.H{"error": err.Error()})
+		return
+	}
+	log.WithFields(log.Fields{"action_id": p.ActionID, "owner_plugin": p.OwnerPlugin}).Info("management operator released owned quality pause")
+	c.JSON(http.StatusOK, gin.H{"target": target, "restriction_released": true, "note": "Only this quality restriction was released; remaining restrictions still apply."})
+}
