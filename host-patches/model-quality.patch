@@ -0,0 +1,111 @@
+package authlogin
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+type offlineProgressRuntime struct {
+	run func(context.Context, RuntimeRequest, func(string) error) (string, error)
+}
+
+func (r offlineProgressRuntime) Capabilities() error { return nil }
+func (r offlineProgressRuntime) Run(context.Context, RuntimeRequest) (string, error) {
+	return "", errors.New("progress interface was not used")
+}
+func (r offlineProgressRuntime) RunWithProgress(ctx context.Context, req RuntimeRequest, report func(string) error) (string, error) {
+	return r.run(ctx, req, report)
+}
+
+func TestRuntimeProgressPersistsRealStagesBeforeCompletion(t *testing.T) {
+	opts := offlineOptions(t)
+	ready, release := make(chan struct{}), make(chan struct{})
+	opts.Runtime = offlineProgressRuntime{run: func(ctx context.Context, request RuntimeRequest, report func(string) error) (string, error) {
+		for _, phase := range []string{"runtime_start", "session", "browser_verification", "email", "password", "totp", "totp", "oauth", "consent", "workspace", "callback"} {
+			if err := report(phase); err != nil {
+				return "", err
+			}
+		}
+		close(ready)
+		select {
+		case <-release:
+			return offlineCallback(request.State), nil
+		case <-ctx.Done():
+			return "", ctx.Err()
+		}
+	}}
+	s := offlineService(t, opts)
+	job, err := s.Start(offlineStart())
+	if err != nil {
+		t.Fatal(err)
+	}
+	<-ready
+	logs, err := s.Logs(job.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var phases []string
+	for _, entry := range logs.Entries {
+		phases = append(phases, entry.Phase)
+	}
+	want := []string{"queued", "authorization", "runtime_start", "session", "browser_verification", "email", "password", "totp", "oauth", "consent", "workspace", "callback"}
+	if !reflect.DeepEqual(phases, want) {
+		t.Fatalf("live persisted phases differ: %v", phases)
+	}
+	if detail, err := s.Detail(job.ID); err != nil || detail.Status != "running" || detail.Phase != "callback" {
+		t.Fatalf("progress reported completion before callback: %+v %v", detail, err)
+	}
+	raw, err := Encode(logs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, secret := range []string{"offline@example.test", "OFFLINE_PASSWORD_SECRET", "JBSWY3DPEHPK3PXP", "OFFLINE_CODE_SECRET", "callback_url", "authorization_url"} {
+		if strings.Contains(string(raw), secret) {
+			t.Fatal("live stage logs contain private data")
+		}
+	}
+	close(release)
+	waitLogin(t, s, job.ID, "awaiting_commit")
+}
+
+func TestRuntimeProgressAfterCancellationCannotReviveJob(t *testing.T) {
+	opts := offlineOptions(t)
+	ready, release := make(chan struct{}), make(chan struct{})
+	reported := make(chan error, 1)
+	opts.Runtime = offlineProgressRuntime{run: func(ctx context.Context, _ RuntimeRequest, report func(string) error) (string, error) {
+		if err := report("session"); err != nil {
+			return "", err
+		}
+		close(ready)
+		<-release
+		err := report("password")
+		reported <- err
+		return "", err
+	}}
+	s := offlineService(t, opts)
+	job, err := s.Start(offlineStart())
+	if err != nil {
+		t.Fatal(err)
+	}
+	<-ready
+	if _, err := s.Cancel(job.ID, false); err != nil {
+		t.Fatal(err)
+	}
+	close(release)
+	if err := <-reported; err == nil || !errors.Is(err, context.Canceled) {
+		t.Fatalf("late progress did not observe cancellation: %v", err)
+	}
+	waitLogin(t, s, job.ID, "cancelled")
+	logs, err := s.Logs(job.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range logs.Entries {
+		if entry.Phase == "password" {
+			t.Fatal("late progress was persisted after cancellation")
+		}
+	}
+}
