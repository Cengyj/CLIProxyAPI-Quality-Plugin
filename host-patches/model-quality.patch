--- /dev/null
+++ b/internal/api/server_plugins_v8.go
@@ -0,0 +1,32 @@
+package api
+
+import (
+	"net/http"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+)
+
+// pluginDispatchNoRoute adds an authenticated v8 dispatcher without changing v0 routing.
+func (s *Server) pluginDispatchNoRoute(c *gin.Context) {
+	if c == nil || c.Request == nil || c.Request.URL == nil || !strings.HasPrefix(c.Request.URL.Path, "/v8/management/plugins/") {
+		s.pluginManagementNoRoute(c)
+		return
+	}
+	if s == nil || s.pluginHost == nil || s.mgmt == nil {
+		c.AbortWithStatus(http.StatusNotFound)
+		return
+	}
+	if !s.managementAvailable(c) {
+		return
+	}
+	s.mgmt.Middleware()(c)
+	if c.IsAborted() {
+		return
+	}
+	if s.pluginHost.ServeManagementHTTP(c.Writer, c.Request) {
+		c.Abort()
+		return
+	}
+	c.AbortWithStatus(http.StatusNotFound)
+}
