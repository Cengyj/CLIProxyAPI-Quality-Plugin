+package usage
+
+import (
+	"context"
+	"testing"
+)
+
+func TestTrustedTrafficSourceDoesNotInferProduction(t *testing.T) {
+	if TrafficSourceFromContext(nil) != "unknown" || TrafficSourceFromContext(context.Background()) != "unknown" {
+		t.Fatal("missing provenance classified as production")
+	}
+	for _, s := range []string{"production", "manual_test", "scheduled_probe", "judge", "internal_other"} {
+		if got := TrafficSourceFromContext(WithTrafficSource(context.Background(), s)); got != s {
+			t.Fatalf("%s became %s", s, got)
+		}
+	}
+	if got := TrafficSourceFromContext(WithTrafficSource(context.Background(), "credential-secret")); got != "unknown" {
+		t.Fatal("untrusted label persisted")
+	}
+}
