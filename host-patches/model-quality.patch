+	if err != nil {
+		t.Fatal(err)
+	}
+	defer restarted.Close()
+	list, err = restarted.Accounts()
+	if err != nil || len(list) != 1 {
+		t.Fatal("accounts did not survive restart")
+	}
+	settings, err = restarted.AccountSettings()
+	if err != nil || settings.IntervalMinutes != 30 || !settings.InspectionEnabled || settings.AutoReloginEnabled {
+		t.Fatal("settings did not survive restart")
+	}
+	if _, err = os.Lstat(filepath.Join(opts.Dir, "vault.key")); !os.IsNotExist(err) {
