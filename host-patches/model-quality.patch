+)
+
+func reservedLoginFixture(t *testing.T) (string, string, string) {
+	t.Helper()
+	dir := t.TempDir()
+	private := filepath.Join(dir, ".credential-login", "runtime", "package.json")
+	if err := os.MkdirAll(filepath.Dir(private), 0700); err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{private, filepath.Join(dir, "normal.json")} {
+		if err := os.WriteFile(path, []byte(`{"type":"codex","email":"fixture@example.test"}`), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	alias := filepath.Join(dir, "private-alias.json")
+	if err := os.Symlink(private, alias); err != nil {
+		t.Fatal(err)
+	}
+	return dir, private, alias
+}
+
+func TestReservedLoginSnapshotAndCaches(t *testing.T) {
+	dir, private, alias := reservedLoginFixture(t)
+	w := &Watcher{authDir: dir, config: &config.Config{AuthDir: dir}}
+	for _, path := range []string{private, alias, filepath.Join(dir, ".credential-login", "missing.json")} {
+		auths, err := w.SnapshotAuthFile(path)
+		if err != nil || len(auths) != 0 {
+			t.Fatalf("private snapshot was not ignored: %v, %d auths", err, len(auths))
+		}
+		if unchanged, err := w.authFileUnchanged(path); err != nil || !unchanged {
+			t.Fatalf("private hash attempted a read: %v", err)
+		}
+		w.addOrUpdateClient(path)
+	}
+	if len(w.currentAuths) != 0 || len(w.lastAuthHashes) != 0 || len(w.fileAuthsByPath) != 0 {
+		t.Fatal("private file entered incremental caches")
+	}
+	if got := w.loadFileClients(w.config); got != 1 {
+		t.Fatalf("auth file count = %d, want only normal file", got)
+	}
