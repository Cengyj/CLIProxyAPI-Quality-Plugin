@@ -0,0 +1,316 @@
+//go:build cgo && (linux || darwin)
+
+package pluginhost
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
