+func TestNativeRuntimeLaunchWithoutNodeOrBrowser(t *testing.T) {
+	t.Setenv("MQ_LOGIN_BROWSER_PATH", "/private/not-a-browser")
+	t.Setenv("NODE_OPTIONS", "--require /private/not-a-module")
+	t.Setenv("HTTPS_PROXY", "http://private:password@example.test")
+	start := strings.ReplaceAll(progressSession, `"session"`, `"runtime_start"`)
+	script := `if [ "$#" -ne 0 ] || [ -n "${MQ_LOGIN_BROWSER_PATH+x}${NODE_OPTIONS+x}${HTTPS_PROXY+x}" ]; then exit 77; fi
+cat >/dev/null
+printf '%s\n' '` + start + `' '` + progressSession + `' '` + progressSuccess + `'
+`
+	r, root := nativeRuntimeFixture(t, script)
+	for _, name := range []string{"bin/node", "browser", "worker.mjs", "node_modules"} {
+		if _, err := os.Lstat(filepath.Join(root, name)); !os.IsNotExist(err) {
+			t.Fatal("native fixture unexpectedly has a browser dependency")
+		}
+	}
+	manifest, err := r.verify()
+	if err != nil || manifest.browser != "" || len(manifest.arguments) != 0 || manifest.executable != filepath.Join(root, "bin", "login-runtime") {
+		t.Fatalf("native manifest selected a browser launcher: %+v %v", manifest, err)
+	}
+	metadata, err := r.Metadata()
+	if err != nil || !reflect.DeepEqual(metadata, map[string]string{"engine": "go_sobek_protocol", "runtime_version": "2.0.0", "schema_version": "2"}) {
+		t.Fatalf("native metadata is not limited to verified engine identity: %v %v", metadata, err)
