+func TestRuntimeInstalledBundleOffline(t *testing.T) {
+	manifest := os.Getenv("MQ_LOGIN_RUNTIME_TEST_MANIFEST")
+	if manifest == "" {
+		t.Skip("set an explicit built runtime manifest for the offline bundle smoke test")
+	}
+	r := NewRuntime(manifest)
+	if err := r.Capabilities(); err != nil {
+		t.Fatal(err)
+	}
+	verified, err := r.verify()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if verified.schema == "2" {
+		if verified.engine != "go_sobek_protocol" || verified.version != "2.0.0" || verified.browser != "" || len(verified.arguments) != 0 {
+			t.Fatal("installed native bundle selected an unexpected launcher")
+		}
+		// The native self-test evaluates JavaScript in Sobek without authentication or network access.
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		cmd := exec.CommandContext(ctx, verified.executable, "--self-test")
+		cmd.Dir = verified.root
+		tmp := t.TempDir()
+		cmd.Env = []string{"PATH=/usr/bin:/bin", "HOME=" + tmp, "TMPDIR=" + tmp, "LANG=en_US.UTF-8"}
+		cmd.WaitDelay = time.Second
+		overflow := make(chan struct{}, 1)
+		stdout := &limitedRuntimeOutput{limit: 4096, overflow: overflow}
+		stderr := &limitedRuntimeOutput{limit: 4096, overflow: overflow}
+		cmd.Stdout, cmd.Stderr = stdout, stderr
+		if err := cmd.Run(); err != nil {
+			t.Fatalf("installed Go/Sobek self-test failed: %v", err)
+		}
+		select {
+		case <-overflow:
+			t.Fatal("installed Go/Sobek self-test exceeded its output limit")
+		default:
+		}
+		if stderr.data.Len() != 0 || !ojson.ValidBytes(stdout.data.Bytes()) {
+			t.Fatal("installed Go/Sobek self-test emitted unexpected output")
+		}
+		result := ojson.ParseBytes(stdout.data.Bytes())
+		if result.Get("version").Int() != 1 || result.Get("runtime_version").String() != verified.version || result.Get("engine").String() != verified.engine || result.Get("platform").String() != runtime.GOOS || result.Get("arch").String() != runtime.GOARCH {
+			t.Fatal("installed Go/Sobek self-test identity does not match its verified manifest")
+		}
+		methods := result.Get("methods").Array()
+		if len(methods) != 1 || methods[0].String() != "password_totp" || result.Get("browser_required").Type != ojson.False || result.Get("node_required").Type != ojson.False {
+			t.Fatal("installed native worker unexpectedly requires a browser or Node")
+		}
+	}
+	// Missing authorization_url is rejected before any authentication network is used.
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	callback, err := r.Run(ctx, runtimeTestRequest())
+	if callback != "" || err == nil || err.Error() != "runtime_protocol_error" {
+		t.Fatalf("unexpected bundled worker response: %v", err)
+	}
+}
