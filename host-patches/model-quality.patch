+package executor
+
+import (
+	"context"
+	"testing"
+)
+
+func TestQualityEvidenceOnlyVerifiesFinalComparablePayload(t *testing.T) {
+	body := []byte(`{"model":"alias","messages":[{"role":"user","content":"Answer only 7"}],"max_tokens":64,"temperature":0}`)
+	for _, tc := range []struct {
+		name, final, auth, path string
+		ok, changed             bool
+	}{
+		{"exact", `{"temperature":0,"max_completion_tokens":64,"messages":[{"content":"Answer only 7","role":"user"}],"model":"real","stream":true,"stream_options":{"include_usage":true}}`, "a", "openai-compatible/chat/completions", true, false},
+		{"rewritten question", `{"model":"real","messages":[{"role":"user","content":"Answer 9"}],"max_tokens":64,"temperature":0}`, "a", "openai-compatible/chat/completions", false, true},
+		{"budget", `{"model":"real","messages":[{"role":"user","content":"Answer only 7"}],"max_tokens":1,"temperature":0}`, "a", "openai-compatible/chat/completions", false, true},
+		{"wrong auth", string(body), "b", "openai-compatible/chat/completions", false, false},
+		{"unknown path", string(body), "a", "unknown", false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, c := WithEvidenceCollector(context.Background(), "alias", "a", body)
+			ObserveOpenAIQualityPayload(ctx, tc.auth, "real", "openai", tc.path, []byte(tc.final))
+			got := c.Snapshot()
+			if got.Verified != tc.ok || got.ConditionsChanged != tc.changed {
+				t.Fatalf("evidence=%+v", got)
+			}
+		})
+	}
+	ctx, c := WithEvidenceCollector(context.Background(), "alias", "a", body)
+	if c.Snapshot().Verified {
+		t.Fatal("unobserved path verified")
+	}
+	final := []byte(`{"model":"real","messages":[{"role":"user","content":"Answer only 7"}],"max_tokens":64,"temperature":0}`)
+	ObserveOpenAIQualityPayload(ctx, "a", "real", "openai", "openai-compatible/chat/completions", final)
+	ObserveOpenAIQualityPayload(ctx, "a", "real", "openai", "openai-compatible/chat/completions", final)
+	if c.Snapshot().Verified {
+		t.Fatal("multiple attempts verified")
+	}
+}
+
+func TestQualityFingerprintIgnoresOnlyTransportAndSessionDecoration(t *testing.T) {
+	a := []byte(`{"model":"alias","messages":[{"role":"user","content":"same"}],"max_tokens":64,"prompt_cache_key":"session-a","stream":false}`)
+	b := []byte(`{"stream_options":{"include_usage":true},"prompt_cache_key":"session-b","messages":[{"content":"same","role":"user"}],"model":"different-alias","max_completion_tokens":64,"stream":true}`)
+	if qualityPayloadFingerprint(a, "resolved") != qualityPayloadFingerprint(b, "resolved") {
+		t.Fatal("equivalent conditions differ")
+	}
+	if qualityPayloadFingerprint(a, "resolved") == qualityPayloadFingerprint(a, "other") {
+		t.Fatal("different actual models collapsed")
+	}
+	c := []byte(`{"messages":[{"role":"user","content":"changed"}],"max_tokens":64}`)
+	if qualityPayloadFingerprint(a, "resolved") == qualityPayloadFingerprint(c, "resolved") {
+		t.Fatal("different questions collapsed")
+	}
+}
+
+func TestQualityStreamRequiresActualTerminalObservation(t *testing.T) {
+	body := []byte(`{"model":"m","messages":[{"role":"user","content":"q"}]}`)
+	for _, complete := range []bool{false, true} {
+		ctx, c := WithEvidenceCollector(context.Background(), "m", "a", body)
+		ObserveOpenAIQualityPayload(ctx, "a", "m", "openai", "openai-compatible/chat/completions", body)
+		FinalizeQualityStreamEvidence(ctx, complete)
+		if c.UpstreamComplete() != complete || c.Snapshot().Verified != complete {
+			t.Fatalf("terminal=%v evidence=%+v", complete, c.Snapshot())
+		}
+	}
+}
diff --git a/sdk/cliproxy/service_credential_login.go b/sdk/cliproxy/service_credential_login.go
