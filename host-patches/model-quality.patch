+
+func TestLoginProxyValidation(t *testing.T) {
+	for _, sample := range []struct{ input, want, code string }{
+		{"", "", ""}, {" off ", "direct", ""}, {"DIRECT", "direct", ""}, {"none", "direct", ""},
+		{"http://127.0.0.1:8080/", "http://127.0.0.1:8080", ""},
+		{"https://fixture:secret%40value@proxy.example:443", "https://fixture:secret%40value@proxy.example:443", ""},
+		{"socks5h://[::1]:1080", "socks5h://[::1]:1080", ""},
+		{"socks5h://[::1]", "socks5h://[::1]:1080", ""},
+		{"socks5://[::1]", "socks5://[::1]:1080", ""},
+		{"socks5h://proxy.example", "socks5h://proxy.example:1080", ""},
+		{"socks5://127.0.0.1", "socks5://127.0.0.1:1080", ""},
+		{"socks5://127.0.0.1:1080", "socks5://127.0.0.1:1080", ""},
+		{"socks5://fixture:secret@proxy.example:1080", "", "proxy_auth_unsupported"},
+		{"socks5h://fixture:secret@proxy.example:1080", "", "proxy_auth_unsupported"},
+		{"http://proxy.example:0", "", "invalid_proxy"}, {"http://proxy.example:65536", "", "invalid_proxy"},
+		{"http://proxy.example:", "", "invalid_proxy"}, {"http://proxy.example:abc", "", "invalid_proxy"},
+		{"http://proxy.example/path", "", "invalid_proxy"}, {"http://proxy.example?", "", "invalid_proxy"},
+		{"http://proxy.example?q=secret", "", "invalid_proxy"}, {"http://proxy.example#", "", "invalid_proxy"},
+		{"http://proxy.example#secret", "", "invalid_proxy"}, {"ftp://proxy.example", "", "invalid_proxy"},
+		{"http://", "", "invalid_proxy"}, {"http://user:%0asecret@proxy.example", "", "invalid_proxy"},
+		{"http://user:%09secret@proxy.example", "", "invalid_proxy"}, {"http://user:%7fsecret@proxy.example", "", "invalid_proxy"},
+		{"http://user:%xx@proxy.example", "", "invalid_proxy"}, {"http://@proxy.example", "", "invalid_proxy"},
+		{"http://proxy.example\nother", "", "invalid_proxy"},
+	} {
+		t.Run(sample.input, func(t *testing.T) {
+			value, err := NormalizeLoginProxy(sample.input)
+			if value != sample.want || SafeCode(err) != sample.code {
+				t.Fatalf("unexpected validation result: value=%q code=%q", value, SafeCode(err))
+			}
+		})
+	}
+	for _, proxy := range []any{true, 42, []string{"http://proxy.example"}, "http://proxy.example/path"} {
+		raw, err := Encode(map[string]any{"consumer_plugin": "model-quality", "method": "browser", "intent": "import", "proxy_url": proxy})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err = DecodeStart(raw); err == nil {
+			t.Fatal("invalid management proxy accepted")
+		}
+	}
+}
+
+func TestAccountLoginProxyPersistsAndDoesNotChangeBusinessProxy(t *testing.T) {
+	opts := offlineOptions(t)
+	opts.Config.ProxyURL = "http://cpa.example:8080"
+	s, err := New(opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	account := bindOfflineAccount(t, s)
+	current, _ := opts.Manager.GetByID(account.AuthID)
+	current.ProxyURL = "http://business.example:8080"
+	if _, err = opts.Manager.Update(context.Background(), current); err != nil {
+		t.Fatal(err)
+	}
+	settings, _ := s.AccountSettings()
+	settings.LoginProxyURL = "http://default.example:8080"
+	if _, err = s.UpdateAccountSettings(settings); err != nil {
+		t.Fatal(err)
+	}
+	detail, _ := s.AccountDetail(account.ID)
+	if detail.Account.EffectiveProxyURL != settings.LoginProxyURL || detail.Account.ProxySource != "login_default" {
+		t.Fatal("global login proxy did not override the business transport for login")
+	}
+	proxy := "https://fixture:secret@account.example:443"
+	account, err = s.UpdateAccount(AccountUpdate{ID: account.ID, Revision: detail.Account.Revision, ProxyURL: &proxy})
+	if err != nil || account.ProxyURL != proxy || account.EffectiveProxyURL != proxy || account.ProxySource != "account" {
+		t.Fatalf("account proxy was not persisted: %v", err)
+	}
+	if _, err = s.UpdateAccount(AccountUpdate{ID: account.ID, Revision: account.Revision, ProxyURL: &proxy}); err != nil {
+		t.Fatal(err)
+	}
+	if err = s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	s = offlineService(t, opts)
+	detail, err = s.AccountDetail(account.ID)
+	if err != nil || detail.Account.ProxyURL != proxy || detail.Account.EffectiveProxyURL != proxy {
+		t.Fatal("account proxy did not survive restart")
+	}
+	restored, _ := s.AccountSettings()
+	if restored.LoginProxyURL != settings.LoginProxyURL {
+		t.Fatal("global login proxy did not survive restart")
+	}
+	proxy = ""
+	account, err = s.UpdateAccount(AccountUpdate{ID: account.ID, Revision: detail.Account.Revision, ProxyURL: &proxy})
+	if err != nil || account.EffectiveProxyURL != settings.LoginProxyURL {
+		t.Fatal("cleared account proxy did not inherit the global login proxy")
+	}
+	restored.LoginProxyURL = ""
+	if _, err = s.UpdateAccountSettings(restored); err != nil {
+		t.Fatal(err)
+	}
+	detail, _ = s.AccountDetail(account.ID)
+	if detail.Account.EffectiveProxyURL != "http://business.example:8080" || detail.Account.ProxySource != "credential" {
+		t.Fatal("cleared global proxy did not inherit the credential proxy")
+	}
+	current, _ = opts.Manager.GetByID(account.AuthID)
+	if current.ProxyURL != "http://business.example:8080" || opts.Config.ProxyURL != "http://cpa.example:8080" {
+		t.Fatal("login settings changed business proxy configuration")
+	}
+}
+
+func TestLoginProxyFrozenForRuntimeAndExchange(t *testing.T) {
+	for _, sample := range []struct{ name, global, override, runtime, exchange string }{
+		{"cpa_fallback", "", "", "http://cpa.example:8080", "http://cpa.example:8080"},
+		{"login_global", "http://global.example:8080", "", "http://global.example:8080", "http://global.example:8080"},
+		{"account_override", "http://global.example:8080", "socks5h://account.example:1080", "socks5h://account.example:1080", "socks5h://account.example:1080"},
+		{"socks_default_port", "", "socks5h://account.example", "socks5h://account.example:1080", "socks5h://account.example:1080"},
+		{"socks_ipv6_default_port", "", "socks5://[::1]", "socks5://[::1]:1080", "socks5://[::1]:1080"},
+		{"explicit_direct", "http://global.example:8080", "off", "", "direct"},
+	} {
+		t.Run(sample.name, func(t *testing.T) {
+			opts := offlineOptions(t)
+			opts.Config.ProxyURL = "http://cpa.example:8080"
+			started := make(chan RuntimeRequest, 1)
+			release := make(chan struct{})
+			exchanged := make(chan string, 1)
+			opts.Runtime = offlineRuntime{run: func(ctx context.Context, request RuntimeRequest) (string, error) {
+				started <- request
+				select {
+				case <-release:
+					return offlineCallback(request.State), nil
+				case <-ctx.Done():
+					return "", ctx.Err()
+				}
+			}}
+			original := opts.Exchange
+			opts.Exchange = func(ctx context.Context, code string, pkce *codex.PKCECodes, proxy string) (*codex.CodexAuthBundle, error) {
+				exchanged <- proxy
+				return original(ctx, code, pkce, proxy)
+			}
+			s := offlineService(t, opts)
+			settings, _ := s.AccountSettings()
+			settings.LoginProxyURL = sample.global
+			if _, err := s.UpdateAccountSettings(settings); err != nil {
+				t.Fatal(err)
+			}
+			accounts, err := s.ImportAccountsWithProxy([]Credentials{offlineStart().Credentials}, sample.override)
+			if err != nil {
+				t.Fatal(err)
+			}
+			job, err := s.StartAccount(accounts[0].ID, accounts[0].Revision, "")
+			if err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case request := <-started:
+				if request.ProxyURL != sample.runtime {
+					t.Fatal("runtime did not receive the selected login proxy")
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("runtime did not start")
+			}
+			settings, _ = s.AccountSettings()
+			settings.LoginProxyURL = "http://new-default.example:8080"
+			if _, err = s.UpdateAccountSettings(settings); err != nil {
+				t.Fatal(err)
+			}
+			account, _ := s.AccountDetail(accounts[0].ID)
+			changed := "http://replacement.example:8080"
+			if _, err = s.UpdateAccount(AccountUpdate{ID: accounts[0].ID, Revision: account.Account.Revision, ProxyURL: &changed}); SafeCode(err) != "conflict" {
+				t.Fatal("running account login allowed its proxy to change")
+			}
+			close(release)
+			waitLogin(t, s, job.ID, "awaiting_commit")
+			if proxy := <-exchanged; proxy != sample.exchange {
+				t.Fatal("token exchange changed the frozen proxy")
+			}
+		})
+	}
+}
+
+func TestInheritedLoginProxyFailureIsVisibleBeforeStarting(t *testing.T) {
+	for _, sample := range []struct{ proxy, code string }{
+		{"socks5://fixture:secret@proxy.example:1080", "proxy_auth_unsupported"},
+		{"http://proxy.example/invalid", "invalid_proxy"},
+	} {
+		t.Run(sample.code, func(t *testing.T) {
+			opts := offlineOptions(t)
+			opts.Config.ProxyURL = sample.proxy
+			s := offlineService(t, opts)
+			account := importOfflineAccount(t, s)
+			if account.ProxyError != sample.code || account.EffectiveProxyURL != sample.proxy || account.ProxySource != "cpa" {
+				t.Fatal("invalid inherited proxy was hidden from the account view")
+			}
+			detail, err := s.AccountDetail(account.ID)
+			if err != nil || detail.Account.ProxyError != sample.code || detail.Account.EffectiveProxyURL != sample.proxy {
+				t.Fatal("account detail hid the inherited proxy failure")
+			}
+			if _, err := s.StartAccount(account.ID, account.Revision, ""); SafeCode(err) != sample.code || len(s.Jobs()) != 0 {
+				t.Fatal("invalid inherited proxy created a login job")
+			}
+			direct := "direct"
+			account, err = s.UpdateAccount(AccountUpdate{ID: account.ID, Revision: account.Revision, ProxyURL: &direct})
+			if err != nil || account.ProxyError != "" || account.EffectiveProxyURL != direct || account.ProxySource != "account" {
+				t.Fatal("valid account override did not clear the inherited proxy error")
+			}
+		})
+	}
+}
+
+func TestRuntimeFailureDiagnosticsAreBoundedAndVisible(t *testing.T) {
+	valid := `{"version":1,"error_code":"interaction_required","error_stage":"totp","error_reason":"totp_method_unconfirmed"}`
+	_, err := runtimeResponse([]byte(valid), RuntimeRequest{}, errors.New("exit 1"))
+	var diagnostic *runtimeDiagnosticError
+	if !errors.As(err, &diagnostic) || diagnostic.stage != "totp" || diagnostic.reason != "totp_method_unconfirmed" || SafeCode(err) != "interaction_required" {
+		t.Fatalf("known diagnostic not accepted: %v", err)
+	}
+	for _, raw := range []string{
+		strings.ReplaceAll(valid, `"totp"`, `"private-password"`),
+		strings.ReplaceAll(valid, `"totp_method_unconfirmed"`, `"https://secret.example?token=secret"`),
+		strings.ReplaceAll(valid, `"totp_method_unconfirmed"`, `42`),
+		strings.ReplaceAll(valid, `"error_code":"interaction_required",`, ``),
+	} {
+		if _, err := runtimeResponse([]byte(raw), RuntimeRequest{}, nil); SafeCode(err) != "runtime_protocol_error" {
+			t.Fatal("unbounded or success-only runtime diagnostic accepted")
+		}
+	}
+	opts := offlineOptions(t)
+	opts.Runtime = offlineRuntime{run: func(context.Context, RuntimeRequest) (string, error) { return "", diagnostic }}
+	s := offlineService(t, opts)
+	account := importOfflineAccount(t, s)
+	job, err := s.StartAccount(account.ID, account.Revision, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	job = waitLogin(t, s, job.ID, "interaction_required")
+	if job.ErrorStage != "totp" || job.ErrorReason != "totp_method_unconfirmed" {
+		t.Fatal("job lost the fixed diagnostic")
+	}
+	accounts, _ := s.Accounts()
+	if accounts[0].LastJobErrorCode != job.ErrorCode || accounts[0].LastJobErrorStage != job.ErrorStage || accounts[0].LastJobErrorReason != job.ErrorReason {
+		t.Fatal("account row lost the latest job diagnostic")
+	}
+}
