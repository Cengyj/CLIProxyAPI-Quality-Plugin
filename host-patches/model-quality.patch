diff --git a/internal/auth/codex/login_exchange.go b/internal/auth/codex/login_exchange.go
new file mode 100644
index 0000000..575ca03
--- /dev/null
+++ b/internal/auth/codex/login_exchange.go
@@ -0,0 +1,49 @@
+package codex
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/MoeForge/moego/ojson"
+)
+
+// ExchangeLoginCode uses the existing Codex transport with bounded, redacted
+// handling for the administrator login workbench. It never logs provider bodies.
+func (o *CodexAuth) ExchangeLoginCode(ctx context.Context, code string, pkce *PKCECodes) (*CodexAuthBundle, error) {
+	if pkce == nil {
+		return nil, errors.New("exchange_failed")
+	}
+	data := url.Values{"grant_type": {"authorization_code"}, "client_id": {ClientID}, "code": {code}, "redirect_uri": {RedirectURI}, "code_verifier": {pkce.CodeVerifier}}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, TokenURL, strings.NewReader(data.Encode()))
+	if err != nil {
+		return nil, errors.New("exchange_failed")
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.Header.Set("Accept", "application/json")
+	client := *o.httpClient
+	client.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, errors.New("exchange_failed")
+	}
+	defer func() { _ = resp.Body.Close() }()
+	raw, err := io.ReadAll(io.LimitReader(resp.Body, (256<<10)+1))
+	if err != nil || len(raw) > 256<<10 || resp.StatusCode != 200 || !ojson.ValidBytes(raw) {
+		return nil, errors.New("exchange_failed")
+	}
+	r := ojson.ParseBytes(raw)
+	access, refresh, id := r.Get("access_token").String(), r.Get("refresh_token").String(), r.Get("id_token").String()
+	if access == "" || refresh == "" || id == "" || !strings.EqualFold(r.Get("token_type").String(), "bearer") {
+		return nil, errors.New("exchange_failed")
+	}
+	seconds := r.Get("expires_in").Int()
+	if seconds <= 0 || seconds > 365*86400 {
+		return nil, errors.New("exchange_failed")
+	}
+	return &CodexAuthBundle{TokenData: CodexTokenData{IDToken: id, AccessToken: access, RefreshToken: refresh, Expire: time.Now().Add(time.Duration(seconds) * time.Second).UTC().Format(time.RFC3339)}, LastRefresh: time.Now().UTC().Format(time.RFC3339)}, nil
+}
