index 0000000..905872a
--- /dev/null
+++ b/internal/authlogin/totp_validation.go
@@ -0,0 +1,83 @@
+package authlogin
+
+import (
+	"net/url"
+	"strings"
+
+	"golang.org/x/text/cases"
+	"golang.org/x/text/language"
+)
+
+// validTOTPSecret applies the login worker's format rules before credentials
+// are stored. Validation never changes the original secret or password.
+func validTOTPSecret(value string) bool {
+	seed := value
+	if strings.HasPrefix(strings.ToLower(value), "otpauth:") {
+		uri, err := url.Parse(value)
+		if err != nil || !strings.EqualFold(uri.Scheme, "otpauth") || uri.Hostname() != "totp" || uri.Fragment != "" || uri.User != nil {
+			return false
+		}
+		parameters := map[string]string{}
+		for _, part := range strings.Split(uri.RawQuery, "&") {
+			key, raw, _ := strings.Cut(part, "=")
+			key, err = url.QueryUnescape(key)
+			if err != nil {
+				continue
+			}
+			switch key {
+			case "secret", "algorithm", "digits", "period":
+				if _, exists := parameters[key]; exists {
+					return false
+				}
+				decoded, decodeErr := url.QueryUnescape(raw)
+				if decodeErr != nil {
+					return false
+				}
+				parameters[key] = decoded
+			}
+		}
+		if algorithm := parameters["algorithm"]; algorithm != "" && strings.ToUpper(algorithm) != "SHA1" {
+			return false
+		}
+		if digits := parameters["digits"]; digits != "" && digits != "6" {
+			return false
+		}
+		if period := parameters["period"]; period != "" && period != "30" {
+			return false
+		}
+		seed = parameters["secret"]
+	}
+	seed = cases.Upper(language.Und).String(seed)
+	seed = strings.Map(func(r rune) rune {
+		if r == '-' || totpWorkerWhitespace(r) {
+			return -1
+		}
+		return r
+	}, seed)
+	seed = strings.TrimRight(seed, "=")
+	if len(seed) < 16 || len(seed) > 128 {
+		return false
+	}
+	switch len(seed) % 8 {
+	case 0, 2, 4, 5, 7:
+	default:
+		return false
+	}
+	const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
+	for _, r := range seed {
+		if !strings.ContainsRune(alphabet, r) {
+			return false
+		}
+	}
+	// Canonical Base32 permits only zero bits in the unused final fragment.
+	remaining := uint(len(seed) * 5 % 8)
+	last := strings.IndexByte(alphabet, seed[len(seed)-1])
+	return last&((1<<remaining)-1) == 0
+}
+
+// JavaScript's whitespace set differs from unicode.IsSpace for U+0085/U+FEFF.
+func totpWorkerWhitespace(r rune) bool {
+	return r >= '\t' && r <= '\r' || r >= '\u2000' && r <= '\u200a' ||
+		r == ' ' || r == '\u00a0' || r == '\u1680' || r == '\u2028' || r == '\u2029' ||
+		r == '\u202f' || r == '\u205f' || r == '\u3000' || r == '\ufeff'
+}
diff --git a/internal/authlogin/totp_validation_test.go b/internal/authlogin/totp_validation_test.go
new file mode 100644
index 0000000..487df21
--- /dev/null
+++ b/internal/authlogin/totp_validation_test.go
@@ -0,0 +1,195 @@
+package authlogin
+
+import (
+	"bytes"
+	"encoding/gob"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/MoeForge/moego/ojson"
+	bolt "go.etcd.io/bbolt"
+)
+
+type totpValidationCase struct {
+	name  string
+	value string
+	valid bool
+}
+
+func totpValidationCases() []totpValidationCase {
+	const seed = "JBSWY3DPEHPK3PXP"
+	const uri = "otpauth://totp/OpenAI:fixture?secret=" + seed
+	return []totpValidationCase{
+		{"base32", seed, true},
+		{"formatted", " jbsw-y3dp\tehpk 3pxp ==\n", true},
+		{"unicode_whitespace", "\ufeff" + seed + "\u00a0\u2009", true},
+		{"unicode_uppercase", "ßßßßßßßß", true},
+		{"maximum", strings.Repeat("A", 128), true},
+		{"tail_two", strings.Repeat("A", 18), true},
+		{"tail_four", strings.Repeat("A", 20), true},
+		{"tail_one", strings.Repeat("A", 21), true},
+		{"tail_three", strings.Repeat("A", 23), true},
+		{"uri_defaults", uri, true},
+		{"uri_explicit", uri + "&algorithm=sha1&digits=6&period=30&issuer=OpenAI", true},
+		{"uri_empty_defaults", uri + "&algorithm=&digits=&period=", true},
+		{"uri_encoded", "otpauth://totp/fixture?secret=jbsw%20y3dp-ehpk3pxp", true},
+		{"empty", "", false},
+		{"code_instead_of_seed", "123456", false},
+		{"short", strings.Repeat("A", 15), false},
+		{"long", strings.Repeat("A", 129), false},
+		{"invalid_character", strings.Repeat("A", 15) + "0", false},
+		{"interior_padding", "JBSW=Y3DPEHPK3PXP", false},
+		{"invalid_length_1", strings.Repeat("A", 17), false},
+		{"invalid_length_3", strings.Repeat("A", 19), false},
+		{"invalid_length_6", strings.Repeat("A", 22), false},
+		{"nonzero_tail_2", strings.Repeat("A", 17) + "B", false},
+		{"nonzero_tail_4", strings.Repeat("A", 19) + "B", false},
+		{"nonzero_tail_1", strings.Repeat("A", 20) + "B", false},
+		{"nonzero_tail_3", strings.Repeat("A", 22) + "B", false},
+		{"non_worker_whitespace", seed + "\u0085", false},
+		{"uri_hotp", strings.Replace(uri, "://totp/", "://hotp/", 1), false},
+		{"uri_wrong_host_case", strings.Replace(uri, "://totp/", "://TOTP/", 1), false},
+		{"uri_userinfo", strings.Replace(uri, "://totp/", "://name:secret@totp/", 1), false},
+		{"uri_fragment", uri + "#fragment", false},
+		{"uri_missing_secret", "otpauth://totp/fixture?issuer=OpenAI", false},
+		{"uri_sha256", uri + "&algorithm=SHA256", false},
+		{"uri_eight_digits", uri + "&digits=8", false},
+		{"uri_sixty_seconds", uri + "&period=60", false},
+		{"uri_duplicate_secret", uri + "&secret=" + seed, false},
+		{"uri_duplicate_encoded_secret", uri + "&%73ecret=" + seed, false},
+		{"uri_duplicate_algorithm", uri + "&algorithm=SHA1&algorithm=SHA1", false},
+		{"uri_duplicate_digits", uri + "&digits=6&digits=6", false},
+		{"uri_duplicate_period", uri + "&period=30&period=30", false},
+	}
+}
+
+func TestTOTPValidationPreservesCredentialInput(t *testing.T) {
+	for _, tc := range totpValidationCases() {
+		t.Run(tc.name, func(t *testing.T) {
+			input := Credentials{Email: "fixture@example.test", Password: "  opaque password\t ", TOTPSecret: tc.value}
+			raw, err := Encode(input)
+			if err != nil {
+				t.Fatal(err)
+			}
+			got, err := DecodeCredentials(ojson.ParseBytes(raw))
+			if tc.valid {
+				if err != nil || got != input {
+					t.Fatal("valid credentials were rejected or their original values changed")
+				}
+			} else if err == nil || err.Error() != "invalid_credentials" || got != (Credentials{}) {
+				t.Fatal("invalid TOTP input did not return the fixed credential error")
+			}
+		})
+	}
+}
+
+func TestTOTPValidationStartPayload(t *testing.T) {
+	for _, remember := range []bool{false, true} {
+		input := offlineStart().Credentials
+		input.TOTPSecret = "123456"
+		raw, err := Encode(map[string]any{"consumer_plugin": "model-quality", "method": "password_totp", "intent": "import", "credentials": input, "remember_credentials": remember})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err = DecodeStart(raw); err == nil || err.Error() != "invalid_credentials" {
+			t.Fatal("temporary or remembered login accepted an invalid seed")
+		}
+	}
+}
+
+func TestTOTPValidationAccountImportAndEditAreAtomic(t *testing.T) {
+	s := offlineService(t, offlineOptions(t))
+	input := offlineStart().Credentials
+	input.TOTPSecret = " jbsw-y3dp ehpk3pxp== "
+	imported, err := s.ImportAccounts([]Credentials{input})
+	if err != nil {
+		t.Fatal(err)
+	}
+	account := imported[0]
+	before := s.accounts[account.ID]
+	stored, err := s.accountCredentials(before)
+	if err != nil || stored != input {
+		t.Fatal("stored credentials lost their original values")
+	}
+	valid := input
+	valid.Email = "valid-second@example.test"
+	invalid := input
+	invalid.Email = "invalid-third@example.test"
+	invalid.TOTPSecret = "123456"
+	if _, err = s.ImportAccounts([]Credentials{valid, invalid}); err == nil || err.Error() != "invalid_credentials" {
+		t.Fatal("invalid account batch was accepted")
+	}
+	invalid.Email = input.Email
+	invalid.Password = "replacement must not be stored"
+	if _, err = s.UpdateAccount(AccountUpdate{ID: account.ID, Revision: account.Revision, Label: "must not change", Credentials: &invalid}); err == nil || err.Error() != "invalid_credentials" {
+		t.Fatal("invalid account edit was accepted")
+	}
+	if len(s.accounts) != 1 || !reflect.DeepEqual(before, s.accounts[account.ID]) {
+		t.Fatal("rejected input changed in-memory credentials or revision")
+	}
+	if err = s.journal.db.View(func(tx *bolt.Tx) error {
+		bucket := tx.Bucket([]byte("accounts"))
+		if bucket.Stats().KeyN != 1 {
+			t.Error("rejected batch partially persisted an account")
+		}
+		var persisted storedAccount
+		if errLoad := gob.NewDecoder(bytes.NewReader(bucket.Get([]byte(account.ID)))).Decode(&persisted); errLoad != nil {
+			return errLoad
+		}
+		if !reflect.DeepEqual(before, persisted) {
+			t.Error("rejected edit changed persistent credentials or revision")
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// This optional cross-language check is enabled explicitly for runtime releases;
+// ordinary host tests need neither Node nor the separate login-runtime sources.
+func TestTOTPValidationWorkerParity(t *testing.T) {
+	node := os.Getenv("AUTHLOGIN_TOTP_NODE")
+	if node == "" {
+		t.Skip("set AUTHLOGIN_TOTP_NODE to check the installed JavaScript worker rules")
+	}
+	_, source, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("test source path unavailable")
+	}
+	worker := filepath.Join(filepath.Dir(source), "..", "..", "..", "..", "login-runtime", "totp.mjs")
+	cases := totpValidationCases()
+	values := make([]string, len(cases))
+	for i, tc := range cases {
+		values[i] = tc.value
+	}
+	raw, err := Encode(values)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const script = `import {readFileSync} from 'node:fs';
+import {pathToFileURL} from 'node:url';
+const {normalizeTotpSecret} = await import(pathToFileURL(process.argv[1]).href);
+process.stdout.write(JSON.stringify(JSON.parse(readFileSync(0, 'utf8')).map(value => {
+  try { normalizeTotpSecret(value); return true; } catch { return false; }
+})));`
+	cmd := exec.Command(node, "--input-type=module", "-e", script, worker)
+	cmd.Stdin = bytes.NewReader(raw)
+	out, err := cmd.Output()
+	if err != nil {
+		t.Fatal("JavaScript validation fixture failed")
+	}
+	results := ojson.ParseBytes(out)
+	if !results.IsArray() || len(results.Array()) != len(cases) {
+		t.Fatal("JavaScript validation fixture returned an invalid result")
+	}
+	for i, result := range results.Array() {
+		if result.Bool() != cases[i].valid || validTOTPSecret(cases[i].value) != result.Bool() {
+			t.Errorf("worker and host disagree for case %s", cases[i].name)
+		}
+	}
+}
diff --git a/internal/authlogin/types.go b/internal/authlogin/types.go
new file mode 100644
index 0000000..b56dff2
--- /dev/null
+++ b/internal/authlogin/types.go
@@ -0,0 +1,231 @@
+// Package authlogin owns administrator-authorized OpenAI login and account inspection.
+package authlogin
+
+import (
+	"errors"
+	"strings"
+
+	"github.com/MoeForge/moego/ojson"
+)
+
+type Credentials struct {
+	Email      string `json:"email"`
+	Password   string `json:"password"`
+	TOTPSecret string `json:"totp_secret"`
+}
+type RuntimeRequest struct {
+	Version          int         `json:"version"`
+	JobID            string      `json:"job_id"`
+	Attempt          int         `json:"attempt"`
+	AuthorizationURL string      `json:"authorization_url"`
+	RedirectURI      string      `json:"redirect_uri"`
+	State            string      `json:"state"`
+	Credentials      Credentials `json:"credentials"`
+	ProxyURL         string      `json:"proxy_url,omitempty"`
+	WorkspaceID      string      `json:"workspace_id,omitempty"`
+}
+type StartRequest struct {
+	accountID               string
+	accountSequence         uint64
+	automatic               bool
+	autoEvidence            string
+	autoGuard               func() error
+	ConsumerPlugin          string
+	Method                  string
+	Intent                  string
+	TargetAuthID            string
+	ExpectedIdentityVersion string
+	ProxyURL                string
+	Credentials             Credentials
+	RememberCredentials     bool
+	UseSavedCredentials     bool
+}
+type Job struct {
+	AccountID        string `json:"account_id,omitempty"`
+	Automatic        bool   `json:"automatic,omitempty"`
+	ID               string `json:"id"`
+	Revision         uint64 `json:"revision"`
+	Method           string `json:"method"`
+	Intent           string `json:"intent"`
+	Status           string `json:"status"`
+	Phase            string `json:"phase"`
+	MaskedEmail      string `json:"masked_email"`
+	Email            string `json:"email,omitempty"`
+	ErrorCode        string `json:"error_code,omitempty"`
+	ErrorStage       string `json:"error_stage,omitempty"`
+	ErrorReason      string `json:"error_reason,omitempty"`
+	CandidateID      string `json:"candidate_id,omitempty"`
+	AuthorizationURL string `json:"authorization_url,omitempty"`
+	TargetAuthID     string `json:"target_auth_id,omitempty"`
+	CreatedAt        string `json:"created_at"`
+	ExpiresAt        string `json:"expires_at"`
+	VaultError       string `json:"vault_error,omitempty"`
+}
+type Candidate struct {
+	ID              string   `json:"id"`
+	JobID           string   `json:"job_id"`
+	Revision        uint64   `json:"revision"`
+	MaskedEmail     string   `json:"masked_email"`
+	AccountIDMasked string   `json:"account_id_masked"`
+	Email           string   `json:"email"`
+	AccountID       string   `json:"account_id"`
+	UserID          string   `json:"user_id"`
+	TargetAuthID    string   `json:"target_auth_id"`
+	Restrictions    []string `json:"restrictions"`
+	Intent          string   `json:"intent"`
+}
+
+// Encode batches serialization through a document, including nested values.
+func Encode(value any) ([]byte, error) {
+	d := ojson.NewDocString(`{}`)
+	if err := d.Set("value", value); err != nil {
+		return nil, err
+	}
+	return []byte(ojson.ParseBytes(d.Bytes()).Get("value").Raw), nil
+}
+func Object(raw []byte, allowed ...string) (ojson.Result, error) {
+	if !ojson.ValidBytes(raw) {
+		return ojson.Result{}, errors.New("invalid_request")
+	}
+	r := ojson.ParseBytes(raw)
+	if !r.IsObject() {
+		return r, errors.New("invalid_request")
+	}
+	keys := map[string]bool{}
+	for _, k := range allowed {
+		keys[k] = true
+	}
+	seen := map[string]bool{}
+	valid := true
+	r.ForEach(func(k, v ojson.Result) bool {
+		key := k.String()
+		if !keys[key] || seen[key] {
+			valid = false
+			return false
+		}
+		seen[key] = true
+		return true
+	})
+	if !valid {
+		return r, errors.New("invalid_request")
+	}
+	return r, nil
+}
+func stringField(r ojson.Result, k string) (string, error) {
+	v := r.Get(k)
+	if v.Exists() && v.Type != ojson.String {
+		return "", errors.New("invalid_request")
+	}
+	return v.String(), nil
+}
+func DecodeCredentials(r ojson.Result) (Credentials, error) {
+	var c Credentials
+	obj, err := Object([]byte(r.Raw), "email", "password", "totp_secret")
+	if err != nil {
+		return c, err
+	}
+	if c.Email, err = stringField(obj, "email"); err != nil {
+		return c, err
+	}
+	if c.Password, err = stringField(obj, "password"); err != nil {
+		return c, err
+	}
+	if c.TOTPSecret, err = stringField(obj, "totp_secret"); err != nil {
+		return c, err
+	}
+	c.Email = strings.ToLower(strings.TrimSpace(c.Email))
+	if len(c.Email) > 254 || len(c.Password) > 4096 || len(c.TOTPSecret) > 1024 || !strings.Contains(c.Email, "@") || strings.ContainsAny(c.Email, "\r\n\x00") || c.Password == "" || c.TOTPSecret == "" {
+		return Credentials{}, errors.New("invalid_credentials")
+	}
+	if !validTOTPSecret(c.TOTPSecret) {
+		return Credentials{}, errors.New("invalid_credentials")
+	}
+	return c, nil
+}
+func DecodeStart(raw []byte) (StartRequest, error) {
+	var s StartRequest
+	r, err := Object(raw, "consumer_plugin", "method", "intent", "target_auth_id", "expected_identity_version", "credentials", "remember_credentials", "use_saved_credentials", "proxy_url")
+	if err != nil {
+		return s, err
+	}
+	for k, p := range map[string]*string{"consumer_plugin": &s.ConsumerPlugin, "method": &s.Method, "intent": &s.Intent, "target_auth_id": &s.TargetAuthID, "expected_identity_version": &s.ExpectedIdentityVersion, "proxy_url": &s.ProxyURL} {
+		*p, err = stringField(r, k)
+		if err != nil {
+			return s, err
+		}
+	}
+	if s.ProxyURL, err = NormalizeLoginProxy(s.ProxyURL); err != nil {
+		return s, err
+	}
+	for k, p := range map[string]*bool{"remember_credentials": &s.RememberCredentials, "use_saved_credentials": &s.UseSavedCredentials} {
+		v := r.Get(k)
+		if v.Exists() && v.Type != ojson.True && v.Type != ojson.False {
+			return s, errors.New("invalid_request")
+		}
+		*p = v.Bool()
+	}
+	if r.Get("credentials").Exists() {
+		s.Credentials, err = DecodeCredentials(r.Get("credentials"))
+		if err != nil {
+			return s, err
+		}
+	}
+	if s.ConsumerPlugin != "model-quality" || (s.Method != "password_totp" && s.Method != "browser") || (s.Intent != "import" && s.Intent != "reauthorize") {
+		return s, errors.New("invalid_request")
+	}
+	if s.Intent == "import" && (s.TargetAuthID != "" || s.ExpectedIdentityVersion != "" || s.UseSavedCredentials) {
+		return s, errors.New("invalid_request")
+	}
+	if s.Intent == "reauthorize" && (s.TargetAuthID == "" || s.ExpectedIdentityVersion == "") {
+		return s, errors.New("invalid_request")
+	}
+	if s.Method == "browser" && (s.Credentials.Password != "" || s.UseSavedCredentials || s.RememberCredentials) {
+		return s, errors.New("invalid_request")
+	}
+	if s.Method == "password_totp" && ((s.UseSavedCredentials && s.Credentials.Password != "") || (!s.UseSavedCredentials && s.Credentials.Password == "")) {
+		return s, errors.New("invalid_credentials")
+	}
+	return s, nil
+}
+func Mask(s string) string {
+	if s == "" {
+		return ""
+	}
+	if i := strings.IndexByte(s, '@'); i >= 0 {
+		if i < 1 {
+			return "***"
+		}
+		return s[:1] + "***" + s[i:]
+	}
+	if len(s) < 8 {
+		return "***"
+	}
+	return s[:3] + "…" + s[len(s)-3:]
+}
+func SafeCode(err error) string {
+	if err == nil {
+		return ""
+	}
+	s := err.Error()
+	switch s {
+	case "credential_login_pending":
+		return "login_commit_pending"
+	case "login_snapshot_conflict", "login_source_conflict":
+		return "policy_changed"
+	case "login_persist_failed":
+		return "storage_unavailable"
+	case "login_persist_unknown":
+		return "commit_unknown"
+	case "login_adoption_failed":
+		return "saved_not_adopted"
+	}
+	if s == "storage_capacity" || s == "quality_authority_unavailable" || s == "interrupted" || s == "invalid_proxy" || s == "proxy_auth_unsupported" {
+		return s
+	}
+	for _, v := range []string{"duplicate_account", "account_not_linked", "automation_disabled", "invalid_request", "invalid_credentials", "not_found", "conflict", "duplicate_identity", "identity_conflict", "identity_unverifiable", "identity_changed", "policy_changed", "login_commit_pending", "unsupported_login_target", "unsupported_login_store", "home_controlled", "interaction_required", "credentials_rejected", "totp_rejected", "runtime_unavailable", "runtime_invalid", "runtime_failed", "runtime_timeout", "runtime_protocol_error", "queue_full", "rate_limited", "cancelled", "expired", "plugin_unavailable", "exchange_failed", "storage_unavailable", "vault_unavailable", "vault_not_initialized", "vault_conflict", "vault_corrupt", "vault_identity_changed", "idempotency_conflict", "idempotency_unknown", "invalid_callback", "already_consumed", "commit_unknown", "saved_not_adopted"} {
+		if s == v {
+			return s
+		}
+	}
+	return "login_failed"
+}
diff --git a/internal/authlogin/vault.go b/internal/authlogin/vault.go
new file mode 100644
index 0000000..5e27990
--- /dev/null
+++ b/internal/authlogin/vault.go
@@ -0,0 +1,189 @@
+package authlogin
+
+import (
+	"bytes"
+	"encoding/gob"
+	"errors"
+	"sync"
+
+	auth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	bolt "go.etcd.io/bbolt"
+)
+
+type vault struct {
+	mu      sync.Mutex
+	journal *journal
+	manager *auth.Manager
+}
+type vaultEntry struct {
+	Revision                         uint64
+	Identity, Principal, MaskedEmail string
+	Credentials                      Credentials
+}
+
+func storedCredentialsComplete(c Credentials) bool {
+	return c.Email != "" && c.Password != "" && c.TOTPSecret != ""
+}
+
+// Plaintext storage is ready once the schema-2 journal has opened successfully.
+func (v *vault) ready() error {
+	if err := v.journal.db.View(func(tx *bolt.Tx) error {
+		if string(tx.Bucket([]byte("meta")).Get([]byte("schema"))) != "2" {
+			return errors.New("vault_unavailable")
+		}
+		return nil
+	}); err != nil {
+		return errors.New("vault_unavailable")
+	}
+	return nil
+}
+func (v *vault) entry(id string) (vaultEntry, bool, error) {
+	var e vaultEntry
+	found := false
+	err := v.journal.db.View(func(tx *bolt.Tx) error {
+		raw := tx.Bucket([]byte("vault")).Get([]byte(id))
+		if raw == nil {
+			return nil
+		}
+		found = true
+		return gob.NewDecoder(bytes.NewReader(raw)).Decode(&e)
+	})
+	if err != nil {
+		return e, false, errors.New("vault_corrupt")
+	}
+	return e, found, nil
+}
+func (v *vault) status(id string) map[string]any {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	err := v.ready()
+	out := map[string]any{"available": err == nil, "initialized": err == nil, "storage_mode": "plaintext"}
+	if err != nil {
+		out["reason"] = SafeCode(err)
+	}
+	if id != "" {
+		e, found, eerr := v.entry(id)
+		if eerr != nil {
+			out["available"] = false
+			out["reason"] = SafeCode(eerr)
+		} else if found {
+			snapshot, snapshotErr := v.manager.LoginSnapshot(id)
+			matches := snapshotErr == nil && snapshot.IdentityVersion == e.Identity && snapshot.Principal == e.Principal
+			entry := map[string]any{"revision": e.Revision, "masked_email": e.MaskedEmail, "has_password": matches, "has_totp": matches}
+			out["entry"] = entry
+			if credentials, readErr := v.credentials(e); readErr == nil {
+				entry["email"] = credentials.Email
+			} else {
+				entry["has_password"], entry["has_totp"] = false, false
+				out["reason"] = SafeCode(readErr)
+			}
+			if !matches {
+				out["reason"] = "vault_identity_changed"
+			}
+		}
+	}
+	return out
+}
+func (v *vault) save(id string, revision uint64, c Credentials, afterCommit bool) error {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	snapshot, err := v.manager.LoginSnapshot(id)
+	if err != nil {
+		return errors.New("vault_identity_changed")
+	}
+	a, ok := v.manager.GetByID(id)
+	if !ok {
+		return errors.New("vault_identity_changed")
+	}
+	p, err := auth.LoginPrincipalFromAuth(a)
+	if err != nil || p.Email != c.Email {
+		return errors.New("vault_identity_changed")
+	}
+	old, found, err := v.entry(id)
+	if err != nil {
+		return err
+	}
+	if !afterCommit && ((found && old.Revision != revision) || (!found && revision != 0)) {
+		return errors.New("vault_conflict")
+	}
+	e := vaultEntry{Revision: old.Revision + 1, Identity: snapshot.IdentityVersion, Principal: snapshot.Principal, MaskedEmail: Mask(c.Email), Credentials: c}
+	if err = v.journal.db.Update(func(tx *bolt.Tx) error { return putGob(tx, "vault", id, e) }); err != nil {
+		return errors.New("vault_unavailable")
+	}
+	return nil
+}
+func (v *vault) read(id string) (Credentials, error) {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	var c Credentials
+	e, found, err := v.entry(id)
+	if err != nil {
+		return c, err
+	}
+	if !found {
+		return c, errors.New("not_found")
+	}
+	snapshot, err := v.manager.LoginSnapshot(id)
+	if err != nil || snapshot.IdentityVersion != e.Identity || snapshot.Principal != e.Principal {
+		return c, errors.New("vault_identity_changed")
+	}
+	return v.credentials(e)
+}
+func (v *vault) credentials(e vaultEntry) (Credentials, error) {
+	if e.Revision == 0 || e.Identity == "" || e.Principal == "" || !storedCredentialsComplete(e.Credentials) {
+		return Credentials{}, errors.New("vault_corrupt")
+	}
+	return e.Credentials, nil
+}
+func (v *vault) delete(id string, revision uint64) error {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	old, found, err := v.entry(id)
+	if err != nil {
+		return err
+	}
+	if !found {
+		return nil
+	}
+	if old.Revision != revision {
+		return errors.New("vault_conflict")
+	}
+	if err = v.journal.db.Update(func(tx *bolt.Tx) error { return tx.Bucket([]byte("vault")).Delete([]byte(id)) }); err != nil {
+		return errors.New("vault_unavailable")
+	}
+	return nil
+}
+func (s *Service) VaultStatus(id string) any { return s.vault.status(id) }
+func (s *Service) PutVault(id string, revision uint64, c Credentials) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.fault {
+		return errors.New("storage_unavailable")
+	}
+	if err := s.vaultMutationAllowedLocked(id); err != nil {
+		return err
+	}
+	if err := s.journal.admit(); err != nil {
+		return err
+	}
+	return s.vault.save(id, revision, c, false)
+}
+func (s *Service) DeleteVault(id string, revision uint64) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.fault {
+		return errors.New("storage_unavailable")
+	}
+	if err := s.vaultMutationAllowedLocked(id); err != nil {
+		return err
+	}
+	return s.vault.delete(id, revision)
+}
+func (s *Service) vaultMutationAllowedLocked(id string) error {
+	for _, j := range s.jobs {
+		if j.record.View.TargetAuthID == id && (!terminal(j.record.View.Status) || j.record.View.Status == "saved_not_adopted" || j.record.View.Status == "commit_unknown") {
+			return errors.New("vault_conflict")
+		}
+	}
+	return nil
+}
