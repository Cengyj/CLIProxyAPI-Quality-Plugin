+package pluginhost
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginabi"
+)
+
+type credentialLoginControlClient struct {
+	lifecycle   *testSymbolLookup
+	panicMethod string
+}
+
+func (c *credentialLoginControlClient) Call(ctx context.Context, method string, raw []byte) ([]byte, error) {
+	if method == c.panicMethod {
+		panic("offline native failure")
+	}
+	switch method {
+	case pluginabi.MethodCredentialLoginCapabilities:
+		return []byte(`{"ok":true,"result":{"version":1}}`), nil
+	case pluginabi.MethodCredentialLoginPrepare:
+		d := ojson.NewDocString(`{"ok":true,"result":{"ready":true}}`)
+		_ = d.Set("result.preparation_id", ojson.GetBytes(raw, "preparation_id").String())
+		return d.Bytes(), nil
+	default:
+		if c.lifecycle != nil {
+			return c.lifecycle.Call(ctx, method, raw)
+		}
+		return nil, errors.New("unsupported offline call")
+	}
+}
+func (*credentialLoginControlClient) Shutdown() {}
+func TestCredentialLoginOwnerInvalidatedByInPlaceReconfigure(t *testing.T) {
+	host := New()
+	plugin := validTestPlugin("model-quality")
+	client := &credentialLoginControlClient{lifecycle: newTestSymbolLookup(&testPlugin{registerResult: plugin, reconfigureResult: plugin})}
+	loaded := &loadedPlugin{id: "model-quality", client: client, callbackInstance: &hostCallbackInstance{}}
+	host.loaded[loaded.id] = loaded
+	if _, err := host.CredentialLoginOwner(); err == nil {
+		t.Fatal("unregistered native instance admitted")
+	}
+	if _, ok := host.callRegister(context.Background(), loaded, runtimeItemConfig{}); !ok {
+		t.Fatal("offline registration failed")
+	}
+	owner, err := host.CredentialLoginOwner()
+	if err != nil || !owner.Valid() {
+		t.Fatalf("owner unavailable %v", err)
+	}
+	if err = owner.Prepare(context.Background(), "offline-auth", "offline-identity", "prepare-1"); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := host.callRegister(context.Background(), loaded, runtimeItemConfig{}); !ok {
+		t.Fatal("offline reconfigure failed")
+	}
+	if owner.Valid() {
+		t.Fatal("old login owner survived replacement of its plugin engine")
+	}
+	if err = owner.Prepare(context.Background(), "offline-auth", "offline-identity", "prepare-2"); err == nil {
+		t.Fatal("stale owner acknowledged")
+	}
+	next, err := host.CredentialLoginOwner()
+	if err != nil || !next.Valid() {
+		t.Fatalf("new instance unavailable %v", err)
+	}
+	loaded.callbackInstance.closed.Store(true)
+	if next.Valid() {
+		t.Fatal("closed callback instance admitted")
+	}
+}
+func TestCredentialLoginNativePanicsAreContained(t *testing.T) {
+	for _, method := range []string{pluginabi.MethodCredentialLoginCapabilities, pluginabi.MethodCredentialLoginPrepare} {
+		t.Run(method, func(t *testing.T) {
+			host := New()
+			client := &credentialLoginControlClient{}
+			loaded := &loadedPlugin{id: "model-quality", client: client, callbackInstance: &hostCallbackInstance{}, registered: true, credentialLoginReady: true, credentialLoginGeneration: 1}
+			host.loaded[loaded.id] = loaded
+			if method == pluginabi.MethodCredentialLoginCapabilities {
+				client.panicMethod = method
+				if _, err := host.CredentialLoginOwner(); err == nil {
+					t.Fatal("panic capability accepted")
+				}
+				return
+			}
+			owner, err := host.CredentialLoginOwner()
+			if err != nil {
+				t.Fatal(err)
+			}
+			client.panicMethod = method
+			if err = owner.Prepare(context.Background(), "auth", "identity", "prep"); err == nil {
+				t.Fatal("panic prepare accepted")
+			}
+		})
+	}
+}
