+func TestManagedAccountAutoRepairAndConsumedFailure(t *testing.T) {
+	opts := offlineOptions(t)
+	var exchanges atomic.Int32
+	original := opts.Exchange
+	opts.Exchange = func(ctx context.Context, code string, p *codex.PKCECodes, proxy string) (*codex.CodexAuthBundle, error) {
+		bundle, err := original(ctx, code, p, proxy)
+		if err == nil {
+			bundle.TokenData.RefreshToken = fmt.Sprintf("OFFLINE_GRANT_%d", exchanges.Add(1))
+		}
+		return bundle, err
+	}
+	s := offlineService(t, opts)
+	account := bindOfflineAccount(t, s)
+	current, _ := opts.Manager.GetByID(account.AuthID)
+	current.Disabled = false
+	current.Status = auth.StatusError
+	current.Unavailable = true
+	current.Metadata["disabled"] = false
+	current.LastError = &auth.Error{Code: "unauthorized", HTTPStatus: 401, Message: "unauthorized"}
+	current.StatusMessage = "unauthorized"
+	if _, err := opts.Manager.Update(context.Background(), current); err != nil {
+		t.Fatal(err)
+	}
+	accounts, err := s.InspectAccounts(account.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	account = accounts[0]
+	account, err = s.UpdateAccount(AccountUpdate{ID: account.ID, Revision: account.Revision, AutoRelogin: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	settings, _ := s.AccountSettings()
+	settings.InspectionEnabled = true
+	settings.AutoReloginEnabled = true
+	settings.IntervalMinutes = 5
+	if _, err = s.UpdateAccountSettings(settings); err != nil {
+		t.Fatal(err)
+	}
+	s.accountMu.Lock()
+	a := s.accounts[account.ID]
+	a.View.NextCheckAt = time.Now().Add(-time.Minute).Format(time.RFC3339)
+	if err = s.saveAccountLocked(a); err != nil {
+		t.Fatal(err)
+	}
+	s.accountMu.Unlock()
+	s.maintainAccounts()
+	accounts, err = s.Accounts()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if accounts[0].LastJobID == account.LastJobID {
+		t.Fatalf("automatic repair did not start: %+v", accounts[0])
+	}
+	waitLogin(t, s, accounts[0].LastJobID, "committed")
+	final, _ := s.Accounts()
+	if final[0].AttentionRequired || final[0].AuthID != account.AuthID {
+		t.Fatalf("repair did not reconcile binding: %+v", final[0])
+	}
+	latest, _ := opts.Manager.GetByID(account.AuthID)
+	if latest.RequiresSignIn {
+		t.Fatal("authentication failure was not cleared by commit")
+	}
+	before := exchanges.Load()
+	s.maintainAccounts()
+	if exchanges.Load() != before {
+		t.Fatal("successful repair was replayed")
+	}
+}
