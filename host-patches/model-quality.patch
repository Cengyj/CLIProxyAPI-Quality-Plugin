+package api
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/api/handlers/management"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/pluginhost"
+)
+
+func TestPluginV8DispatcherUsesManagementAccessPolicy(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, tc := range []struct {
+		name, addr, key string
+		home            bool
+		status          int
+	}{{"missing", "127.0.0.1:1", "", false, 401}, {"remote denied", "192.0.2.2:1", "offline", false, 403}, {"authenticated unknown route", "127.0.0.1:1", "offline", false, 404}, {"home controlled", "127.0.0.1:1", "offline", true, 404}} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := &config.Config{}
+			cfg.RemoteManagement.SecretKey = "configured-for-local-test"
+			cfg.Home.Enabled = tc.home
+			h := management.NewHandlerWithoutConfigFilePath(cfg, nil)
+			h.SetLocalPassword("offline")
+			s := &Server{cfg: cfg, engine: gin.New(), mgmt: h, pluginHost: pluginhost.New()}
+			s.managementRoutesEnabled.Store(true)
+			s.engine.NoRoute(s.pluginDispatchNoRoute)
+			req := httptest.NewRequest(http.MethodGet, "/v8/management/plugins/model-quality/targets", nil)
+			req.RemoteAddr = tc.addr
+			if tc.key != "" {
+				req.Header.Set("Authorization", "Bearer "+tc.key)
+			}
+			rec := httptest.NewRecorder()
+			s.engine.ServeHTTP(rec, req)
+			if rec.Code != tc.status {
+				t.Fatalf("code %d body %s", rec.Code, rec.Body.String())
+			}
+		})
+	}
+}
