+	s.mu.Lock()
+	s.jobs[first.ID].record.RateKey = "separate-offline-principal"
+	s.mu.Unlock()
+	second, err := s.Start(StartRequest{ConsumerPlugin: "model-quality", Method: "browser", Intent: "import"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	u, _ = url.Parse(second.AuthorizationURL)
+	if _, err = s.Callback(second.ID, offlineCallback(u.Query().Get("state"))); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = s.Cancel(first.ID, false); err != nil {
+		t.Fatal(err)
+	}
+	waitLogin(t, s, first.ID, "cancelled")
+	<-entered
+	close(release)
+	waitLogin(t, s, second.ID, "awaiting_commit")
+	if max.Load() != 1 {
+		t.Fatal("token exchanges exceeded the global acquisition limit")
+	}
+}
+func TestJournalRetentionAndPendingPreservation(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	j, err := openJournal(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = j.db.Close() }()
+	now := time.Now()
+	old := now.Add(-31 * 24 * time.Hour)
+	for _, status := range []string{"committed", "failed", "saved_not_adopted", "commit_unknown", "committing", "running"} {
+		if err = j.save(storedJob{View: Job{ID: status, Status: status}, Created: old, Updated: old}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	err = j.db.Update(func(tx *bolt.Tx) error {
+		for _, record := range []struct {
+			id    string
+			value idempotency
+		}{{"done", idempotency{Created: old, JobID: "committed"}}, {"unknown", idempotency{Created: old, JobID: "commit_unknown"}}, {"pending", idempotency{Created: old, Pending: true}}} {
+			if err := putGob(tx, "idempotency", record.id, record.value); err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	removed, err := j.prune(now)
+	if err != nil || len(removed) != 2 {
+		t.Fatalf("prune mismatch: %v %v", removed, err)
+	}
+	err = j.db.View(func(tx *bolt.Tx) error {
+		b := tx.Bucket([]byte("idempotency"))
+		if b.Get([]byte("done")) != nil || b.Get([]byte("unknown")) == nil || b.Get([]byte("pending")) == nil {
+			t.Error("retention removed unresolved idempotency or retained expired result")
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+func TestRestartPreservesUnknownAndInterruptsAcquisition(t *testing.T) {
+	opts := offlineOptions(t)
+	s := offlineService(t, opts)
+	now := time.Now()
+	for _, status := range []string{"waiting_browser", "saved_not_adopted", "commit_unknown", "committing"} {
+		if err := s.journal.save(storedJob{View: Job{ID: status, Revision: 1, Status: status}, Created: now, Updated: now}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	s = offlineService(t, opts)
+	for _, id := range []string{"saved_not_adopted", "commit_unknown", "committing"} {
+		j, err := s.Detail(id)
+		if err != nil || j.Status != "commit_unknown" {
+			t.Fatalf("unresolved commit lost on restart: %+v %v", j, err)
+		}
+	}
+	job, _ := s.Detail("waiting_browser")
+	if job.Status != "interrupted" || job.AuthorizationURL != "" {
+		t.Fatal("restart resumed an acquisition session")
+	}
+}
+func TestPlaintextVaultRejectsIncompleteRecordsAndNeedsNoKey(t *testing.T) {
+	opts := offlineOptions(t)
+	s := offlineService(t, opts)
+	j, err := s.Start(offlineStart())
+	if err != nil {
+		t.Fatal(err)
+	}
+	j = waitLogin(t, s, j.ID, "awaiting_commit")
+	if _, err = s.Commit(context.Background(), j.ID, j.CandidateID, j.Revision); err != nil {
+		t.Fatal(err)
+	}
+	j = waitLogin(t, s, j.ID, "committed")
+	if err = s.PutVault(j.TargetAuthID, 0, offlineStart().Credentials); err != nil {
+		t.Fatal(err)
+	}
+	entry, _, _ := s.vault.entry(j.TargetAuthID)
+	entry.Credentials.Password = ""
+	if err = s.journal.db.Update(func(tx *bolt.Tx) error { return putGob(tx, "vault", j.TargetAuthID, entry) }); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = s.vault.read(j.TargetAuthID); err == nil || err.Error() != "vault_corrupt" {
+		t.Fatal("incomplete plaintext credential record accepted")
+	}
+	if _, err = os.Lstat(filepath.Join(opts.Dir, "vault.key")); !os.IsNotExist(err) {
+		t.Fatal("plaintext storage unexpectedly created a key")
+	}
+}
+func TestJournalSerializationDoesNotLeakSecretErrors(t *testing.T) {
+	dir := t.TempDir()
+	_ = os.Chmod(dir, 0700)
+	j, err := openJournal(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = j.db.Close() }()
+	secret := "OFFLINE_RAW_ERROR_SECRET"
+	_, err = j.idempotent("error-key-123", "POST/start", []byte(`{"password":"OFFLINE_PASSWORD_SECRET"}`), func() (any, error) { return nil, errors.New(secret) })
+	if err == nil || err.Error() != "login_failed" {
+		t.Fatal("raw error escaped")
+	}
+	raw, _ := os.ReadFile(j.db.Path())
+	if bytes.Contains(raw, []byte(secret)) || bytes.Contains(raw, []byte("OFFLINE_PASSWORD_SECRET")) {
+		t.Fatal("secret persisted in idempotency journal")
+	}
+	err = j.db.View(func(tx *bolt.Tx) error {
+		return tx.Bucket([]byte("idempotency")).ForEach(func(_, raw []byte) error {
+			var record idempotency
+			if err := gob.NewDecoder(bytes.NewReader(raw)).Decode(&record); err != nil {
+				return err
+			}
+			if !ojson.ValidBytes(record.Response) {
+				t.Error("stored response is invalid JSON")
+			}
+			return nil
+		})
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCapabilityAndOwnerLossStopAdmission(t *testing.T) {
+	opts := offlineOptions(t)
+	var valid atomic.Bool
+	valid.Store(true)
+	opts.Owner = func() (Owner, error) {
+		return Owner{ID: "owner", Valid: valid.Load, Prepare: func(context.Context, string, string, string) error { return nil }}, nil
+	}
+	s := offlineService(t, opts)
+	j, err := s.Start(StartRequest{ConsumerPlugin: "model-quality", Method: "browser", Intent: "import"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	valid.Store(false)
+	s.maintain()
+	j, _ = s.Detail(j.ID)
+	if j.Status != "expired" || j.AuthorizationURL != "" {
+		t.Fatal("owner loss retained authorization session")
+	}
+	if _, err = s.Start(offlineStart()); err == nil {
+		t.Fatal("inactive plugin accepted login")
+	}
+	raw, err := Encode(s.Capabilities())
+	if err != nil || ojson.ParseBytes(raw).Get("available").Bool() {
+		t.Fatal("inactive owner capability remained available")
+	}
+	valid.Store(true)
+	if err = opts.Manager.CloseQualityState(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = s.Start(offlineStart()); err == nil {
+		t.Fatal("missing authority accepted login")
+	}
+	if _, err = New(opts); err == nil {
+		t.Fatal("service initialized without durable commit authority")
+	}
+}
+func TestJournalCapacityReservesMaintenanceSpace(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	j, err := openJournal(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = j.db.Close() }()
+	if err = os.Truncate(j.db.Path(), journalMaxBytes-journalReserveBytes); err != nil {
+		t.Fatal(err)
+	}
+	if err = j.admit(); err == nil {
+		t.Fatal("full journal accepted a new login")
+	}
+	if err = j.capacity(true); err != nil {
+		t.Fatal("reserved maintenance space was unavailable")
+	}
+	if err = os.Truncate(j.db.Path(), journalMaxBytes); err != nil {
+		t.Fatal(err)
+	}
+	if err = j.capacity(true); err == nil {
+		t.Fatal("journal capacity limit not enforced")
+	}
+}
+func TestValidateBundleRejectsExpiredOrConflictingIdentity(t *testing.T) {
+	now := time.Now()
+	for _, scenario := range []string{"expired", "wrong_audience", "wrong_issuer", "conflicting_identity", "missing_refresh"} {
+		t.Run(scenario, func(t *testing.T) {
+			b := offlineBundle(t, now, "account-a")
+			parts := strings.Split(b.TokenData.IDToken, ".")
+			raw, _ := base64.RawURLEncoding.DecodeString(parts[1])
+			d := ojson.NewDoc(raw)
+			switch scenario {
+			case "expired":
+				_ = d.Set("exp", now.Unix())
+			case "wrong_audience":
+				_ = d.Set("aud", "other-client")
+			case "wrong_issuer":
+				_ = d.Set("iss", "https://example.test")
+			case "conflicting_identity":
+				b.TokenData.AccessToken = offlineBundle(t, now, "account-b").TokenData.AccessToken
+			case "missing_refresh":
+				b.TokenData.RefreshToken = ""
+			}
+			b.TokenData.IDToken = "e30." + base64.RawURLEncoding.EncodeToString(d.Bytes()) + ".signature"
+			if _, err := validateBundle(b, now); err == nil {
+				t.Fatal("invalid identity accepted")
+			}
+		})
+	}
+}
diff --git a/internal/authlogin/store.go b/internal/authlogin/store.go
new file mode 100644
index 0000000..ca3dd1f
--- /dev/null
+++ b/internal/authlogin/store.go
@@ -0,0 +1,350 @@
+package authlogin
+
+import (
+	"bytes"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/gob"
+	"encoding/hex"
+	"errors"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/MoeForge/moego/ojson"
+	bolt "go.etcd.io/bbolt"
+)
+
+type journal struct {
+	db     *bolt.DB
+	key    []byte
+	idemMu sync.Mutex
+	now    func() time.Time
+}
+
+const journalMaxBytes int64 = 256 << 20
+const journalReserveBytes int64 = 8 << 20
+const terminalRetention = 30 * 24 * time.Hour
+
+type storedJob struct {
+	AdoptedIdentity, AdoptedPrincipal string
+	AccountEvidence                   string
+	AccountSequence                   uint64
+	View                              Job
+	Created, Updated                  time.Time
+	RateKey                           string
+	LogVersion                        uint8
+	LogEntries                        []LogEntry
+}
+type idempotency struct {
+	Fingerprint string
+	Pending     bool
+	Response    []byte
+	Code        string
+	Created     time.Time
+	JobID       string
+}
+
+func openJournal(dir string) (*journal, error) {
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, errors.New("storage_unavailable")
+	}
+	if fi, err := os.Lstat(dir); err != nil || !fi.IsDir() || fi.Mode()&0077 != 0 {
+		return nil, errors.New("storage_unavailable")
+	}
+	path := filepath.Join(dir, "credential-login.db")
+	if fi, err := os.Lstat(path); err == nil && (!fi.Mode().IsRegular() || fi.Mode()&0077 != 0) {
+		return nil, errors.New("storage_unavailable")
+	}
+	db, err := bolt.Open(path, 0600, &bolt.Options{Timeout: time.Second})
+	if err != nil {
+		return nil, errors.New("storage_unavailable")
+	}
+	j := &journal{db: db, now: func() time.Time { return time.Now().UTC() }}
+	err = db.Update(func(tx *bolt.Tx) error {
+		for _, name := range []string{"jobs", "idempotency", "meta", "vault", "accounts"} {
+			if _, e := tx.CreateBucketIfNotExists([]byte(name)); e != nil {
+				return e
+			}
+		}
+		b := tx.Bucket([]byte("meta"))
+		schema := string(b.Get([]byte("schema")))
+		if schema != "" && schema != "2" {
+			return errors.New("storage_unavailable")
+		}
+		if schema == "" {
+			if errEmpty := tx.ForEach(func(_ []byte, bucket *bolt.Bucket) error {
+				if bucket.Stats().KeyN != 0 {
+					return errors.New("storage_unavailable")
+				}
+				return nil
+			}); errEmpty != nil {
+				return errEmpty
+			}
+		}
+		j.key = bytes.Clone(b.Get([]byte("hmac")))
+		if len(j.key) != 32 {
+			if schema != "" || len(j.key) != 0 || tx.Bucket([]byte("jobs")).Stats().KeyN != 0 || tx.Bucket([]byte("idempotency")).Stats().KeyN != 0 || tx.Bucket([]byte("accounts")).Stats().KeyN != 0 || tx.Bucket([]byte("vault")).Stats().KeyN != 0 {
+				return errors.New("storage_unavailable")
+			}
+			j.key = make([]byte, 32)
+			if _, e := rand.Read(j.key); e != nil {
+				return e
+			}
+			if errKey := b.Put([]byte("hmac"), j.key); errKey != nil {
+				return errKey
+			}
+		}
+		if schema == "" {
+			return b.Put([]byte("schema"), []byte("2"))
+		}
+		return nil
+	})
+	if err != nil {
+		_ = db.Close()
+		return nil, errors.New("storage_unavailable")
+	}
+	return j, nil
+}
+func (j *journal) admit() error { return j.capacity(false) }
+func (j *journal) capacity(maintenance bool) error {
+	info, err := os.Stat(j.db.Path())
+	limit := journalMaxBytes - journalReserveBytes
+	if maintenance {
+		limit = journalMaxBytes - (1 << 20)
+	}
+	if err != nil || info.Size() >= limit {
+		return errors.New("storage_capacity")
+	}
+	return nil
+}
+func (j *journal) prune(now time.Time) ([]string, error) {
+	removed := []string{}
+	err := j.db.Update(func(tx *bolt.Tx) error {
+		protected := map[string]bool{}
+		jobs := tx.Bucket([]byte("jobs"))
+		cursor := jobs.Cursor()
+		for key, raw := cursor.First(); key != nil; key, raw = cursor.Next() {
+			var record storedJob
+			if err := gob.NewDecoder(bytes.NewReader(raw)).Decode(&record); err != nil {
+				return err
+			}
+			status := record.View.Status
+			if !terminal(status) || status == "saved_not_adopted" || status == "commit_unknown" {
+				protected[record.View.ID] = true
+				continue
+			}
+			if !record.Updated.IsZero() && !record.Updated.Add(terminalRetention).After(now) {
+				removed = append(removed, record.View.ID)
+				if err := cursor.Delete(); err != nil {
+					return err
+				}
+			}
+		}
+		cursor = tx.Bucket([]byte("idempotency")).Cursor()
+		for key, raw := cursor.First(); key != nil; key, raw = cursor.Next() {
+			var record idempotency
+			if err := gob.NewDecoder(bytes.NewReader(raw)).Decode(&record); err != nil {
+				return err
+			}
+			jobID := record.JobID
+			if jobID == "" {
+				jobID = ojson.ParseBytes(record.Response).Get("id").String()
+			}
+			if record.Pending || protected[jobID] || record.Created.IsZero() || record.Created.Add(terminalRetention).After(now) {
+				continue
+			}
+			if err := cursor.Delete(); err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+	return removed, err
+}
+func putGob(tx *bolt.Tx, bucket, key string, v any) error {
+	var b bytes.Buffer
+	if err := gob.NewEncoder(&b).Encode(v); err != nil {
+		return err
+	}
+	return tx.Bucket([]byte(bucket)).Put([]byte(key), b.Bytes())
+}
+func (j *journal) fingerprint(parts ...string) string {
+	h := hmac.New(sha256.New, j.key)
+	for _, p := range parts {
+		_, _ = h.Write([]byte(p))
+		_, _ = h.Write([]byte{0})
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+// canonicalRequest keeps insignificant object ordering and whitespace out of the
+// HMAC while preserving every string byte, including passwords and callbacks.
+func canonicalRequest(raw []byte) (string, error) {
+	if !ojson.ValidBytes(raw) {
+		return "", errors.New("invalid_request")
+	}
+	var encode func(ojson.Result) (string, error)
+	encode = func(value ojson.Result) (string, error) {
+		if value.IsObject() {
+			fields := map[string]ojson.Result{}
+			keys := []string{}
+			duplicate := false
+			value.ForEach(func(key, child ojson.Result) bool {
+				name := key.String()
+				if _, found := fields[name]; found {
+					duplicate = true
+					return false
+				}
+				keys = append(keys, name)
+				fields[name] = child
+				return true
+			})
+			if duplicate {
+				return "", errors.New("invalid_request")
+			}
+			sort.Strings(keys)
+			parts := make([]string, 0, len(keys))
+			for _, key := range keys {
+				child, err := encode(fields[key])
+				if err != nil {
+					return "", err
+				}
+				parts = append(parts, strconv.Quote(key)+":"+child)
+			}
+			return "{" + strings.Join(parts, ",") + "}", nil
+		}
+		if value.IsArray() {
+			parts := []string{}
+			for _, child := range value.Array() {
+				encoded, err := encode(child)
+				if err != nil {
+					return "", err
+				}
+				parts = append(parts, encoded)
+			}
+			return "[" + strings.Join(parts, ",") + "]", nil
+		}
+		if value.Type == ojson.String {
+			return strconv.Quote(value.String()), nil
+		}
+		return value.Raw, nil
+	}
+	return encode(ojson.ParseBytes(raw))
+}
+func (j *journal) save(v storedJob) error {
+	return j.db.Update(func(tx *bolt.Tx) error {
+		var previous storedJob
+		raw := tx.Bucket([]byte("jobs")).Get([]byte(v.View.ID))
+		if raw != nil {
+			if err := gob.NewDecoder(bytes.NewReader(raw)).Decode(&previous); err != nil {
+				return err
+			}
+		}
+		// Keep the event and the state it describes in the same transaction.
+		v.LogVersion, v.LogEntries = previous.LogVersion, previous.LogEntries
+		if raw == nil {
+			v.LogVersion = 1
+		}
+		event := safeLogEntry(v.View)
+		if raw == nil || event != safeLogEntry(previous.View) {
+			event.ID = 1
+			if len(v.LogEntries) > 0 {
+				event.ID = v.LogEntries[len(v.LogEntries)-1].ID + 1
+			}
+			event.Time = j.now().UTC().Format(time.RFC3339Nano)
+			v.LogEntries = append(v.LogEntries, event)
+			if len(v.LogEntries) > maxJobLogEntries {
+				v.LogEntries = v.LogEntries[len(v.LogEntries)-maxJobLogEntries:]
+			}
+		}
+		v.View.AuthorizationURL, v.View.Email = "", ""
+		return putGob(tx, "jobs", v.View.ID, v)
+	})
+}
+func (j *journal) load() ([]storedJob, error) {
+	out := []storedJob{}
+	err := j.db.View(func(tx *bolt.Tx) error {
+		return tx.Bucket([]byte("jobs")).ForEach(func(k, v []byte) error {
+			var s storedJob
+			if err := gob.NewDecoder(bytes.NewReader(v)).Decode(&s); err != nil {
+				return err
+			}
+			out = append(out, s)
+			return nil
+		})
+	})
+	return out, err
+}
+
+// Idempotent records intent before executing the operation. An interrupted response
+// remains unknown instead of silently repeating an authorization or mutation.
+func (j *journal) idempotent(key, path string, raw []byte, fn func() (any, error)) ([]byte, error) {
+	if len(key) < 8 || len(key) > 128 || strings.ContainsAny(key, "\r\n\x00") {
+		return nil, errors.New("invalid_request")
+	}
+	j.idemMu.Lock()
+	defer j.idemMu.Unlock()
+	canonical, err := canonicalRequest(raw)
+	if err != nil {
+		return nil, err
+	}
+	id := j.fingerprint(key)
+	fingerprint := j.fingerprint(path, canonical)
+	var old idempotency
+	exists := false
+	err = j.db.View(func(tx *bolt.Tx) error {
+		v := tx.Bucket([]byte("idempotency")).Get([]byte(id))
+		if v == nil {
+			return nil
+		}
+		exists = true
+		return gob.NewDecoder(bytes.NewReader(v)).Decode(&old)
+	})
+	if err != nil {
+		return nil, errors.New("storage_unavailable")
+	}
+	if exists {
+		if old.Fingerprint != fingerprint {
+			return nil, errors.New("idempotency_conflict")
+		}
+		if old.Pending {
+			return nil, errors.New("idempotency_unknown")
+		}
+		if old.Code != "" {
+			return nil, errors.New(old.Code)
+		}
+		return old.Response, nil
+	}
+	maintenance := strings.HasSuffix(path, "/cancel") || strings.HasSuffix(path, "/discard") || strings.HasSuffix(path, "/commit") || strings.HasPrefix(path, "DELETE")
+	if err = j.capacity(maintenance); err != nil {
+		return nil, err
+	}
+	record := idempotency{Fingerprint: fingerprint, Pending: true, Created: j.now()}
+	if err = j.db.Update(func(tx *bolt.Tx) error { return putGob(tx, "idempotency", id, record) }); err != nil {
+		return nil, errors.New("storage_unavailable")
+	}
+	value, opErr := fn()
+	response, e := Encode(value)
+	if e != nil {
+		return nil, errors.New("storage_unavailable")
+	}
+	record.Pending = false
+	record.Code = SafeCode(opErr)
+	// Authorization links are transient; detail reconstructs them in memory.
+	d := ojsonDocumentWithoutAuthorization(response)
+	record.Response = d
+	record.JobID = ojson.ParseBytes(d).Get("id").String()
+	if err = j.db.Update(func(tx *bolt.Tx) error { return putGob(tx, "idempotency", id, record) }); err != nil {
+		return nil, errors.New("storage_unavailable")
+	}
+	if opErr != nil {
+		return nil, errors.New(record.Code)
+	}
+	return response, nil
+}
diff --git a/internal/authlogin/totp_validation.go b/internal/authlogin/totp_validation.go
