+type qualityTestExecutor struct {
+	calls   atomic.Int64
+	started chan struct{}
+	finish  chan struct{}
+	fail    bool
+}
+
+func (e *qualityTestExecutor) Identifier() string { return "quality-test" }
+func (e *qualityTestExecutor) Execute(ctx context.Context, a *Auth, r ex.Request, o ex.Options) (ex.Response, error) {
+	e.calls.Add(1)
+	if e.started != nil {
+		close(e.started)
+		select {
+		case <-e.finish:
+		case <-ctx.Done():
+			return ex.Response{}, ctx.Err()
+		}
+	}
+	if e.fail {
+		return ex.Response{}, &Error{HTTPStatus: 503, Message: "synthetic failure"}
+	}
+	return ex.Response{Payload: []byte(`{"choices":[{"message":{"content":"21"},"finish_reason":"stop"}]}`)}, nil
+}
+func (e *qualityTestExecutor) ExecuteStream(ctx context.Context, a *Auth, r ex.Request, o ex.Options) (*ex.StreamResult, error) {
+	e.calls.Add(1)
+	ch := make(chan ex.StreamChunk, 1)
+	ch <- ex.StreamChunk{Payload: []byte("data: [DONE]\n\n")}
+	close(ch)
+	return &ex.StreamResult{Chunks: ch}, nil
+}
+func (e *qualityTestExecutor) CountTokens(context.Context, *Auth, ex.Request, ex.Options) (ex.Response, error) {
+	e.calls.Add(1)
+	return ex.Response{Payload: []byte(`{"tokens":1}`)}, nil
+}
+func (e *qualityTestExecutor) Refresh(_ context.Context, a *Auth) (*Auth, error) { return a, nil }
+func (e *qualityTestExecutor) HttpRequest(context.Context, *Auth, *http.Request) (*http.Response, error) {
+	return nil, errors.New("unused")
+}
+func newQualityManager(t *testing.T, path string) (*Manager, *qualityTestExecutor, *Auth) {
+	t.Helper()
+	m := NewManager(nil, nil, nil)
+	if err := m.OpenQualityState(path); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := m.CloseQualityState(); err != nil {
+			t.Error(err)
+		}
+	})
+	e := &qualityTestExecutor{}
+	m.RegisterExecutor(e)
+	a, err := m.Register(context.Background(), &Auth{ID: t.Name(), Provider: e.Identifier(), Status: StatusActive, Attributes: map[string]string{"api_key": "fake-offline-key"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	registry.GetGlobalRegistry().RegisterClient(a.ID, a.Provider, []*registry.ModelInfo{{ID: "quality-model-a"}, {ID: "quality-model-b"}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(a.ID) })
+	m.RefreshSchedulerEntry(a.ID)
+	return m, e, a
+}
+func pauseQualityTest(t *testing.T, m *Manager, a *Auth, owner, action string) QualityPause {
+	t.Helper()
+	target, err := m.QualityTarget(a.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, err := m.PauseQuality(context.Background(), owner, QualityPause{AuthID: a.ID, OwnerPlugin: owner, RuleID: action + "-rule", RuleRevision: 1, ActionID: action, ActionRevision: 1, IdentityVersion: target.IdentityVersion, EvidenceRunID: "run-offline", Reason: "explicit incorrect evidence"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+func TestQualityPauseGatesEveryModelAndRejectsAllRetests(t *testing.T) {
+	m, e, a := newQualityManager(t, filepath.Join(t.TempDir(), "quality.db"))
+	ctx := context.Background()
+	opts := ex.Options{Metadata: map[string]any{ex.PinnedAuthMetadataKey: a.ID}}
+	if _, err := m.Execute(ctx, []string{a.Provider}, ex.Request{Model: "quality-model-a"}, opts); err != nil {
+		t.Fatal(err)
+	}
+	p := pauseQualityTest(t, m, a, "model-quality", "action-1")
+	for _, model := range []string{"quality-model-a", "quality-model-b"} {
+		if _, err := m.Execute(ctx, []string{a.Provider}, ex.Request{Model: model}, opts); err == nil {
+			t.Fatal("paused execution admitted")
+		}
+		if _, err := m.ExecuteStream(ctx, []string{a.Provider}, ex.Request{Model: model}, opts); err == nil {
+			t.Fatal("paused stream admitted")
+		}
+		if _, err := m.ExecuteCount(ctx, []string{a.Provider}, ex.Request{Model: model}, opts); err == nil {
+			t.Fatal("paused token count admitted")
+		}
+	}
+	if e.calls.Load() != 1 {
+		t.Fatal("paused request reached upstream")
+	}
+	if m.QualityBusinessAllowed(a.ID) {
+		t.Fatal("duplex turn bypassed pause")
+	}
+	retest, err := m.QualityRetestContext(ctx, "model-quality", "instance-1", p)
+	if err == nil || retest != nil {
+		t.Fatal("retired retest capability granted execution context")
+	}
+	target, err := m.QualityTarget(a.ID)
+	if err != nil || target.CanRetest {
+		t.Fatal("paused target advertised retest capability", target, err)
+	}
+	current, _ := m.GetByID(a.ID)
+	if current.Disabled {
+		t.Fatal("quality pause changed native Disabled")
+	}
+	if m.QualityBusinessAllowed(a.ID) {
+		t.Fatal("retest globally enabled credential")
+	}
+	if _, err = m.ReleaseQuality(ctx, "model-quality", p); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = m.PauseQuality(ctx, "model-quality", p); err == nil {
+		t.Fatal("retired action replay re-paused")
+	}
+	if _, err = m.Execute(ctx, []string{a.Provider}, ex.Request{Model: "quality-model-a"}, opts); err != nil {
+		t.Fatal("manual release did not permit ordinary execution", err)
+	}
+	if e.calls.Load() != 2 {
+		t.Fatal("unexpected upstream call count")
+	}
+}
+func TestQualityOwnershipOperatorAndCooldown(t *testing.T) {
+	m, _, a := newQualityManager(t, filepath.Join(t.TempDir(), "quality.db"))
+	ctx := context.Background()
+	p := pauseQualityTest(t, m, a, "model-quality", "action-1")
+	wrong := p
+	wrong.ActionRevision++
+	if _, err := m.ReleaseQuality(ctx, "model-quality", wrong); err == nil {
+		t.Fatal("stale revision released")
+	}
+	if _, err := m.QualityRetestContext(ctx, "other", "instance", p); err == nil {
+		t.Fatal("wrong owner retested")
+	}
+	other := pauseQualityTest(t, m, a, "other-owner", "action-2")
+	if _, err := m.QualityRetestContext(ctx, "model-quality", "instance", p); err == nil {
+		t.Fatal("other owner bypassed")
+	}
+	if _, err := m.ReleaseQuality(ctx, "other-owner", other); err != nil {
+		t.Fatal(err)
+	}
+	current, _ := m.GetByID(a.ID)
+	current.Disabled = true
+	if _, err := m.Update(ctx, current); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := m.QualityRetestContext(ctx, "model-quality", "instance", p); err == nil {
+		t.Fatal("operator disable bypassed")
+	}
+	target, err := m.ReleaseQuality(ctx, "model-quality", p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !target.OperatorDisabled || target.EffectiveAvailable {
+		t.Fatal("release cleared operator disable")
+	}
+	current, _ = m.GetByID(a.ID)
+	current.Disabled = false
+	current.Status = StatusActive
+	if _, err = m.Update(ctx, current); err != nil {
+		t.Fatal(err)
+	}
+	p = pauseQualityTest(t, m, a, "model-quality", "action-3")
+	current, _ = m.GetByID(a.ID)
+	current.Unavailable = true
+	current.NextRetryAfter = time.Now().Add(time.Hour)
+	if _, err = m.Update(ctx, current); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = m.QualityRetestContext(ctx, "model-quality", "instance", p); err == nil {
+		t.Fatal("native cooldown bypassed")
+	}
+}
+func TestQualityIdentityRefreshReplacementAndRestart(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "quality.db")
+	m, _, a := newQualityManager(t, path)
+	ctx := context.Background()
+	p := pauseQualityTest(t, m, a, "model-quality", "action-1")
+	base, _ := m.GetByID(a.ID)
+	updated := base.Clone()
+	updated.Attributes["api_key"] = "fake-refreshed"
+	if _, err := m.UpdateRefreshedAuth(ctx, base, updated); err != nil {
+		t.Fatal(err)
+	}
+	target, _ := m.QualityTarget(a.ID)
+	if target.IdentityVersion != p.IdentityVersion {
+		t.Fatal("normal refresh changed identity")
+	}
+	if err := m.CloseQualityState(); err != nil {
+		t.Fatal(err)
+	}
+	restarted := NewManager(nil, nil, nil)
+	if err := restarted.OpenQualityState(path); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := restarted.CloseQualityState(); err != nil {
+			t.Error(err)
+		}
+	})
+	if _, err := restarted.Register(ctx, updated); err != nil {
+		t.Fatal(err)
+	}
+	target, _ = restarted.QualityTarget(a.ID)
+	if !target.QualityPaused || target.IdentityVersion != p.IdentityVersion {
+		t.Fatal("restart lost pause or refresh identity")
+	}
+	current, _ := restarted.GetByID(a.ID)
+	current.Attributes["api_key"] = "fake-new-owner"
+	if _, err := restarted.Update(ctx, current); err != nil {
+		t.Fatal(err)
+	}
+	target, _ = restarted.QualityTarget(a.ID)
+	if target.IdentityVersion == p.IdentityVersion {
+		t.Fatal("replacement reused identity")
+	}
+	if _, err := restarted.QualityRetestContext(ctx, "model-quality", "instance-2", p); err == nil {
+		t.Fatal("old evidence retested replacement")
+	}
+	if _, err := restarted.ReleaseQuality(ctx, "model-quality", p); err == nil {
+		t.Fatal("old evidence released replacement")
+	}
+	if _, err := restarted.ReleaseQualityAdministratively(ctx, p); err != nil {
+		t.Fatal(err)
+	}
+}
