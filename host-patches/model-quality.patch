+func nativeRuntimeFixture(t *testing.T, script string) (*Runtime, string) {
+	t.Helper()
+	root := t.TempDir()
+	if err := os.Chmod(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(filepath.Join(root, "bin"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	entrypoint := filepath.Join(root, "bin", "login-runtime")
+	if err := os.WriteFile(entrypoint, []byte("#!/bin/sh\n"+script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	digest, err := digestFile(entrypoint, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := Encode(map[string]any{"schema_version": 2, "runtime_version": "2.0.0", "engine": "go_sobek_protocol", "platform": runtime.GOOS, "arch": runtime.GOARCH, "entrypoint": "bin/login-runtime", "files": map[string]string{"bin/login-runtime": digest}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	manifest := filepath.Join(root, "manifest.json")
+	if err := os.WriteFile(manifest, raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return NewRuntime(manifest), root
+}
