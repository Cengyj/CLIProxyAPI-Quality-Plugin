+}
+
+func TestRuntimeProgressCallbackFailureAndFixedDiagnostics(t *testing.T) {
+	r := runtimeProgressFixture(t, "cat >/dev/null\nprintf '%s\\n' '"+progressSession+"' '"+progressSuccess+"'\n")
+	_, err := r.RunWithProgress(context.Background(), runtimeTestRequest(), func(string) error { return errors.New("storage_unavailable") })
+	if err == nil || err.Error() != "storage_unavailable" {
+		t.Fatalf("progress persistence failure did not stop worker: %v", err)
+	}
+	for _, stage := range []string{"session", "oauth", "browser_verification"} {
+		for _, reason := range []string{"session_unconfirmed", "authentication_not_advanced", "totp_factor_missing", "sentinel_unavailable"} {
+			raw, err := Encode(map[string]any{"version": 1, "job_id": "fixture", "attempt": 1, "error_code": "interaction_required", "error_stage": stage, "error_reason": reason})
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, err = runtimeResponse(raw, runtimeTestRequest(), errors.New("exit status 1"))
+			var diagnostic *runtimeDiagnosticError
+			if !errors.As(err, &diagnostic) || diagnostic.stage != stage || diagnostic.reason != reason {
+				t.Fatalf("fixed diagnostic not preserved: %v", err)
+			}
+		}
+	}
+}
