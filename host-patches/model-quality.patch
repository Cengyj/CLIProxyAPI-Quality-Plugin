diff --git a/internal/store/reserved_auth_path.go b/internal/store/reserved_auth_path.go
new file mode 100644
index 0000000..65e9ec0
--- /dev/null
+++ b/internal/store/reserved_auth_path.go
@@ -0,0 +1,32 @@
+package store
+
+import (
+	"errors"
+	"io/fs"
+	"os"
+	"path/filepath"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+// clearAuthMirror removes ordinary mirrored files while retaining private login state.
+func clearAuthMirror(root string) error {
+	if _, err := os.Stat(root); errors.Is(err, fs.ErrNotExist) {
+		return nil
+	}
+	return filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if coreauth.IsReservedAuthPath(path) {
+			if entry.IsDir() {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if entry.IsDir() {
+			return nil
+		}
+		return os.Remove(path)
+	})
+}
