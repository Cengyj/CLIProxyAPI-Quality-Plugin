+func runDueOfflineAccount(t *testing.T, s *Service, id string) Account {
+	t.Helper()
+	s.accountMu.Lock()
+	a := s.accounts[id]
+	a.View.NextCheckAt = s.opts.Now().Add(-time.Minute).Format(time.RFC3339)
+	err := s.saveAccountLocked(a)
+	s.accountMu.Unlock()
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.maintainAccounts()
+	accounts, err := s.Accounts()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, account := range accounts {
+		if account.ID == id {
+			return account
+		}
+	}
+	t.Fatal("account missing")
+	return Account{}
+}
