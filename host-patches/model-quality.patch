+package authlogin
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/MoeForge/moego/ojson"
+	bolt "go.etcd.io/bbolt"
+)
+
+func TestAccountIdentityAndExplicitMaterialViewUsePlaintextStorage(t *testing.T) {
+	opts := offlineOptions(t)
+	s := offlineService(t, opts)
+	credentials := offlineStart().Credentials
+	body, err := Encode(map[string]any{"entries": []Credentials{credentials}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	write := func() (any, error) {
+		accounts, err := s.ImportAccounts([]Credentials{credentials})
+		return map[string]any{"items": accounts}, err
+	}
+	first, err := s.Idempotent("account-full-identity", "POST/accounts/import", body, write)
+	if err != nil {
+		t.Fatal(err)
+	}
+	id := ojson.GetBytes(first, "items.0.id").String()
+	replay, err := s.Idempotent("account-full-identity", "POST/accounts/import", body, func() (any, error) {
+		t.Fatal("replay executed the import")
+		return nil, nil
+	})
+	if err != nil || ojson.GetBytes(replay, "items.0.email").String() != credentials.Email {
+		t.Fatal("replay lost the full account identity")
+	}
+	accounts, err := s.Accounts()
+	if err != nil || len(accounts) != 1 || accounts[0].Email != credentials.Email {
+		t.Fatal("account list did not return full email")
+	}
+	for _, reply := range [][]byte{first, replay} {
+		if bytes.Contains(reply, []byte(credentials.Password)) || bytes.Contains(reply, []byte(credentials.TOTPSecret)) {
+			t.Fatal("list mutation response included login material")
+		}
+	}
+	detail, err := s.AccountDetail(id)
+	if err != nil || detail.Account.Email != credentials.Email || detail.Credentials != credentials {
+		t.Fatal("explicit account detail did not return original material")
+	}
+	if len(s.Jobs()) != 0 || len(opts.Manager.List()) != 0 {
+		t.Fatal("identity reads started authorization")
+	}
+	assertLoginMaterialOutsideCredentialsNotPersisted(t, s, credentials)
+	if err = s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	s = offlineService(t, opts)
+	detail, err = s.AccountDetail(id)
+	if err != nil || detail.Credentials != credentials {
+		t.Fatal("account detail failed after restart")
+	}
+	if _, err = os.Lstat(filepath.Join(opts.Dir, "vault.key")); !os.IsNotExist(err) {
+		t.Fatal("plaintext account details require no encryption key")
+	}
+	accounts, err = s.Accounts()
+	if err != nil || len(accounts) != 1 || accounts[0].Email != credentials.Email || accounts[0].CredentialsError != "" {
+		t.Fatal("account list changed after restart without a key")
+	}
+}
+
+func TestLoginIdentityViewsAndHistoricalFallback(t *testing.T) {
+	opts := offlineOptions(t)
+	s := offlineService(t, opts)
+	start := offlineStart()
+	start.RememberCredentials = true
+	job, err := s.Start(start)
+	if err != nil || job.Email != start.Credentials.Email {
+		t.Fatal("start did not return full email")
+	}
+	job = waitLogin(t, s, job.ID, "awaiting_commit")
+	candidate, err := s.Candidate(job.CandidateID)
+	if err != nil || candidate.Email != start.Credentials.Email || candidate.AccountID != "offline-account" || candidate.UserID != "offline-user" {
+		t.Fatal("candidate omitted full trusted principal")
+	}
+	if _, err = s.Commit(context.Background(), job.ID, candidate.ID, candidate.Revision); err != nil {
+		t.Fatal(err)
+	}
+	job = waitLogin(t, s, job.ID, "committed")
+	if job.Email != start.Credentials.Email || s.Jobs()[0].Email != start.Credentials.Email {
+		t.Fatal("completed task lost its full identity")
+	}
+	targets := s.Targets()
+	if len(targets) != 1 || targets[0]["email"] != start.Credentials.Email || targets[0]["account_id"] != "offline-account" || targets[0]["user_id"] != "offline-user" {
+		t.Fatal("targets omitted full trusted identity")
+	}
+	status, err := Encode(s.VaultStatus(job.TargetAuthID))
+	if err != nil || ojson.GetBytes(status, "entry.email").String() != start.Credentials.Email {
+		t.Fatal("vault status omitted full email")
+	}
+	assertLoginMaterialOutsideCredentialsNotPersisted(t, s, start.Credentials)
+	if err = s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	s = offlineService(t, opts)
+	job, err = s.Detail(job.ID)
+	if err != nil || job.Email != start.Credentials.Email {
+		t.Fatal("committed task could not recover its trusted identity after restart")
+	}
+	opts.Manager.Remove(context.Background(), job.TargetAuthID)
+	job, err = s.Detail(job.ID)
+	if err != nil || job.Email != "" {
+		t.Fatal("unavailable historical identity must remain unknown")
+	}
+}
+
+func assertLoginMaterialOutsideCredentialsNotPersisted(t *testing.T, s *Service, credentials Credentials) {
+	t.Helper()
+	err := s.journal.db.View(func(tx *bolt.Tx) error {
+		for _, bucket := range []string{"jobs", "idempotency"} {
+			if err := tx.Bucket([]byte(bucket)).ForEach(func(_, raw []byte) error {
+				for _, secret := range []string{credentials.Email, credentials.Password, credentials.TOTPSecret} {
+					if bytes.Contains(raw, []byte(secret)) {
+						t.Errorf("login material unexpectedly copied into %s", bucket)
+					}
+				}
+				return nil
+			}); err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/internal/authlogin/logs.go b/internal/authlogin/logs.go
new file mode 100644
index 0000000..4f4f193
--- /dev/null
+++ b/internal/authlogin/logs.go
@@ -0,0 +1,93 @@
+package authlogin
+
+import (
+	"bytes"
+	"encoding/gob"
+	"errors"
+
+	bolt "go.etcd.io/bbolt"
+)
+
+const maxJobLogEntries = 200
+
+// LogEntry contains fixed diagnostic labels only, never runtime output or credentials.
+type LogEntry struct {
+	ID          uint64 `json:"id"`
+	Time        string `json:"time"`
+	Level       string `json:"level"`
+	Status      string `json:"status"`
+	Phase       string `json:"phase"`
+	ErrorCode   string `json:"error_code,omitempty"`
+	ErrorStage  string `json:"error_stage,omitempty"`
+	ErrorReason string `json:"error_reason,omitempty"`
+}
+
+type JobLogs struct {
+	JobID   string     `json:"job_id"`
+	Entries []LogEntry `json:"entries"`
+	Legacy  bool       `json:"legacy"`
+}
+
+func safeLogEntry(view Job) LogEntry {
+	entry := LogEntry{Level: "info", Status: "unknown"}
+	switch view.Status {
+	case "queued", "waiting_browser", "running", "exchanging", "awaiting_commit", "committing", "committed":
+		entry.Status = view.Status
+	case "cancelling", "cancelled", "discarded", "expired", "interrupted", "interaction_required":
+		entry.Status, entry.Level = view.Status, "warn"
+	case "failed", "conflict", "saved_not_adopted", "commit_unknown":
+		entry.Status, entry.Level = view.Status, "error"
+	}
+	switch view.Phase {
+	case "queued", "authorization", "token_exchange", "review", "saving":
+		entry.Phase = view.Phase
+	default:
+		if runtimeStage(view.Phase) {
+			entry.Phase = view.Phase
+		}
+	}
+	if view.ErrorCode != "" {
+		entry.ErrorCode = SafeCode(errors.New(view.ErrorCode))
+	}
+	if runtimeStage(view.ErrorStage) {
+		entry.ErrorStage = view.ErrorStage
+	}
+	if runtimeReason(view.ErrorReason) {
+		entry.ErrorReason = view.ErrorReason
+	}
+	return entry
+}
+
+func (j *journal) logs(id string) (JobLogs, error) {
+	logs := JobLogs{JobID: id, Entries: []LogEntry{}}
+	err := j.db.View(func(tx *bolt.Tx) error {
+		raw := tx.Bucket([]byte("jobs")).Get([]byte(id))
+		if raw == nil {
+			return errors.New("not_found")
+		}
+		var record storedJob
+		if err := gob.NewDecoder(bytes.NewReader(raw)).Decode(&record); err != nil {
+			return errors.New("storage_unavailable")
+		}
+		logs.Entries = append(logs.Entries, record.LogEntries...)
+		// An old record remains marked incomplete even after new real events arrive.
+		logs.Legacy = record.LogVersion == 0
+		return nil
+	})
+	if err != nil {
+		if err.Error() == "not_found" {
+			return JobLogs{}, err
+		}
+		return JobLogs{}, errors.New("storage_unavailable")
+	}
+	return logs, nil
+}
+
+func (s *Service) Logs(id string) (JobLogs, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.jobs[id] == nil {
+		return JobLogs{}, errors.New("not_found")
+	}
+	return s.journal.logs(id)
+}
diff --git a/internal/authlogin/logs_test.go b/internal/authlogin/logs_test.go
