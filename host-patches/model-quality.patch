+	case "1":
+		if (version != "1.0.0" && version != "1.1.0" && version != "1.1.1" && version != "1.2.0" && version != "1.2.1" && version != "1.2.2") || manifest.Get("engine").String() != "official_browser_forms" || manifest.Get("node").String() != "bin/node" || manifest.Get("entrypoint").String() != "worker.mjs" {
