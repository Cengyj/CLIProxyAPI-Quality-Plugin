+++ b/internal/pluginhost/model_quality_native_test.go
@@ -0,0 +1,334 @@
+//go:build cgo && (linux || darwin || freebsd)
+
+package pluginhost
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	runtimeexecutor "github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/api/handlers"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+// This opt-in test exercises the installed native binary, not a Go mock adapter.
+func TestModelQualityNativeLifecycle(t *testing.T) {
+	library := os.Getenv("MODEL_QUALITY_LIBRARY")
+	if library == "" {
+		t.Skip("set MODEL_QUALITY_LIBRARY to the built model-quality shared library")
+	}
+	var correct atomic.Bool
+	var calls atomic.Int64
+	var hold atomic.Bool
+	var omitTerminal atomic.Bool
+	holdStarted, holdCancelled := make(chan struct{}), make(chan struct{})
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		requestBody, errRead := io.ReadAll(r.Body)
+		if errRead != nil {
+			t.Error(errRead)
+			return
+		}
+		if hold.Load() {
+			close(holdStarted)
+			<-r.Context().Done()
+			close(holdCancelled)
+			return
+		}
+		if r.Header.Get("Authorization") != "Bearer offline-key" {
+			t.Error("wrong credential")
+		}
+		answer := "0"
+		if correct.Load() {
+			answer = "4"
+		}
+		if ojson.GetBytes(requestBody, "stream").Bool() {
+			w.Header().Set("Content-Type", "text/event-stream")
+			terminal := "data: [DONE]\n\n"
+			if omitTerminal.Load() {
+				terminal = ""
+			}
+			_, errWrite := fmt.Fprintf(w, ": heartbeat\n\ndata: {\"model\":\"real-model\",\"choices\":[{\"delta\":{\"content\":\"%s\"},\"finish_reason\":null}]}\n\ndata: {\"model\":\"real-model\",\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":12,\"completion_tokens\":1,\"total_tokens\":13}}\n\n%s", answer, terminal)
+			if errWrite != nil {
+				t.Error(errWrite)
+			}
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, err := fmt.Fprintf(w, `{"id":"offline","model":"real-model","choices":[{"message":{"role":"assistant","content":"%s"},"finish_reason":"stop"}],"usage":{"prompt_tokens":12,"completion_tokens":1,"total_tokens":13}}`, answer)
+		if err != nil {
+			t.Error(err)
+		}
+	}))
+	defer upstream.Close()
+	dir := t.TempDir()
+	libBytes, err := os.ReadFile(library)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pluginDir := filepath.Join(dir, "plugins")
+	if err = os.MkdirAll(pluginDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(filepath.Join(pluginDir, "model-quality"+filepath.Ext(library)), libBytes, 0700); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := config.ParseConfigBytes([]byte(fmt.Sprintf("plugins:\n  enabled: true\n  dir: %q\n  configs:\n    model-quality:\n      enabled: true\n      data_dir: %q\n      automatic_pause: true\n", pluginDir, filepath.Join(dir, "plugin-data"))))
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg.AuthDir = filepath.Join(dir, "auth")
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.SetConfig(cfg)
+	qualityDB := filepath.Join(dir, "authority.db")
+	if err = manager.OpenQualityState(qualityDB); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if errClose := manager.CloseQualityState(); errClose != nil {
+			t.Error(errClose)
+		}
+	})
+	manager.RegisterExecutor(runtimeexecutor.NewOpenAICompatExecutor("offline", cfg))
+	a, err := manager.Register(context.Background(), &coreauth.Auth{ID: "offline-a", Provider: "offline", Status: coreauth.StatusActive, Attributes: map[string]string{"api_key": "offline-key", "base_url": upstream.URL}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	registry.GetGlobalRegistry().RegisterClient(a.ID, "offline", []*registry.ModelInfo{{ID: "real-model", Type: "openai", OwnedBy: "offline"}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(a.ID) })
+	manager.RefreshSchedulerEntry(a.ID)
+	base := handlers.NewBaseAPIHandlers(&cfg.SDKConfig, manager)
+	host := New()
+	host.SetAuthManager(manager)
+	host.SetModelExecutor(base)
+	host.ApplyConfig(context.Background(), cfg)
+	t.Cleanup(host.ShutdownAll)
+	if !host.PluginLoaded("model-quality") || !host.PluginRegistered("model-quality") {
+		t.Fatal("native plugin did not load/register")
+	}
+	host.RegisterManagementRoutes(context.Background(), nil)
+	call := func(method, path string, body []byte, want int) []byte {
+		t.Helper()
+		rec := httptest.NewRecorder()
+		req := httptest.NewRequest(method, "/v8/management/plugins/model-quality"+path, bytes.NewReader(body))
+		if !host.ServeManagementHTTP(rec, req) {
+			t.Fatalf("missing route %s %s", method, path)
+		}
+		if rec.Code != want {
+			t.Fatalf("%s %s: %d %s", method, path, rec.Code, rec.Body.String())
+		}
+		return rec.Body.Bytes()
+	}
+	poll := func(id string) []byte {
+		t.Helper()
+		end := time.Now().Add(15 * time.Second)
+		for time.Now().Before(end) {
+			b := call("GET", "/runs/detail?id="+id, nil, 200)
+			status := ojson.GetBytes(b, "status").String()
+			if status != "queued" && status != "running" {
+				return b
+			}
+			runtime.Gosched()
+		}
+		t.Fatal("run did not finish")
+		return nil
+	}
+	if calls.Load() != 0 {
+		t.Fatal("registration called model")
+	}
+	_ = call("GET", "/targets", nil, 200)
+	_ = call("GET", "/questions", nil, 200)
+	if calls.Load() != 0 {
+		t.Fatal("read-only API called model")
+	}
+	manual := []byte(`{"auth_id":"offline-a","provider":"offline","models":["real-model"],"question_id":"logic-boxes","samples":1,"parameters":{"max_tokens":64,"stream":false},"judge":{"mode":"deterministic"},"idempotency_key":"manual-native"}`)
+	created := call("POST", "/runs", manual, 202)
+	id := ojson.GetBytes(created, "run_id").String()
+	result := poll(id)
+	if ojson.GetBytes(result, "samples.0.quality_verdict").String() != "incorrect" || !ojson.GetBytes(result, "samples.0.comparable").Bool() {
+		t.Fatalf("bad manual evidence: %s", result)
+	}
+	if len(manager.QualityActions()) != 0 {
+		t.Fatal("manual test paused credential")
+	}
+	streamBody := ojson.NewDoc(manual)
+	_ = streamBody.Set("parameters.stream", true)
+	_ = streamBody.Set("idempotency_key", "stream-native")
+	streamCreated := call("POST", "/runs", streamBody.Bytes(), 202)
+	streamResult := poll(ojson.GetBytes(streamCreated, "run_id").String())
+	if ojson.GetBytes(streamResult, "samples.0.quality_verdict").String() != "incorrect" || !ojson.GetBytes(streamResult, "samples.0.comparable").Bool() {
+		t.Fatalf("bad streamed evidence %s", streamResult)
+	}
+	omitTerminal.Store(true)
+	eofBody := ojson.NewDoc(manual)
+	_ = eofBody.Set("parameters.stream", true)
+	_ = eofBody.Set("idempotency_key", "eof-native")
+	eofCreated := call("POST", "/runs", eofBody.Bytes(), 202)
+	eofResult := poll(ojson.GetBytes(eofCreated, "run_id").String())
+	if ojson.GetBytes(eofResult, "samples.0.quality_verdict").String() != "unknown" || ojson.GetBytes(eofResult, "samples.0.comparable").Bool() || ojson.GetBytes(eofResult, "samples.0.evidence.verified").Bool() {
+		t.Fatalf("EOF became quality evidence %s", eofResult)
+	}
+	omitTerminal.Store(false)
+	hold.Store(true)
+	cancelBody := ojson.NewDoc(manual)
+	_ = cancelBody.Set("parameters.stream", true)
+	_ = cancelBody.Set("idempotency_key", "cancel-native")
+	cancelCreated := call("POST", "/runs", cancelBody.Bytes(), 202)
+	cancelID := ojson.GetBytes(cancelCreated, "run_id").String()
+	select {
