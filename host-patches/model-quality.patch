+func (s *Service) Cancel(id string, discard bool) (Job, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	j := s.jobs[id]
+	if j == nil {
+		return Job{}, errors.New("not_found")
+	}
