+		{"wrong_rule", "POST", "/v8/management/plugins/model-quality/actions/release", "different", "action", 1, false},
+		{"wrong_revision", "POST", "/v8/management/plugins/model-quality/actions/release", "rule", "action", 2, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
