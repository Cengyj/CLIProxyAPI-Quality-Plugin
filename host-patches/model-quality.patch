+
+func testRuntimeCancellationTerminatesProcessGroup(t *testing.T, fixture func(*testing.T, string) (*Runtime, string)) {
+	t.Helper()
+	r, root := fixture(t, `#!/bin/sh
+cat >/dev/null
+trap '' TERM
+sleep 300 &
+printf '%s' "$!" > child.pid
+wait
+`)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := r.Run(ctx, runtimeTestRequest()); done <- err }()
+	ticker := time.NewTicker(10 * time.Millisecond)
+	defer ticker.Stop()
+	deadline := time.NewTimer(5 * time.Second)
+	defer deadline.Stop()
+	var childPID int
+	for childPID == 0 {
+		select {
+		case <-ticker.C:
+			raw, err := os.ReadFile(filepath.Join(root, "child.pid"))
+			if err == nil {
+				childPID, _ = strconv.Atoi(string(raw))
+			}
+		case err := <-done:
+			t.Fatalf("worker exited before cancellation: %v", err)
+		case <-deadline.C:
+			t.Fatal("worker did not start")
+		}
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if err == nil || err.Error() != "cancelled" {
+			t.Fatalf("unexpected cancellation: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("cancel did not reap worker")
+	}
+	for {
+		err := syscall.Kill(childPID, 0)
+		if errors.Is(err, syscall.ESRCH) {
+			break
+		}
+		select {
+		case <-ticker.C:
+		case <-deadline.C:
+			t.Fatal("authorization worker descendant survived cancellation")
+		}
+	}
+}
