+package auth
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestFileTokenStoreIgnoresCredentialLoginStorage(t *testing.T) {
+	root := t.TempDir()
+	private := filepath.Join(root, ".credential-login", "runtime")
+	if err := os.MkdirAll(private, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	files := map[string]string{
+		"account.json": `{"type":"codex","email":"offline@example.test"}`,
+		".credential-login/runtime/manifest.json": `{"version":1}`,
+		".credential-login/runtime/package.json":  `{"type":"module"}`,
+		".credential-login/vault.json":            `{"type":"codex","access_token":"private-fixture"}`,
+	}
+	for name, body := range files {
+		if err := os.WriteFile(filepath.Join(root, name), []byte(body), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := os.Symlink(filepath.Join(private, "package.json"), filepath.Join(root, "linked.json")); err != nil {
+		t.Fatal(err)
+	}
+	store := NewFileTokenStore()
+	store.SetBaseDir(root)
+	auths, err := store.List(context.Background())
+	if err != nil || len(auths) != 1 || auths[0].ID != "account.json" {
+		t.Fatalf("private runtime imported: auths=%v err=%v", auths, err)
+	}
+	for _, name := range []string{".credential-login/runtime/package.json", "linked.json"} {
+		path := filepath.Join(root, name)
+		before, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got, err := store.readAuthFiles(path, root); err != nil || len(got) != 0 {
+			t.Fatalf("private single-file load: %v %v", got, err)
+		}
+		if _, err := store.Save(context.Background(), &coreauth.Auth{ID: name, FileName: name, Metadata: map[string]any{"type": "codex"}}); err == nil {
+			t.Fatalf("saved private path %s", name)
+		}
+		if err := store.Delete(context.Background(), path); err == nil {
+			t.Fatalf("deleted private path %s", name)
+		}
+		after, err := os.ReadFile(path)
+		if err != nil || string(before) != string(after) {
+			t.Fatalf("private file changed: %s %v", name, err)
+		}
+	}
+}
+
+func TestReservedAuthPathSymlinkAncestorsAndMissingLeaves(t *testing.T) {
+	root := t.TempDir()
+	private := filepath.Join(root, ".credential-login")
+	if err := os.MkdirAll(private, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	alias := filepath.Join(root, "alias")
+	if err := os.Symlink(private, alias); err != nil {
+		t.Fatal(err)
+	}
+	dangling := filepath.Join(root, "dangling.json")
+	if err := os.Symlink(filepath.Join(private, "missing.json"), dangling); err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{private, filepath.Join(alias, "new", "missing.json"), dangling, `.credential-login\runtime\package.json`, ".CREDENTIAL-LOGIN/vault.json"} {
+		if !IsReservedAuthPath(path) {
+			t.Errorf("private path accepted: %s", path)
+		}
+	}
+	if IsReservedAuthPath(filepath.Join(root, ".credential-login-public.json")) {
+		t.Fatal("ordinary filename rejected")
+	}
+}
