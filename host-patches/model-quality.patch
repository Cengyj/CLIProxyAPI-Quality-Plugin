+func TestCredentialLoginConcurrentFenceAndStaleRefresh(t *testing.T) {
+	m := newLoginTestManager(t, t.TempDir())
+	a := loginTestExisting(t, m)
+	expected := loginSnapshotTest(t, m, a.ID)
+	started := make(chan struct{})
+	finish := make(chan struct{})
+	done := make(chan error, 1)
+	go func() {
+		_, err := m.CommitLoginCandidate(context.Background(), LoginCommitRequest{CommitID: "concurrent", Candidate: loginTestCandidate(a.ID, "new"), Expected: expected, Prepare: func(context.Context, string, string) error { close(started); <-finish; return nil }})
+		done <- err
+	}()
+	<-started
+	if m.QualityBusinessAllowed(a.ID) {
+		t.Fatal("new business admitted during commit")
+	}
+	if _, err := m.Update(context.Background(), a.Clone()); err == nil {
+		t.Fatal("watcher bypassed fence")
+	}
+	if _, err := m.UpdateRefreshedAuth(context.Background(), a, a.Clone()); err == nil {
+		t.Fatal("refresh bypassed fence")
+	}
+	if m.RemoveIf(context.Background(), a.ID, nil) {
