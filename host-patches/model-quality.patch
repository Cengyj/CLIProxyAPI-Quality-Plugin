+		if version != "2.0.0" || manifest.Get("engine").String() != "go_sobek_protocol" || manifest.Get("entrypoint").String() != "bin/login-runtime" || manifest.Get("node").Exists() || manifest.Get("browser").Exists() {
+			return out, runtimeError("runtime_invalid")
+		}
+		executable = "bin/login-runtime"
+		out.progress = true
+		required = []string{executable}
+	default:
+		return out, runtimeError("runtime_invalid")
+	}
+	out.engine = manifest.Get("engine").String()
+	out.version = version
+	out.schema = manifest.Get("schema_version").Raw
