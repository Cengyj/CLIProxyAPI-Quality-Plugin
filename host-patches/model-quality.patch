+func TestManagedAccountConsentOffDuringPrepare(t *testing.T) {
+	for _, level := range []string{"global", "account"} {
+		t.Run(level, func(t *testing.T) {
+			opts := changingOfflineGrants(t)
+			var block atomic.Bool
+			entered, release := make(chan struct{}), make(chan struct{})
+			var releaseOnce sync.Once
+			unblock := func() { releaseOnce.Do(func() { close(release) }) }
+			opts.Owner = func() (Owner, error) {
+				return Owner{ID: "fixture", Valid: func() bool { return true }, Prepare: func(ctx context.Context, _, _, _ string) error {
+					if block.Load() {
+						close(entered)
+						select {
+						case <-release:
+						case <-ctx.Done():
+							return ctx.Err()
+						}
+					}
+					return nil
+				}}, nil
+			}
+			s := offlineService(t, opts)
+			defer unblock()
+			account := bindOfflineAccount(t, s)
+			terminalOfflineFailure(t, opts.Manager, account.AuthID)
+			before, _ := opts.Manager.GetByID(account.AuthID)
+			enableOfflineAccountRepair(t, s, account)
+			block.Store(true)
+			auto := runDueOfflineAccount(t, s, account.ID)
+			select {
+			case <-entered:
+			case <-time.After(5 * time.Second):
+				t.Fatal("automatic commit did not enter prepare")
+			}
+			if level == "global" {
+				settings, _ := s.AccountSettings()
+				settings.AutoReloginEnabled = false
+				if _, err := s.UpdateAccountSettings(settings); err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				accounts, err := s.Accounts()
+				if err != nil {
+					t.Fatal(err)
+				}
+				if _, err = s.UpdateAccount(AccountUpdate{ID: account.ID, Revision: accounts[0].Revision}); err != nil {
+					t.Fatal(err)
+				}
+			}
+			unblock()
+			failed := waitLogin(t, s, auto.LastJobID, "failed")
+			if failed.ErrorCode != "automation_disabled" {
+				t.Fatalf("unexpected disabled result: %+v", failed)
+			}
+			after, _ := opts.Manager.GetByID(account.AuthID)
+			if after.Metadata["refresh_token"] != before.Metadata["refresh_token"] {
+				t.Fatal("disabled automatic job replaced credential")
+			}
+		})
+	}
+}
