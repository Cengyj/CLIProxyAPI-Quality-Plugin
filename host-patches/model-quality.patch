+package usage
+
+import "context"
+
+type trafficSourceContextKey struct{}
+
+// WithTrafficSource attaches host-derived classification outside the upstream payload.
+func WithTrafficSource(ctx context.Context, source string) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	switch source {
+	case "production", "manual_test", "scheduled_probe", "judge", "internal_other":
+	default:
+		source = "unknown"
+	}
+	return context.WithValue(ctx, trafficSourceContextKey{}, source)
+}
+
+// TrafficSourceFromContext never infers production from missing historical data.
+func TrafficSourceFromContext(ctx context.Context) string {
+	if ctx != nil {
+		if s, ok := ctx.Value(trafficSourceContextKey{}).(string); ok {
+			return s
+		}
+	}
+	return "unknown"
+}
