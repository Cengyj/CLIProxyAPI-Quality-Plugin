+package authlogin
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	bolt "go.etcd.io/bbolt"
+)
+
+func TestPlaintextStorageReadyWithoutKeyOrInitialization(t *testing.T) {
+	opts := offlineOptions(t)
+	s := offlineService(t, opts)
+	status := s.VaultStatus("").(map[string]any)
+	if status["available"] != true || status["initialized"] != true || status["storage_mode"] != "plaintext" {
+		t.Fatal("new plaintext storage is not immediately ready")
+	}
+	if _, err := os.Stat(filepath.Join(opts.Dir, "vault.key")); !os.IsNotExist(err) {
+		t.Fatal("plaintext storage created an encryption key")
+	}
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	s = offlineService(t, opts)
+	status = s.VaultStatus("").(map[string]any)
+	if status["available"] != true || status["storage_mode"] != "plaintext" {
+		t.Fatal("plaintext storage is not ready after restart")
+	}
+}
+
+func TestPlaintextStorageRejectsOldOrUnmarkedPopulatedJournal(t *testing.T) {
+	for _, schema := range []string{"1", "future", ""} {
+		t.Run("schema_"+schema, func(t *testing.T) {
+			opts := offlineOptions(t)
+			s := offlineService(t, opts)
+			if err := s.journal.db.Update(func(tx *bolt.Tx) error {
+				return tx.Bucket([]byte("meta")).Put([]byte("schema"), []byte(schema))
+			}); err != nil {
+				t.Fatal(err)
+			}
+			if err := s.Close(); err != nil {
+				t.Fatal(err)
+			}
+			before, err := os.ReadFile(filepath.Join(opts.Dir, "credential-login.db"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if journal, errOpen := openJournal(opts.Dir); errOpen == nil {
+				_ = journal.db.Close()
+				t.Fatal("unsupported or unmarked populated journal was accepted")
+			}
+			after, err := os.ReadFile(filepath.Join(opts.Dir, "credential-login.db"))
+			if err != nil || !bytes.Equal(before, after) {
+				t.Fatal("rejected journal was changed")
+			}
+		})
+	}
+}
+
+func TestPlaintextSavedCredentialsRetainIdentityAndCAS(t *testing.T) {
+	opts := offlineOptions(t)
+	s := offlineService(t, opts)
+	start := offlineStart()
+	start.RememberCredentials = true
+	job, err := s.Start(start)
+	if err != nil {
+		t.Fatal(err)
+	}
+	job = waitLogin(t, s, job.ID, "awaiting_commit")
+	if _, err = s.Commit(context.Background(), job.ID, job.CandidateID, job.Revision); err != nil {
+		t.Fatal(err)
+	}
+	job = waitLogin(t, s, job.ID, "committed")
+	entry, _, err := s.vault.entry(job.TargetAuthID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	s = offlineService(t, opts)
+	if got, errRead := s.vault.read(job.TargetAuthID); errRead != nil || got != start.Credentials {
+		t.Fatal("saved plaintext credentials changed after restart")
+	}
+	if err = s.PutVault(job.TargetAuthID, entry.Revision-1, start.Credentials); err == nil || err.Error() != "vault_conflict" {
+		t.Fatal("plaintext storage bypassed CAS")
+	}
+	if err = s.PutVault(job.TargetAuthID, entry.Revision, start.Credentials); err != nil {
+		t.Fatal(err)
+	}
+	a, _ := opts.Manager.GetByID(job.TargetAuthID)
+	a.Metadata["account_id"] = "replacement-identity"
+	if _, err = opts.Manager.Update(context.Background(), a); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = s.vault.read(job.TargetAuthID); err == nil || err.Error() != "vault_identity_changed" {
+		t.Fatal("plaintext storage bypassed identity checks")
+	}
+}
