+func TestQualityAutomaticRecoveryAlwaysRejectedAndManualReleasePreservesRestrictions(t *testing.T) {
+	for _, kind := range []string{"healthy", "operator", "cooldown", "other_owner"} {
+		t.Run(kind, func(t *testing.T) {
+			m, _, a := newQualityManager(t, filepath.Join(t.TempDir(), "quality.db"))
+			p := pauseQualityTest(t, m, a, "model-quality", "action-1")
+			if _, err := m.QualityRetestContext(context.Background(), "model-quality", "instance", p); err == nil {
+				t.Fatal("legacy retest accepted")
+			}
+			switch kind {
+			case "operator":
+				current, _ := m.GetByID(a.ID)
+				current.Disabled = true
+				if _, err := m.Update(context.Background(), current); err != nil {
+					t.Fatal(err)
+				}
+			case "cooldown":
+				current, _ := m.GetByID(a.ID)
+				current.Unavailable = true
+				current.NextRetryAfter = time.Now().Add(time.Hour)
+				if _, err := m.Update(context.Background(), current); err != nil {
+					t.Fatal(err)
+				}
+			case "other_owner":
+				pauseQualityTest(t, m, a, "other-owner", "action-2")
+			}
+			if _, err := m.ReleaseQualityVerified(context.Background(), "model-quality", p, []string{"quality-model-a"}); err == nil {
+				t.Fatal("stale successful evidence released after blocker changed")
+			}
+			status, _, err := m.QualityActionStatus("model-quality", p.ActionID)
+			if err != nil || status != "active" {
+				t.Fatal("blocked recovery lost ownership", status, err)
+			}
+			target, err := m.ReleaseQuality(context.Background(), "model-quality", p)
+			if err != nil {
+				t.Fatal("manual release failed", err)
+			}
+			if kind == "operator" && !target.OperatorDisabled {
+				t.Fatal("manual release cleared operator disable")
+			}
+			if kind == "cooldown" && target.EffectiveAvailable {
+				t.Fatal("manual release cleared cooldown")
+			}
+			if kind == "other_owner" && !target.QualityPaused {
+				t.Fatal("manual release cleared another owner")
+			}
+
+			status, binding, err := m.QualityActionStatus("model-quality", p.ActionID)
+			if err != nil || status != "released" || binding == nil || binding.IdentityVersion != p.IdentityVersion {
+				t.Fatal("durable receipt missing", status, err)
+			}
+		})
+	}
