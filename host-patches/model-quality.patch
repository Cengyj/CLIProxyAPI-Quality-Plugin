+func TestCredentialAccountInspectionRestoresWithoutBrowser(t *testing.T) {
+	dir := t.TempDir()
+	store := storeauth.NewFileTokenStore()
+	store.SetBaseDir(dir)
+	manager := coreauth.NewManager(store, nil, nil)
+	cfg := &config.Config{AuthDir: dir}
+	manager.SetConfigSnapshot(cfg)
+	if err := manager.OpenQualityState(filepath.Join(dir, "authority.db")); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = manager.CloseQualityState() })
+	service, err := authlogin.New(authlogin.Options{Dir: filepath.Join(dir, ".credential-login"), Config: cfg, Manager: manager, Runtime: unavailableLoginWorker{}, Owner: func() (authlogin.Owner, error) {
+		return authlogin.Owner{ID: "offline", Valid: func() bool { return true }}, nil
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	settings, err := service.AccountSettings()
+	if err != nil {
+		t.Fatal(err)
+	}
+	settings.InspectionEnabled = true
+	settings.IntervalMinutes = 37
+	if _, err = service.UpdateAccountSettings(settings); err != nil {
+		t.Fatal(err)
+	}
+	if err = service.Close(); err != nil {
+		t.Fatal(err)
+	}
+	h := NewHandler(cfg, "", manager)
+	h.SetPluginHost(pluginhost.New())
+	h.SetCredentialLoginAdoptHook(func(context.Context, *coreauth.Auth) error { return nil })
+	h.StartCredentialAccountInspection()
+	t.Cleanup(func() { _ = h.CloseCredentialLogins() })
+	if h.credentialLogins == nil {
+		t.Fatal("persisted scheduler was not restored without an HTTP request")
+	}
+	restored, err := h.credentialLogins.AccountSettings()
+	if err != nil || !restored.InspectionEnabled || restored.IntervalMinutes != 37 || restored.AutoReloginEnabled {
+		t.Fatal("scheduler settings were not preserved")
+	}
+	if len(h.credentialLogins.Jobs()) != 0 || len(manager.List()) != 0 {
+		t.Fatal("restoring scheduler created a login")
+	}
+}
+
+func TestCredentialLoginConfigReloadRetiresObsoleteEgress(t *testing.T) {
+	dir := t.TempDir()
+	store := storeauth.NewFileTokenStore()
+	store.SetBaseDir(dir)
+	manager := coreauth.NewManager(store, nil, nil)
+	cfg := &config.Config{AuthDir: dir}
+	manager.SetConfigSnapshot(cfg)
+	if err := manager.OpenQualityState(filepath.Join(dir, "authority.db")); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = manager.CloseQualityState() })
+	original, err := authlogin.New(authlogin.Options{Dir: filepath.Join(dir, ".credential-login"), Config: cfg, Manager: manager, Runtime: unavailableLoginWorker{}, Owner: func() (authlogin.Owner, error) {
+		return authlogin.Owner{ID: "offline", Valid: func() bool { return true }}, nil
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	handler := NewHandler(cfg, "", manager)
+	handler.SetPluginHost(pluginhost.New())
+	handler.SetCredentialLoginAdoptHook(func(context.Context, *coreauth.Auth) error { return nil })
+	handler.credentialLogins = original
+	if _, err = handler.loginService(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = handler.CloseCredentialLogins() })
+	if _, err = original.Start(authlogin.StartRequest{ConsumerPlugin: "model-quality", Method: "browser", Intent: "import"}); err != nil {
+		t.Fatal(err)
+	}
+	unchanged := cfg.CloneForRuntime()
+	unchanged.RequestRetry = 3
+	handler.SetConfig(unchanged)
+	if handler.credentialLogins != original {
+		t.Fatal("unrelated config update interrupted login")
+	}
+	updated := cfg.CloneForRuntime()
+	updated.ProxyURL = "http://127.0.0.1:43210"
+	manager.SetConfigSnapshot(updated)
+	handler.SetConfig(updated)
+	if handler.credentialLogins != nil {
+		t.Fatal("obsolete service retained after proxy change")
+	}
+	if _, err = original.Start(authlogin.StartRequest{ConsumerPlugin: "model-quality", Method: "browser", Intent: "import"}); err == nil {
+		t.Fatal("old service admitted a fresh login")
+	}
+	replacement, err := handler.loginService()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if replacement == original || handler.credentialLoginBinding.proxyURL != updated.ProxyURL {
+		t.Fatal("new service did not bind updated proxy")
+	}
+	home := updated.CloneForRuntime()
+	home.Home.Enabled = true
+	handler.SetConfig(home)
+	if handler.credentialLogins != nil {
+		t.Fatal("standalone service survived Home mode")
+	}
+	if _, err = handler.loginService(); err == nil {
+		t.Fatal("Home mode admitted login service")
+	}
+}
