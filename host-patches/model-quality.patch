@@ -0,0 +1,29 @@
+package pluginhost
+
+import (
+	"context"
+
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+func (h *Host) prepareQualityExecution(ctx context.Context, req pluginapi.HostModelExecutionRequest) (context.Context, *coreexecutor.EvidenceCollector, error) {
+	ctx, err := h.qualityModelContext(ctx, req)
+	if err != nil {
+		return nil, nil, err
+	}
+	source := req.TrafficSource
+	switch source {
+	case "manual_test", "scheduled_probe", "judge":
+	default:
+		source = "internal_other"
+	}
+	ctx = usage.WithTrafficSource(ctx, source)
+	ctx, collector := coreexecutor.WithEvidenceCollector(ctx, req.Model, req.AuthID, req.Body)
+	return ctx, collector, nil
+}
+
+func modelEvidence(e coreexecutor.ExecutionEvidence) pluginapi.ModelEvidence {
+	return pluginapi.ModelEvidence{PayloadConfigVersion: e.PayloadConfigVersion, Verified: e.Verified, Reason: e.Reason, RequestedModel: e.RequestedModel, ResolvedModel: e.ResolvedModel, AuthID: e.AuthID, PayloadFingerprint: e.PayloadFingerprint, ConditionsChanged: e.ConditionsChanged, Path: e.Path}
+}
diff --git a/internal/pluginhost/model_operations_quality_test.go b/internal/pluginhost/model_operations_quality_test.go
new file mode 100644
index 0000000..c2ea911
--- /dev/null
+++ b/internal/pluginhost/model_operations_quality_test.go
@@ -0,0 +1,116 @@
+package pluginhost
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/interfaces"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/api/handlers"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginabi"
+)
+
+func modelOperation(t *testing.T, h *Host, ctx context.Context) string {
+	t.Helper()
+	raw, err := h.callFromPlugin(ctx, pluginabi.MethodHostModelOperationOpen, []byte(`{}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	r, err := decodeRPCEnvelope[rpcHostHTTPOperationOpenResponse](raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r.OperationID
+}
+func operationBody(op string, stream bool) []byte {
+	d := ojson.NewDocString(`{"entry_protocol":"openai","exit_protocol":"openai","model":"m","body":"e30=","traffic_source":"manual_test"}`)
+	_ = d.Set("operation_id", op)
+	_ = d.Set("stream", stream)
+	return d.Bytes()
+}
+func cancelOperation(t *testing.T, h *Host, ctx context.Context, op string) {
+	t.Helper()
+	d := ojson.NewDocString(`{}`)
+	_ = d.Set("operation_id", op)
+	if _, err := h.callFromPlugin(ctx, pluginabi.MethodHostModelCancel, d.Bytes()); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestModelOperationCancelsBeforeFirstByteAndNonStream(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		t.Run(map[bool]string{false: "nonstream", true: "first-byte"}[stream], func(t *testing.T) {
+			h := New()
+			instance := &hostCallbackInstance{}
+			ctx := withHostCallbackIdentity(context.Background(), "model-quality", instance)
+			started := make(chan struct{})
+			done := make(chan error, 1)
+			wait := func(ctx context.Context) {
+				if usage.TrafficSourceFromContext(ctx) != "manual_test" {
+					t.Error("missing trusted source")
+				}
+				close(started)
+				<-ctx.Done()
+			}
+			h.SetModelExecutor(&fakeHostModelExecutor{executeModel: func(ctx context.Context, _ handlers.ModelExecutionRequest) (handlers.ModelExecutionResponse, *interfaces.ErrorMessage) {
+				wait(ctx)
+				return handlers.ModelExecutionResponse{}, &interfaces.ErrorMessage{StatusCode: 499, Error: ctx.Err()}
+			}, executeModelStream: func(ctx context.Context, _ handlers.ModelExecutionRequest) (handlers.ModelExecutionStream, *interfaces.ErrorMessage) {
+				wait(ctx)
+				return handlers.ModelExecutionStream{}, &interfaces.ErrorMessage{StatusCode: 499, Error: ctx.Err()}
+			}})
+			op := modelOperation(t, h, ctx)
+			method := pluginabi.MethodHostModelExecute
+			if stream {
+				method = pluginabi.MethodHostModelExecuteStream
+			}
+			go func() { _, err := h.callFromPlugin(ctx, method, operationBody(op, stream)); done <- err }()
+			<-started
+			cancelOperation(t, h, withHostCallbackIdentity(context.Background(), "other", &hostCallbackInstance{}), op)
+			select {
+			case <-done:
+				t.Fatal("other plugin cancelled operation")
+			default:
+			}
+			cancelOperation(t, h, ctx, op)
+			cancelOperation(t, h, ctx, op)
+			if err := <-done; err == nil {
+				t.Fatal("cancel returned success")
+			}
+		})
+	}
+}
+
+func TestModelOperationCancelsOpenStreamAndLifecycle(t *testing.T) {
+	h := New()
+	instance := &hostCallbackInstance{}
+	ctx := withHostCallbackIdentity(context.Background(), "model-quality", instance)
+	seen := make(chan context.Context, 1)
+	h.SetModelExecutor(&fakeHostModelExecutor{executeModelStream: func(c context.Context, _ handlers.ModelExecutionRequest) (handlers.ModelExecutionStream, *interfaces.ErrorMessage) {
+		seen <- c
+		ch := make(chan handlers.ModelExecutionChunk)
+		go func() { <-c.Done(); close(ch) }()
+		return handlers.ModelExecutionStream{StatusCode: http.StatusOK, Chunks: ch}, nil
+	}})
+	op := modelOperation(t, h, ctx)
+	raw, err := h.callFromPlugin(ctx, pluginabi.MethodHostModelExecuteStream, operationBody(op, true))
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := decodeRPCEnvelope[struct {
+		StreamID string `json:"stream_id"`
+	}](raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.closeHostHTTPCallbackInstance("model-quality", instance)
+	<-((<-seen).Done())
+	if _, _, err := h.modelStreams.read(context.Background(), "model-quality", instance, resp.StreamID); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = h.callFromPlugin(ctx, pluginabi.MethodHostModelOperationOpen, []byte(`{}`)); err == nil {
+		t.Fatal("closed instance reused")
+	}
+}
diff --git a/internal/pluginhost/model_quality_native_test.go b/internal/pluginhost/model_quality_native_test.go
