new file mode 100644
index 0000000..e8dca9e
--- /dev/null
+++ b/internal/api/handlers/management/auth_files_reserved_path_test.go
@@ -0,0 +1,111 @@
+package management
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	sdkAuth "github.com/router-for-me/CLIProxyAPI/v8/sdk/auth"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestCredentialLoginPrivateStorageExcludedFromAuthManagement(t *testing.T) {
+	t.Setenv("MANAGEMENT_PASSWORD", "")
+	root := t.TempDir()
+	private := filepath.Join(root, ".credential-login", "runtime", "package.json")
+	if err := os.MkdirAll(filepath.Dir(private), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	privateBytes := `{"type":"module","email":"private-marker@example.test"}`
+	if err := os.WriteFile(private, []byte(privateBytes), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(private, filepath.Join(root, "linked.json")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "account.json"), []byte(`{"type":"codex"}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	manager := coreauth.NewManager(nil, nil, nil)
+	if _, err := manager.Register(context.Background(), &coreauth.Auth{
+		ID: "old-import.json", FileName: "package.json", Provider: "module",
+		Attributes: map[string]string{coreauth.AttributePath: private, coreauth.AttributeSourceBackend: coreauth.AuthSourceFile},
+		Metadata:   map[string]any{"type": "module", "email": "private-marker@example.test"},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	h := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: root}, manager)
+	store := sdkAuth.NewFileTokenStore()
+	store.SetBaseDir(root)
+	h.tokenStore = store
+	candidate := &coreauth.Auth{ID: "old-import.json", FileName: "new.json", Metadata: map[string]any{"type": "codex"}}
+	h.mergeExistingAuthFileMetadata(candidate)
+	if candidate.Metadata["email"] != nil {
+		t.Fatal("private runtime metadata merged into an ordinary credential")
+	}
+	request := func(handler gin.HandlerFunc, method, target, body string) *httptest.ResponseRecorder {
+		t.Helper()
+		rec := httptest.NewRecorder()
+		ctx, _ := gin.CreateTestContext(rec)
+		ctx.Request = httptest.NewRequest(method, target, strings.NewReader(body))
+		ctx.Request.Header.Set("Content-Type", "application/json")
+		handler(ctx)
+		return rec
+	}
+	for _, candidate := range []string{".credential-login/runtime/package.json", "linked.json"} {
+		query := "/v8/management/auth-files?name=" + url.QueryEscape(candidate)
+		for _, action := range []struct {
+			name, method string
+			handler      gin.HandlerFunc
+		}{
+			{"download", http.MethodGet, h.DownloadAuthFile},
+			{"upload", http.MethodPost, h.UploadAuthFile},
+			{"delete", http.MethodDelete, h.DeleteAuthFile},
+		} {
+			rec := request(action.handler, action.method, query, `{"type":"codex"}`)
+			if rec.Code < 400 || rec.Code >= 500 {
+				t.Errorf("%s %s status=%d body=%s", action.name, candidate, rec.Code, rec.Body.String())
+			}
+		}
+	}
+	for _, action := range []struct {
+		handler              gin.HandlerFunc
+		method, target, body string
+	}{
+		{h.DeleteAuthFile, http.MethodDelete, "/v8/management/auth-files?name=package.json", ""},
+		{h.PatchAuthFileFields, http.MethodPatch, "/v8/management/auth-files/fields", `{"name":"old-import.json","prefix":"modified"}`},
+		{h.PatchAuthFileStatus, http.MethodPatch, "/v8/management/auth-files/status", `{"name":"old-import.json","disabled":true}`},
+	} {
+		rec := request(action.handler, action.method, action.target, action.body)
+		if rec.Code < 400 || rec.Code >= 500 {
+			t.Errorf("private runtime record mutated: %d %s", rec.Code, rec.Body.String())
+		}
+	}
+	for _, diskOnly := range []bool{false, true} {
+		if diskOnly {
+			h.authManager = nil
+		}
+		rec := request(h.ListAuthFiles, http.MethodGet, "/v8/management/auth-files", "")
+		if rec.Code != http.StatusOK || strings.Contains(rec.Body.String(), "private-marker") || strings.Contains(rec.Body.String(), "package.json") || strings.Contains(rec.Body.String(), "linked.json") {
+			t.Errorf("private file listed: %d %s", rec.Code, rec.Body.String())
+		}
+	}
+	h.authManager = manager
+	rec := request(h.DeleteAuthFile, http.MethodDelete, "/v8/management/auth-files?all=true", "")
+	if rec.Code != http.StatusOK {
+		t.Fatalf("delete all: %d %s", rec.Code, rec.Body.String())
+	}
+	if data, err := os.ReadFile(private); err != nil || string(data) != privateBytes {
+		t.Fatalf("private file changed: %q %v", data, err)
+	}
+	if _, err := os.Lstat(filepath.Join(root, "linked.json")); err != nil {
+		t.Fatalf("private alias deleted: %v", err)
+	}
+}
diff --git a/internal/api/handlers/management/credential_accounts.go b/internal/api/handlers/management/credential_accounts.go
new file mode 100644
index 0000000..aff05a2
--- /dev/null
+++ b/internal/api/handlers/management/credential_accounts.go
@@ -0,0 +1,144 @@
+package management
+
+import (
+	"errors"
+	"net/http"
+	"strconv"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/authlogin"
+)
+
+// Account writes share the login service's authenticated idempotency journal.
+func credentialAccountWrite(s *authlogin.Service, method, path string, raw []byte) (any, error) {
+	invalid := errors.New("invalid_request")
+	if path == "/accounts/import" && method == http.MethodPost {
+		r, err := authlogin.Object(raw, "entries", "proxy_url")
+		if err != nil || !r.Get("entries").IsArray() {
+			return nil, invalid
+		}
+		if proxy := r.Get("proxy_url"); proxy.Exists() && proxy.Type != ojson.String {
+			return nil, invalid
+		}
+		values := r.Get("entries").Array()
+		if len(values) < 1 || len(values) > 100 {
+			return nil, invalid
+		}
+		entries := make([]authlogin.Credentials, 0, len(values))
+		defer func() {
+			for i := range entries {
+				entries[i] = authlogin.Credentials{}
+			}
+		}()
+		for _, value := range values {
+			entry, err := authlogin.DecodeCredentials(value)
+			if err != nil {
+				return nil, err
+			}
+			entries = append(entries, entry)
+		}
+		accounts, err := s.ImportAccountsWithProxy(entries, r.Get("proxy_url").String())
+		return map[string]any{"items": accounts}, err
+	}
+	if path == "/accounts/settings" && method == http.MethodPut {
+		r, err := authlogin.Object(raw, "revision", "inspection_enabled", "auto_relogin_enabled", "interval_minutes", "login_proxy_url")
+		if err != nil {
+			return nil, err
+		}
+		if proxy := r.Get("login_proxy_url"); proxy.Exists() && proxy.Type != ojson.String {
+			return nil, invalid
+		}
+		revision, err := accountUint(r.Get("revision"))
+		if err != nil {
+			return nil, err
+		}
+		interval, err := accountUint(r.Get("interval_minutes"))
+		if err != nil || interval < 5 || interval > 1440 {
+			return nil, invalid
+		}
+		for _, key := range []string{"inspection_enabled", "auto_relogin_enabled"} {
+			v := r.Get(key)
+			if v.Type != ojson.True && v.Type != ojson.False {
+				return nil, invalid
+			}
+		}
+		current, err := s.AccountSettings()
+		if err != nil {
+			return nil, err
+		}
+		if r.Get("login_proxy_url").Exists() {
+			current.LoginProxyURL = r.Get("login_proxy_url").String()
+		}
+		return s.UpdateAccountSettings(authlogin.AccountSettings{Revision: revision, InspectionEnabled: r.Get("inspection_enabled").Bool(), AutoReloginEnabled: r.Get("auto_relogin_enabled").Bool(), IntervalMinutes: int(interval), LoginProxyURL: current.LoginProxyURL})
+	}
+	allowed := []string{"id"}
+	if path != "/accounts/inspect" {
+		allowed = append(allowed, "revision")
+	}
+	if path == "/accounts/start" {
+		allowed = append(allowed, "target_auth_id")
+	}
+	if path == "/accounts/entry" && method == http.MethodPut {
+		allowed = append(allowed, "label", "auto_relogin", "credentials", "proxy_url")
+	}
+	r, err := authlogin.Object(raw, allowed...)
+	if err != nil {
+		return nil, err
+	}
+	for _, key := range []string{"id", "label", "target_auth_id"} {
+		v := r.Get(key)
+		if v.Exists() && (v.Type != ojson.String || len(v.String()) > 512) {
+			return nil, invalid
+		}
+	}
+	id := r.Get("id").String()
+	if path == "/accounts/inspect" && method == http.MethodPost {
+		accounts, err := s.InspectAccounts(id)
+		return map[string]any{"items": accounts}, err
+	}
+	if id == "" {
+		return nil, invalid
+	}
+	revision, err := accountUint(r.Get("revision"))
+	if err != nil {
+		return nil, err
+	}
+	switch {
+	case path == "/accounts/start" && method == http.MethodPost:
+		return s.StartAccount(id, revision, r.Get("target_auth_id").String())
+	case path == "/accounts/entry" && method == http.MethodDelete:
+		return map[string]bool{"deleted": true}, s.DeleteAccount(id, revision)
+	case path == "/accounts/entry" && method == http.MethodPut:
+		v := r.Get("auto_relogin")
+		if v.Type != ojson.True && v.Type != ojson.False {
+			return nil, invalid
+		}
+		update := authlogin.AccountUpdate{ID: id, Revision: revision, Label: r.Get("label").String(), AutoRelogin: v.Bool()}
+		if proxy := r.Get("proxy_url"); proxy.Exists() {
+			if proxy.Type != ojson.String {
+				return nil, invalid
+			}
+			value := proxy.String()
+			update.ProxyURL = &value
+		}
+		if r.Get("credentials").Exists() {
+			credentials, err := authlogin.DecodeCredentials(r.Get("credentials"))
+			if err != nil {
+				return nil, err
+			}
+			update.Credentials = &credentials
+			defer func() { credentials = authlogin.Credentials{} }()
+		}
+		return s.UpdateAccount(update)
+	default:
+		return nil, errors.New("not_found")
+	}
+}
+
+func accountUint(v ojson.Result) (uint64, error) {
+	value, err := strconv.ParseUint(v.Raw, 10, 64)
+	if v.Type != ojson.Number || err != nil {
+		return 0, errors.New("invalid_request")
+	}
+	return value, nil
+}
diff --git a/internal/api/handlers/management/credential_login_file_guard.go b/internal/api/handlers/management/credential_login_file_guard.go
new file mode 100644
index 0000000..594e15b
--- /dev/null
+++ b/internal/api/handlers/management/credential_login_file_guard.go
@@ -0,0 +1,33 @@
+package management
+
+import (
+	"context"
+	"fmt"
+
+	sdkAuth "github.com/router-for-me/CLIProxyAPI/v8/sdk/auth"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func isReservedAuthRecord(auth *coreauth.Auth) bool {
+	if auth == nil {
+		return false
+	}
+	for _, path := range []string{auth.ID, auth.FileName, authAttribute(auth, coreauth.AttributePath), authAttribute(auth, coreauth.AttributeSource), authAttribute(auth, coreauth.AttributeVirtualSource)} {
+		if sdkAuth.IsReservedAuthPath(path) {
+			return true
+		}
+	}
+	return false
+}
+
+// guardLoginFileMutation keeps direct management file writes outside an active
+// login commit. The write callback must not reenter manager mutation methods.
+func (h *Handler) guardLoginFileMutation(ctx context.Context, path string, write func() error) error {
+	if sdkAuth.IsReservedAuthPath(path) {
+		return fmt.Errorf("%w: reserved private path", errInvalidAuthFile)
+	}
+	if h == nil || h.authManager == nil {
+		return write()
+	}
+	return h.authManager.WithLoginFileMutation(ctx, path, write)
+}
diff --git a/internal/api/handlers/management/credential_logins.go b/internal/api/handlers/management/credential_logins.go
new file mode 100644
index 0000000..37cce87
--- /dev/null
+++ b/internal/api/handlers/management/credential_logins.go
@@ -0,0 +1,393 @@
+package management
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/authlogin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/pluginhost"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func (h *Handler) SetCredentialLoginAdoptHook(hook coreauth.PostAuthHook) {
+	h.credentialLoginMu.Lock()
+	defer h.credentialLoginMu.Unlock()
+	h.credentialLoginAdopt = hook
+}
+func (h *Handler) CloseCredentialLogins() error {
+	h.credentialLoginMu.Lock()
+	s := h.credentialLogins
+	h.credentialLogins = nil
+	h.credentialLoginClosed = true
+	cancel, done := h.credentialLoginSupervisorCancel, h.credentialLoginSupervisorDone
+	if cancel != nil {
+		cancel()
+	}
+	h.credentialLoginMu.Unlock()
+	if done != nil {
+		<-done
+	}
+	if s != nil {
+		return s.Close()
+	}
+	return nil
+}
+
+// StartCredentialAccountInspection restores an existing account scheduler even
+// when no administrator opens the UI after a host restart. A new installation
+// remains idle until an explicit login-management action creates its journal.
+func (h *Handler) StartCredentialAccountInspection() {
+	h.credentialLoginMu.Lock()
+	if h.credentialLoginClosed || h.credentialLoginSupervisorCancel != nil {
+		h.credentialLoginMu.Unlock()
+		return
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	h.credentialLoginSupervisorCancel, h.credentialLoginSupervisorDone = cancel, done
+	h.credentialLoginMu.Unlock()
+	h.resumeCredentialAccountInspection()
+	go func() {
+		defer close(done)
+		ticker := time.NewTicker(15 * time.Second)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				h.resumeCredentialAccountInspection()
+			}
+		}
+	}()
+}
+
+func (h *Handler) resumeCredentialAccountInspection() {
+	cfg, binding := h.credentialLoginSnapshot()
+	if cfg == nil || binding.home || binding.authDir == "" {
+		return
+	}
+	info, err := os.Lstat(filepath.Join(binding.authDir, ".credential-login", "credential-login.db"))
+	if err != nil || !info.Mode().IsRegular() {
+		return
+	}
+	_, _ = h.loginService()
+}
+
+// credentialLoginBinding contains the settings frozen by a login service.
+// A new request must never start on an obsolete egress or source authority.
+type credentialLoginBinding struct {
+	authDir, proxyURL string
+	home              bool
+	manager           *coreauth.Manager
+	host              *pluginhost.Host
+}
+
+func (h *Handler) credentialLoginSnapshot() (*config.Config, credentialLoginBinding) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	cfg := h.cfg.CloneForRuntime()
+	binding := credentialLoginBinding{manager: h.authManager, host: h.pluginHost}
+	if cfg != nil {
+		binding.authDir = cfg.AuthDir
+		binding.proxyURL = cfg.ProxyURL
+		binding.home = cfg.Home.Enabled
+	}
+	return cfg, binding
+}
+func (h *Handler) retireChangedCredentialLoginService() {
+	h.credentialLoginMu.Lock()
+	defer h.credentialLoginMu.Unlock()
+	_, binding := h.credentialLoginSnapshot()
+	h.retireCredentialLoginBindingLocked(binding)
+}
+func (h *Handler) retireCredentialLoginBindingLocked(binding credentialLoginBinding) {
+	if h.credentialLogins == nil || h.credentialLoginBinding == nil || *h.credentialLoginBinding == binding {
+		return
+	}
+	old := h.credentialLogins
+	h.credentialLogins = nil
+	h.credentialLoginBinding = nil
+	_ = old.Close()
+}
+func (h *Handler) loginService() (*authlogin.Service, error) {
+	h.credentialLoginMu.Lock()
+	defer h.credentialLoginMu.Unlock()
+	if h.credentialLoginClosed {
+		return nil, errors.New("plugin_unavailable")
+	}
+	cfg, binding := h.credentialLoginSnapshot()
+	h.retireCredentialLoginBindingLocked(binding)
+	if h.credentialLogins != nil {
+		if h.credentialLoginBinding == nil {
+			h.credentialLoginBinding = &binding
+		}
+		return h.credentialLogins, nil
+	}
+	if cfg == nil || binding.manager == nil || binding.host == nil || binding.home || h.credentialLoginAdopt == nil {
+		return nil, errors.New("plugin_unavailable")
+	}
+	if err := binding.manager.ReconcileLoginCommits(context.Background(), h.credentialLoginAdopt); err != nil {
+		return nil, errors.New("commit_unknown")
+	}
+	// Owner validity includes this service's source and egress snapshot, so a
+	// config update invalidates uncommitted work even before the next HTTP request.
+	owner := func() (authlogin.Owner, error) {
+		current, err := binding.host.CredentialLoginOwner()
+		if err != nil {
+			return current, err
+		}
+		valid := current.Valid
+		current.Valid = func() bool {
+			_, latest := h.credentialLoginSnapshot()
+			return latest == binding && valid != nil && valid()
+		}
+		prepare := current.Prepare
+		current.Prepare = func(ctx context.Context, authID, identity, preparationID string) error {
+			if !current.Valid() {
+				return errors.New("plugin_unavailable")
+			}
+			if err := prepare(ctx, authID, identity, preparationID); err != nil {
+				return err
+			}
+			if !current.Valid() {
+				return errors.New("plugin_unavailable")
+			}
+			return nil
+		}
+		return current, nil
+	}
+	service, err := authlogin.New(authlogin.Options{Dir: filepath.Join(binding.authDir, ".credential-login"), Config: cfg, Manager: binding.manager, Owner: owner, Adopt: h.credentialLoginAdopt})
+	if err != nil {
+		return nil, err
+	}
+	h.credentialLogins = service
+	h.credentialLoginBinding = &binding
+	return service, nil
+}
+func loginError(c *gin.Context, err error) {
+	code := authlogin.SafeCode(err)
+	status := http.StatusConflict
+	switch code {
+	case "invalid_request", "invalid_credentials", "invalid_callback", "invalid_proxy", "proxy_auth_unsupported":
+		status = http.StatusUnprocessableEntity
+	case "not_found":
+		status = http.StatusNotFound
+	case "queue_full", "rate_limited":
+		status = http.StatusTooManyRequests
+	case "plugin_unavailable", "runtime_unavailable", "storage_unavailable", "storage_capacity", "quality_authority_unavailable", "vault_unavailable":
+		status = http.StatusServiceUnavailable
+	}
+	loginJSON(c, status, map[string]any{"code": code, "error": code})
+}
+func loginJSON(c *gin.Context, status int, value any) {
+	raw, err := authlogin.Encode(value)
+	if err != nil {
+		c.Status(http.StatusInternalServerError)
+		return
+	}
+	c.Data(status, "application/json; charset=utf-8", raw)
+}
+
+// CredentialLogins is mounted only under authenticated v8 management routes.
+func (h *Handler) CredentialLogins(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	c.Header("Pragma", "no-cache")
+	c.Header("X-Content-Type-Options", "nosniff")
+	s, err := h.loginService()
+	if err != nil {
+		if c.Request.Method == http.MethodGet && strings.HasSuffix(c.Request.URL.Path, "/capabilities") {
+			loginJSON(c, 200, map[string]any{"available": false, "reason": authlogin.SafeCode(err), "methods": map[string]any{"browser": map[string]any{"available": false}, "password_totp": map[string]any{"available": false}}, "vault": map[string]any{"available": false, "initialized": false}})
+			return
+		}
+		loginError(c, err)
+		return
+	}
+	path := strings.TrimPrefix(c.Request.URL.Path, "/v8/management/credential-logins")
+	if c.Request.Method == http.MethodGet {
+		switch path {
+		case "/capabilities":
+			loginJSON(c, 200, s.Capabilities())
+		case "/targets":
+			loginJSON(c, 200, map[string]any{"items": s.Targets()})
+		case "/jobs":
+			loginJSON(c, 200, map[string]any{"items": s.Jobs()})
+		case "/logs":
+			query, queryErr := url.ParseQuery(c.Request.URL.RawQuery)
+			if queryErr != nil || len(query) != 1 || len(query["id"]) != 1 || query.Get("id") == "" {
+				loginError(c, errors.New("invalid_request"))
+				return
+			}
+			logs, err := s.Logs(query.Get("id"))
+			if err != nil {
+				loginError(c, err)
+			} else {
+				loginJSON(c, 200, logs)
+			}
+		case "/detail":
+			v, e := s.Detail(c.Query("id"))
+			if e != nil {
+				loginError(c, e)
+			} else {
+				loginJSON(c, 200, v)
+			}
+		case "/candidate":
+			v, e := s.Candidate(c.Query("id"))
+			if e != nil {
+				loginError(c, e)
+			} else {
+				loginJSON(c, 200, v)
+			}
+		case "/vault/status":
+			loginJSON(c, 200, s.VaultStatus(c.Query("auth_id")))
+		case "/accounts":
+			items, err := s.Accounts()
+			if err != nil {
+				loginError(c, err)
+			} else {
+				loginJSON(c, 200, map[string]any{"items": items})
+			}
+		case "/accounts/detail":
+			query, queryErr := url.ParseQuery(c.Request.URL.RawQuery)
+			if queryErr != nil || len(query) != 1 || len(query["id"]) != 1 {
+				loginError(c, errors.New("invalid_request"))
+				return
+			}
+			detail, err := s.AccountDetail(c.Query("id"))
+			if err != nil {
+				loginError(c, err)
+			} else {
+				loginJSON(c, 200, detail)
+			}
+		case "/accounts/settings":
+			settings, err := s.AccountSettings()
+			if err != nil {
+				loginError(c, err)
+			} else {
+				loginJSON(c, 200, settings)
+			}
+		default:
+			c.Status(404)
+		}
+		return
+	}
+	if c.Request.URL.RawQuery != "" {
+		loginError(c, errors.New("invalid_request"))
+		return
+	}
+	limit := int64(16 << 10)
+	if path == "/accounts/import" {
+		limit = 512 << 10
+	}
+	raw, err := io.ReadAll(io.LimitReader(c.Request.Body, limit+1))
+	if err != nil || int64(len(raw)) > limit {
+		loginError(c, errors.New("invalid_request"))
+		return
+	}
+	response, err := s.Idempotent(c.GetHeader("Idempotency-Key"), c.Request.Method+path, raw, func() (any, error) {
+		if strings.HasPrefix(path, "/accounts/") {
+			return credentialAccountWrite(s, c.Request.Method, path, raw)
+		}
+		if path == "/start" {
+			r, e := authlogin.DecodeStart(raw)
+			if e != nil {
+				return nil, e
+			}
+			return s.Start(r)
+		}
+		if path == "/vault/entry" {
+			r, e := authlogin.Object(raw, "auth_id", "revision", "credentials")
+			if e != nil {
+				return nil, e
+			}
+			if err := validateLoginFields(r); err != nil {
+				return nil, err
+			}
+			id := r.Get("auth_id").String()
+			revision := r.Get("revision").Uint()
+			if id == "" {
+				return nil, errors.New("invalid_request")
+			}
+			if c.Request.Method == http.MethodDelete {
+				if r.Get("credentials").Exists() {
+					return nil, errors.New("invalid_request")
+				}
+				e = s.DeleteVault(id, revision)
+			} else {
+				credentials, decodeErr := authlogin.DecodeCredentials(r.Get("credentials"))
+				if decodeErr != nil {
+					return nil, decodeErr
+				}
+				e = s.PutVault(id, revision, credentials)
+			}
+			return s.VaultStatus(id), e
+		}
+		allowed := []string{"job_id", "revision"}
+		if path == "/callback" {
+			allowed = append(allowed, "callback_url")
+		}
+		if path == "/commit" {
+			allowed = append(allowed, "candidate_id")
+		}
+		r, e := authlogin.Object(raw, allowed...)
+		if e != nil {
+			return nil, e
+		}
+		if err := validateLoginFields(r); err != nil {
+			return nil, err
+		}
+		id := r.Get("job_id").String()
+		if id == "" {
+			return nil, errors.New("invalid_request")
+		}
+		switch path {
+		case "/callback":
+			return s.Callback(id, r.Get("callback_url").String())
+		case "/cancel":
+			return s.Cancel(id, false)
+		case "/discard":
+			return s.Cancel(id, true)
+		case "/commit":
+			return s.Commit(c.Request.Context(), id, r.Get("candidate_id").String(), r.Get("revision").Uint())
+		default:
+			return nil, errors.New("not_found")
+		}
+	})
+	clear(raw)
+	if err != nil {
+		loginError(c, err)
+		return
+	}
+	c.Data(200, "application/json; charset=utf-8", response)
+}
+
+func validateLoginFields(r ojson.Result) error {
+	valid := true
+	r.ForEach(func(k, v ojson.Result) bool {
+		switch k.String() {
+		case "revision":
+			_, err := strconv.ParseUint(v.Raw, 10, 64)
+			valid = v.Type == ojson.Number && err == nil
+		case "credentials":
+			valid = v.IsObject()
+		default:
+			valid = v.Type == ojson.String && len(v.String()) <= 8192
+		}
+		return valid
+	})
+	if !valid {
+		return errors.New("invalid_request")
+	}
+	return nil
+}
diff --git a/internal/api/handlers/management/credential_logins_test.go b/internal/api/handlers/management/credential_logins_test.go
new file mode 100644
index 0000000..741e953
--- /dev/null
+++ b/internal/api/handlers/management/credential_logins_test.go
@@ -0,0 +1,377 @@
+package management
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/authlogin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/pluginhost"
+	storeauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/auth"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+type unavailableLoginWorker struct{}
+
+func (unavailableLoginWorker) Capabilities() error { return errors.New("runtime_unavailable") }
+func (unavailableLoginWorker) Run(context.Context, authlogin.RuntimeRequest) (string, error) {
+	return "", errors.New("runtime_unavailable")
+}
+func TestCredentialLoginManagementContract(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	t.Setenv("MANAGEMENT_PASSWORD", "offline-management")
+	dir := t.TempDir()
+	authDir := filepath.Join(dir, "auths")
+	if err := os.MkdirAll(authDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	store := storeauth.NewFileTokenStore()
+	store.SetBaseDir(authDir)
+	manager := coreauth.NewManager(store, nil, nil)
+	cfg := &config.Config{AuthDir: authDir}
+	manager.SetConfig(cfg)
+	if err := manager.OpenQualityState(filepath.Join(dir, "authority.db")); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = manager.CloseQualityState() }()
+	s, err := authlogin.New(authlogin.Options{Dir: filepath.Join(authDir, ".credential-login"), Config: cfg, Manager: manager, Runtime: unavailableLoginWorker{}, Owner: func() (authlogin.Owner, error) {
+		return authlogin.Owner{ID: "offline", Valid: func() bool { return true }}, nil
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = s.Close() }()
+	h := NewHandler(cfg, "", manager)
+	h.SetLocalPassword("offline-management")
+	h.credentialLogins = s
+	router := gin.New()
+	g := router.Group("/v8/management/credential-logins", h.Middleware())
+	for _, method := range []string{"GET", "POST", "PUT", "DELETE"} {
+		g.Handle(method, "/*path", h.CredentialLogins)
+	}
+	call := func(method, path, body, key, auth string) *httptest.ResponseRecorder {
+		t.Helper()
+		w := httptest.NewRecorder()
+		r := httptest.NewRequest(method, "/v8/management/credential-logins"+path, strings.NewReader(body))
+		r.RemoteAddr = "127.0.0.1:12345"
+		if auth != "" {
+			r.Header.Set("Authorization", "Bearer "+auth)
+		}
+		if key != "" {
+			r.Header.Set("Idempotency-Key", key)
+		}
+		r.Header.Set("Content-Type", "application/json")
+		router.ServeHTTP(w, r)
+		return w
+	}
+	if got := call("GET", "/capabilities", "", "", ""); got.Code != http.StatusUnauthorized {
+		t.Fatalf("unprotected capability: %d", got.Code)
+	}
+	caps := call("GET", "/capabilities", "", "", "offline-management")
+	if caps.Code != 200 || !ojson.GetBytes(caps.Body.Bytes(), "methods.browser.available").Bool() || ojson.GetBytes(caps.Body.Bytes(), "methods.password_totp.available").Bool() {
+		t.Fatalf("invalid capabilities: %d %s", caps.Code, caps.Body.String())
+	}
+	if caps.Header().Get("Cache-Control") != "no-store" {
+		t.Fatal("cache permitted")
+	}
+	body := `{"consumer_plugin":"model-quality","method":"browser","intent":"import"}`
+	if got := call("POST", "/start", body, "", "offline-management"); got.Code != 422 {
+		t.Fatal("missing idempotency key accepted")
+	}
