+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/httptransport"
+	bolt "go.etcd.io/bbolt"
+)
+
+// QualityPause is an owned, durable credential-wide admission restriction.
+type QualityPause struct {
+	AuthID          string    `json:"auth_id"`
+	OwnerPlugin     string    `json:"owner_plugin"`
+	RuleID          string    `json:"rule_id"`
+	RuleRevision    uint64    `json:"rule_revision"`
+	ActionID        string    `json:"action_id"`
+	ActionRevision  uint64    `json:"action_revision"`
+	EvidenceRunID   string    `json:"evidence_run_id"`
+	IdentityVersion string    `json:"identity_version"`
+	Reason          string    `json:"reason"`
+	CreatedAt       time.Time `json:"created_at"`
+}
+
+// QualityTarget deliberately excludes credential material and source paths.
+type QualityTarget struct {
+	AuthID             string         `json:"auth_id"`
+	AuthIndex          string         `json:"auth_index"`
+	Provider           string         `json:"provider"`
+	Kind               string         `json:"kind"`
+	IdentityVersion    string         `json:"identity_version"`
+	ComparisonIdentity string         `json:"comparison_identity"`
+	OperatorDisabled   bool           `json:"operator_disabled"`
+	NativeDisabled     bool           `json:"native_disabled"`
+	QualityPaused      bool           `json:"quality_paused"`
+	EffectiveAvailable bool           `json:"effective_available"`
+	UnavailableReasons []string       `json:"unavailable_reasons"`
+	CanPause           bool           `json:"can_pause"`
+	CanRetest          bool           `json:"can_retest"`
+	UnsupportedReason  string         `json:"unsupported_reason,omitempty"`
+	Pauses             []QualityPause `json:"pauses"`
+}
+
+type qualityIdentity struct {
+	Version, Grant string
+	Deleted        bool
+}
+type qualityState struct {
+	mu         sync.RWMutex
+	db         *bolt.DB
+	path       string
+	identities map[string]qualityIdentity
+	actions    map[string]QualityPause
+	retired    map[string]QualityPause
+	closed     bool
+	fault      error
+}
+
+var qualityBucket = []byte("quality-v1")
+
+// OpenQualityState loads restrictions before any credential is admitted. Failure is fatal to startup.
+func (m *Manager) OpenQualityState(path string) error {
+	if m == nil || strings.TrimSpace(path) == "" {
+		return errors.New("quality state path required")
+	}
+	if m.quality.Load() != nil {
+		return errors.New("quality state already open")
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return fmt.Errorf("quality directory: %w", err)
+	}
+	db, err := bolt.Open(path, 0600, &bolt.Options{Timeout: time.Second})
+	if err != nil {
+		return fmt.Errorf("open quality authority: %w", err)
+	}
+	q := &qualityState{db: db, path: path, identities: map[string]qualityIdentity{}, actions: map[string]QualityPause{}}
+	err = db.Update(func(tx *bolt.Tx) error {
+		b, e := tx.CreateBucketIfNotExists(qualityBucket)
+		if e != nil {
+			return e
+		}
+		if v := b.Get([]byte("state")); v != nil {
+			var state struct {
+				Identities map[string]qualityIdentity
+				Actions    map[string]QualityPause
+				Retired    map[string]QualityPause
+			}
+			if e = gob.NewDecoder(bytes.NewReader(v)).Decode(&state); e != nil {
+				return e
+			}
+			q.identities = state.Identities
+			q.actions = state.Actions
+			q.retired = state.Retired
+		}
+		return nil
+	})
+	if err != nil {
+		return errors.Join(fmt.Errorf("load quality authority: %w", err), db.Close())
+	}
+	if q.identities == nil {
+		q.identities = map[string]qualityIdentity{}
+	}
+	if q.actions == nil {
+		q.actions = map[string]QualityPause{}
+	}
+	if q.retired == nil {
+		q.retired = map[string]QualityPause{}
+	}
+	if !m.quality.CompareAndSwap(nil, q) {
+		return errors.Join(errors.New("quality state already open"), db.Close())
+	}
+	for _, a := range m.List() {
+		if err = m.qualitySyncIdentity(a, false, false); err != nil {
+			return errors.Join(err, m.CloseQualityState())
+		}
+	}
+	return nil
+}
+
+// CloseQualityState retains the restrictions and fails admission closed after shutdown.
+func (m *Manager) CloseQualityState() error {
+	q := m.quality.Load()
+	if q == nil {
+		return nil
+	}
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	if q.closed {
+		return nil
+	}
+	q.closed = true
+	return q.db.Close()
+}
+func (q *qualityState) saveLocked() error {
+	if q.closed {
+		return errors.New("quality authority closed")
+	}
+	var buf bytes.Buffer
+	if err := gob.NewEncoder(&buf).Encode(struct {
+		Identities map[string]qualityIdentity
+		Actions    map[string]QualityPause
+		Retired    map[string]QualityPause
+	}{q.identities, q.actions, q.retired}); err != nil {
+		return err
+	}
+	return q.db.Update(func(tx *bolt.Tx) error { return tx.Bucket(qualityBucket).Put([]byte("state"), buf.Bytes()) })
+}
+
+// qualitySyncIdentity is called under the credential mutation gate before publication.
+// Refresh updates the grant fingerprint while retaining the durable incarnation.
+func (m *Manager) qualitySyncIdentity(a *Auth, refresh, replaced bool) error {
+	q := m.quality.Load()
+	if q == nil || a == nil {
+		return nil
+	}
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	if q.closed || q.fault != nil {
+		return errors.New("quality authority unavailable")
+	}
+	old, exists := q.identities[a.ID]
+	next := old
+	grant := a.Provider + ":" + AuthGrantFingerprint(a)
+	if !exists || old.Deleted || replaced || (!refresh && old.Grant != grant) {
+		next.Version = uuid.NewString()
+	}
+	next.Grant = grant
+	next.Deleted = false
+	if old == next {
+		return nil
+	}
+	q.identities[a.ID] = next
+	if err := q.saveLocked(); err != nil {
+		q.identities[a.ID] = old
+		q.fault = err
+		return fmt.Errorf("persist quality identity: %w", err)
+	}
+	return nil
+}
+func (m *Manager) qualityDeleteIdentity(id string) error {
+	q := m.quality.Load()
+	if q == nil {
+		return nil
+	}
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	old := q.identities[id]
+	next := old
+	next.Deleted = true
+	q.identities[id] = next
+	if err := q.saveLocked(); err != nil {
+		q.identities[id] = old
+		q.fault = err
+		return fmt.Errorf("persist quality tombstone: %w", err)
+	}
+	return nil
+}
+
+// QualityTargets includes runtime-only and paused credentials instead of inferring deletion from filtered lists.
+func (m *Manager) QualityTargets() []QualityTarget {
+	out := []QualityTarget{}
+	for _, a := range m.List() {
+		if t, e := m.QualityTarget(a.ID); e == nil {
+			out = append(out, t)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].AuthID < out[j].AuthID })
+	return out
+}
+func (m *Manager) QualityTarget(id string) (QualityTarget, error) {
+	a, ok := m.GetByID(id)
+	if !ok || a == nil {
+		return QualityTarget{}, errors.New("credential_deleted")
+	}
+	t := QualityTarget{ComparisonIdentity: qualityComparisonIdentity(a), AuthID: a.ID, AuthIndex: a.Index, Provider: a.Provider, Kind: a.AuthKind(), OperatorDisabled: qualityOperatorDisabled(a), NativeDisabled: a.Disabled || a.Status == StatusDisabled, Pauses: []QualityPause{}, UnavailableReasons: []string{}}
+	q := m.quality.Load()
+	if m.HomeEnabled() {
+		t.UnsupportedReason = "home_controlled"
+	} else if q == nil {
+		t.UnsupportedReason = "quality_authority_unavailable"
+	} else {
+		q.mu.RLock()
+		identity := q.identities[id]
+		t.IdentityVersion = identity.Version
+		t.CanPause = !q.closed && q.fault == nil && identity.Version != "" && !identity.Deleted
+		t.CanRetest = false
+		for _, p := range q.actions {
+			if p.AuthID == id {
+				t.Pauses = append(t.Pauses, p)
+			}
+		}
+		q.mu.RUnlock()
+		if !t.CanPause {
+			t.UnsupportedReason = "quality_identity_unavailable"
+		}
+	}
+	if t.OperatorDisabled {
+		t.UnavailableReasons = append(t.UnavailableReasons, "operator_disabled")
+	}
+	if a.RequiresSignIn {
+		t.UnavailableReasons = append(t.UnavailableReasons, "requires_sign_in")
+	}
+	if a.Unavailable || a.NextRetryAfter.After(time.Now()) {
+		t.UnavailableReasons = append(t.UnavailableReasons, "native_unavailable")
+	}
+	if !qualityHasIdentityMaterial(a) {
+		t.CanPause = false
+		t.CanRetest = false
+		t.UnsupportedReason = "stable_credential_identity_unavailable"
+	}
+	t.QualityPaused = len(t.Pauses) > 0
+	if t.QualityPaused {
+		t.UnavailableReasons = append(t.UnavailableReasons, "quality_pause")
+	}
+	t.EffectiveAvailable = len(t.UnavailableReasons) == 0
+	return t, nil
+}
+func (m *Manager) QualityActions() []QualityPause {
+	out := []QualityPause{}
+	q := m.quality.Load()
+	if q == nil {
+		return out
+	}
+	q.mu.RLock()
+	defer q.mu.RUnlock()
+	for _, p := range q.actions {
+		out = append(out, p)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].ActionID < out[j].ActionID })
+	return out
+}
+func qualityBindingMatches(a, b QualityPause) bool {
+	return a.AuthID == b.AuthID && a.OwnerPlugin == b.OwnerPlugin && a.RuleID == b.RuleID && a.RuleRevision == b.RuleRevision && a.ActionID == b.ActionID && a.ActionRevision == b.ActionRevision && a.IdentityVersion == b.IdentityVersion
+}
+
+// PauseQuality commits an idempotent restriction without changing operator disable or native cooldown.
+func (m *Manager) PauseQuality(ctx context.Context, owner string, p QualityPause) (QualityPause, error) {
+	if m.HomeEnabled() {
+		return QualityPause{}, errors.New("home_controlled")
+	}
+	if owner == "" || p.OwnerPlugin != owner || p.AuthID == "" || p.RuleID == "" || p.RuleRevision == 0 || p.ActionID == "" || p.ActionRevision != 1 || p.EvidenceRunID == "" || p.IdentityVersion == "" || len(p.Reason) > 1024 {
+		return QualityPause{}, errors.New("invalid_quality_action")
+	}
+	release, err := m.lockAuthMutationContext(ctx, p.AuthID)
+	if err != nil {
+		return QualityPause{}, err
+	}
+	defer release()
+	a, ok := m.GetByID(p.AuthID)
+	if !ok {
+		return QualityPause{}, errors.New("credential_deleted")
+	}
+	if qualityOperatorDisabled(a) {
+		return QualityPause{}, errors.New("operator_disabled")
+	}
+	if a.RequiresSignIn {
+		return QualityPause{}, errors.New("requires_sign_in")
+	}
+	if !qualityHasIdentityMaterial(a) {
+		return QualityPause{}, errors.New("stable_credential_identity_unavailable")
+	}
+	q := m.quality.Load()
+	if q == nil {
+		return QualityPause{}, errors.New("quality_authority_unavailable")
+	}
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	if q.closed || q.fault != nil {
+		return QualityPause{}, errors.New("quality_authority_unavailable")
+	}
+	identity := q.identities[p.AuthID]
+	if identity.Deleted || identity.Version != p.IdentityVersion {
+		return QualityPause{}, errors.New("identity_conflict")
+	}
+	if _, retired := q.retired[p.ActionID]; retired {
+		return QualityPause{}, errors.New("action_already_released")
+	}
+	if old, exists := q.actions[p.ActionID]; exists {
+		if qualityBindingMatches(old, p) && old.EvidenceRunID == p.EvidenceRunID {
+			return old, nil
+		}
+		return QualityPause{}, errors.New("action_conflict")
+	}
+	for _, old := range q.actions {
+		if old.AuthID == p.AuthID && old.OwnerPlugin == owner && old.RuleID == p.RuleID {
+			return QualityPause{}, errors.New("rule_already_owns_pause")
+		}
+	}
+	p.CreatedAt = time.Now().UTC()
+	q.actions[p.ActionID] = p
+	if err = q.saveLocked(); err != nil {
+		delete(q.actions, p.ActionID)
+		return QualityPause{}, fmt.Errorf("persist quality pause: %w", err)
+	}
+	return p, nil
+}
+
+// ReleaseQuality releases exactly the supplied ownership revision. It never enables a credential.
+func (m *Manager) ReleaseQuality(ctx context.Context, owner string, p QualityPause) (QualityTarget, error) {
+	return m.releaseQuality(ctx, owner, p, false)
+}
+
+// ReleaseQualityAdministratively permits an authenticated operator to release an orphaned or replaced identity, with exact ownership CAS.
+func (m *Manager) ReleaseQualityAdministratively(ctx context.Context, p QualityPause) (QualityTarget, error) {
+	return m.releaseQuality(ctx, p.OwnerPlugin, p, true)
+}
+func (m *Manager) releaseQuality(ctx context.Context, owner string, p QualityPause, administrative bool) (QualityTarget, error) {
+	if m.HomeEnabled() {
+		return QualityTarget{}, errors.New("home_controlled")
+	}
+	release, err := m.lockAuthMutationContext(ctx, p.AuthID)
+	if err != nil {
+		return QualityTarget{}, err
+	}
+	defer release()
+	q := m.quality.Load()
+	if q == nil {
+		return QualityTarget{}, errors.New("quality_authority_unavailable")
+	}
+	q.mu.Lock()
+	if q.closed || q.fault != nil {
+		q.mu.Unlock()
+		return QualityTarget{}, errors.New("quality_authority_unavailable")
+	}
+	old, ok := q.actions[p.ActionID]
+	if !ok {
+		retired, released := q.retired[p.ActionID]
+		q.mu.Unlock()
+		if !released || retired.OwnerPlugin != owner || !qualityBindingMatches(retired, p) {
+			return QualityTarget{}, errors.New("action_conflict")
+		}
+		target, err := m.QualityTarget(p.AuthID)
+		if administrative && err != nil {
+			return QualityTarget{AuthID: p.AuthID, UnavailableReasons: []string{"credential_deleted"}}, nil
+		}
+		return target, err
+	}
+	if old.OwnerPlugin != owner || !qualityBindingMatches(old, p) {
+		q.mu.Unlock()
+		return QualityTarget{}, errors.New("action_conflict")
+	}
+	if !administrative && (q.identities[p.AuthID].Deleted || q.identities[p.AuthID].Version != p.IdentityVersion) {
+		q.mu.Unlock()
+		return QualityTarget{}, errors.New("identity_conflict")
+	}
+	delete(q.actions, p.ActionID)
+	q.retired[p.ActionID] = old
+	if err = q.saveLocked(); err != nil {
+		q.actions[p.ActionID] = old
+		delete(q.retired, p.ActionID)
+		q.mu.Unlock()
+		return QualityTarget{}, fmt.Errorf("persist quality release: %w", err)
+	}
+	q.mu.Unlock()
+	target, errTarget := m.QualityTarget(p.AuthID)
+	if administrative && errTarget != nil {
+		return QualityTarget{AuthID: p.AuthID, UnavailableReasons: []string{"credential_deleted"}}, nil
+	}
+	return target, errTarget
+}
+
+// QualityRetestContext rejects the removed bypass contract, including calls from older plugins.
+// Deprecated: paused credentials require an explicit manual release before any execution.
+func (m *Manager) QualityRetestContext(context.Context, string, string, QualityPause) (context.Context, error) {
+	return nil, errors.New("quality_retest_disabled_manual_release_required")
+}
+func (m *Manager) qualityBlocked(ctx context.Context, id string) bool {
+	q := m.quality.Load()
+	if q == nil {
+		return false
+	}
+	q.mu.RLock()
+	defer q.mu.RUnlock()
+	if q.closed || q.fault != nil {
+		return true
+	}
+	for _, p := range q.actions {
+		if p.AuthID == id {
+			return true
+		}
+	}
+	return false
+}
+func (m *Manager) checkQualityAdmission(ctx context.Context, id, model string) error {
+	if m.quality.Load() == nil {
+		return nil
+	}
+	a, ok := m.GetByID(id)
+	if !ok {
+		return &Error{Code: ErrorCodeRequestScoped, Message: "credential_deleted", HTTPStatus: 409}
+	}
+	if m.qualityBlocked(ctx, id) {
+		return &Error{Code: ErrorCodeRequestScoped, Message: "quality_pause", HTTPStatus: 409}
+	}
+	if qualityOperatorDisabled(a) || a.RequiresSignIn {
+		return &Error{Code: ErrorCodeRequestScoped, Message: "credential_blocked", HTTPStatus: 409}
+	}
+	return nil
+}
+func (m *Manager) qualityExecute(ctx context.Context, e ProviderExecutor, a *Auth, r cliproxyexecutor.Request, o cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	if err := m.checkQualityAdmission(ctx, a.ID, r.Model); err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	return e.Execute(m.qualityExecutionContext(ctx, a.ID, r.Model), a, r, o)
+}
+func (m *Manager) qualityExecuteStream(ctx context.Context, e ProviderExecutor, a *Auth, r cliproxyexecutor.Request, o cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	if err := m.checkQualityAdmission(ctx, a.ID, r.Model); err != nil {
+		return nil, err
+	}
+	return e.ExecuteStream(m.qualityExecutionContext(ctx, a.ID, r.Model), a, r, o)
+}
+func (m *Manager) qualityCountTokens(ctx context.Context, e ProviderExecutor, a *Auth, r cliproxyexecutor.Request, o cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	if err := m.checkQualityAdmission(ctx, a.ID, r.Model); err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	return e.CountTokens(m.qualityExecutionContext(ctx, a.ID, r.Model), a, r, o)
+}
+
+// QualityBusinessAllowed is used for new duplex WebSocket turns on an already open transport.
+func (m *Manager) QualityBusinessAllowed(authID string) bool {
+	return !m.qualityBlocked(context.Background(), authID)
+}
+
+func qualityHasIdentityMaterial(a *Auth) bool {
+	if a == nil {
+		return false
+	}
+	if authAccessToken(a) != "" || authOuterAccessToken(a) != "" || authRefreshToken(a) != "" {
+		return true
+	}
+	for _, key := range []string{"api_key", "session_token"} {
+		if strings.TrimSpace(a.Attributes[key]) != "" || authMetadataString(a, key) != "" {
+			return true
+		}
+	}
+	return false
+}
+
+// qualityExcluded keeps scheduler caches intact and excludes restrictions per operation.
+func (m *Manager) qualityExcluded(ctx context.Context, tried map[string]struct{}) map[string]struct{} {
+	q := m.quality.Load()
+	if q == nil {
+		return tried
+	}
+	q.mu.RLock()
+	unavailable := q.closed || q.fault != nil
+	ids := make([]string, 0, len(q.actions))
+	for _, p := range q.actions {
+		ids = append(ids, p.AuthID)
+	}
+	q.mu.RUnlock()
+	if unavailable {
+		for _, a := range m.List() {
+			ids = append(ids, a.ID)
+		}
+	}
+	if len(ids) == 0 {
+		return tried
+	}
+	result := make(map[string]struct{}, len(tried)+len(ids))
+	for id := range tried {
+		result[id] = struct{}{}
+	}
+	for _, id := range ids {
+		if m.qualityBlocked(ctx, id) {
+			result[id] = struct{}{}
+		}
+	}
+	return result
+}
+
+// ReleaseQualityVerified rejects automatic recovery retained only for source and wire compatibility.
+// Deprecated: use an explicit authenticated manual release.
+func (m *Manager) ReleaseQualityVerified(context.Context, string, QualityPause, []string) (QualityTarget, error) {
+	return QualityTarget{}, errors.New("automatic_recovery_disabled_manual_release_required")
+}
+
+// QualityActionStatus reconciles a durable action intent without replaying a released action.
+func (m *Manager) QualityActionStatus(owner, actionID string) (string, *QualityPause, error) {
+	q := m.quality.Load()
+	if q == nil {
+		return "", nil, errors.New("quality_authority_unavailable")
+	}
+	q.mu.RLock()
+	defer q.mu.RUnlock()
+	if q.closed || q.fault != nil {
+		return "", nil, errors.New("quality_authority_unavailable")
+	}
+	p, exists := q.actions[actionID]
+	status := "active"
+	if !exists {
+		p, exists = q.retired[actionID]
+		status = "released"
+	}
+	if !exists {
+		return "absent", nil, nil
+	}
+	if p.OwnerPlugin != owner {
+		return "", nil, errors.New("action_owner_conflict")
+	}
+	return status, &p, nil
+}
+func qualityComparisonIdentity(a *Auth) string {
+	if !qualityHasIdentityMaterial(a) {
+		return ""
+	}
+	material := ""
+	for _, key := range []string{"account_id", "email"} {
+		if value := authMetadataString(a, key); value != "" {
+			material = key + ":" + value
+			break
+		}
+		if value := strings.TrimSpace(a.Attributes[key]); value != "" {
+			material = key + ":" + value
+			break
+		}
+	}
+	if material == "" {
+		for _, key := range []string{"api_key", "session_token"} {
+			if value := strings.TrimSpace(a.Attributes[key]); value != "" {
+				material = key + ":" + value
+				break
+			}
+			if value := authMetadataString(a, key); value != "" {
+				material = key + ":" + value
+				break
+			}
+		}
+	}
+	if material == "" {
+		material = "refresh:" + authRefreshToken(a)
+	}
+	if material == "refresh:" {
+		material = "access:" + authOuterAccessToken(a)
+		if material == "access:" {
+			material = "access:" + authAccessToken(a)
+		}
+	}
+	// Provider names are routing labels and cannot establish independent controls.
+	digest := sha256.Sum256([]byte(material))
+	return hex.EncodeToString(digest[:])
+}
+
+func (m *Manager) qualityExecutionContext(ctx context.Context, authID, model string) context.Context {
+	if m.quality.Load() == nil {
+		return ctx
+	}
+	return httptransport.WithAdmission(ctx, func() error { return m.checkQualityAdmission(ctx, authID, model) })
+}
+
+func qualityOperatorDisabled(a *Auth) bool {
+	if a == nil {
+		return true
+	}
+	if a.Disabled || a.Status == StatusDisabled {
+		return true
+	}
+	for _, pattern := range strings.Split(a.Attributes["excluded_models"], ",") {
+		if strings.TrimSpace(pattern) == "*" {
+			return true
+		}
+	}
+	return false
+}
