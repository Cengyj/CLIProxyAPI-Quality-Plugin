@@ -0,0 +1,58 @@
+package auth
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// IsReservedAuthPath reports whether a path enters private login storage. Auth
+// discovery and ordinary credential file operations must never access it.
+// Existing symlinks and ancestors are checked even when the leaf is absent.
+func IsReservedAuthPath(path string) bool {
+	return isReservedAuthPath(path, 0)
+}
+
+func isReservedAuthPath(path string, depth int) bool {
+	if depth >= 40 {
+		return true
+	}
+	path = strings.TrimSpace(path)
+	if path == "" {
+		return false
+	}
+	if hasReservedAuthComponent(path) {
+		return true
+	}
+	if absolute, errAbs := filepath.Abs(path); errAbs == nil {
+		path = absolute
+	}
+	for current := filepath.Clean(path); ; current = filepath.Dir(current) {
+		if hasReservedAuthComponent(current) {
+			return true
+		}
+		if resolved, errResolve := filepath.EvalSymlinks(current); errResolve == nil && hasReservedAuthComponent(resolved) {
+			return true
+		}
+		if target, errLink := os.Readlink(current); errLink == nil {
+			if !filepath.IsAbs(target) {
+				target = filepath.Join(filepath.Dir(current), target)
+			}
+			if isReservedAuthPath(target, depth+1) {
+				return true
+			}
+		}
+		if parent := filepath.Dir(current); parent == current {
+			return false
+		}
+	}
+}
+
+func hasReservedAuthComponent(path string) bool {
+	for _, part := range strings.FieldsFunc(path, func(r rune) bool { return r == '/' || r == '\\' }) {
+		if strings.EqualFold(part, ".credential-login") {
+			return true
+		}
+	}
+	return false
+}
