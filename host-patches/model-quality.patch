+func TestBrowserVerificationDiagnosticsReachJobLogs(t *testing.T) {
+	for _, scenario := range []struct {
+		name, runtimeCode, hostCode, status string
+	}{
+		{"browser_verification_timeout", "timeout", "runtime_timeout", "failed"},
+		{"browser_verification_required", "interaction_required", "interaction_required", "interaction_required"},
+		{"human_verification", "interaction_required", "interaction_required", "interaction_required"},
+	} {
+		t.Run(scenario.name, func(t *testing.T) {
+			raw, err := Encode(map[string]any{"version": 1, "job_id": "fixture", "attempt": 1, "error_code": scenario.runtimeCode, "error_stage": "browser_verification", "error_reason": scenario.name})
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, diagnostic := runtimeResponse(raw, runtimeTestRequest(), errors.New("exit status 1"))
+			if diagnostic == nil || diagnostic.Error() != scenario.hostCode {
+				t.Fatalf("unexpected mapped diagnostic: %v", diagnostic)
+			}
+			opts := offlineOptions(t)
+			opts.Runtime = offlineProgressRuntime{run: func(_ context.Context, _ RuntimeRequest, report func(string) error) (string, error) {
+				if err := report("browser_verification"); err != nil {
+					return "", err
+				}
+				return "", diagnostic
+			}}
+			s := offlineService(t, opts)
+			job, err := s.Start(offlineStart())
+			if err != nil {
+				t.Fatal(err)
+			}
+			waitLogin(t, s, job.ID, scenario.status)
+			detail, err := s.Detail(job.ID)
+			if err != nil || detail.ErrorCode != scenario.hostCode || detail.ErrorStage != "browser_verification" || detail.ErrorReason != scenario.name {
+				t.Fatalf("job lost the verification diagnosis: %+v %v", detail, err)
+			}
+			logs, err := s.Logs(job.ID)
+			if err != nil || len(logs.Entries) == 0 {
+				t.Fatalf("missing job logs: %v", err)
+			}
+			last := logs.Entries[len(logs.Entries)-1]
+			if last.Status != scenario.status || last.ErrorCode != scenario.hostCode || last.ErrorStage != "browser_verification" || last.ErrorReason != scenario.name {
+				t.Fatalf("persisted log lost the verification diagnosis: %+v", last)
+			}
+		})
+	}
+}
