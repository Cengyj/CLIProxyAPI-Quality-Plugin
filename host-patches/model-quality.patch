+const progressSession = `{"version":1,"type":"progress","job_id":"fixture","attempt":1,"phase":"session"}`
+const progressSuccess = `{"version":1,"job_id":"fixture","attempt":1,"callback_url":"http://localhost:1455/auth/callback?code=fixture-code&state=fixture-state"}`
+
+func TestRuntimeProgressStreamingAndLegacyCompatibility(t *testing.T) {
+	var phases []string
+	stream := &runtimeProgressOutput{failed: make(chan error, 1), request: runtimeTestRequest(), progress: func(phase string) error {
+		phases = append(phases, phase)
+		return nil
+	}}
+	defer stream.clear()
+	_, _ = stream.Write([]byte(progressSession[:25]))
+	if len(phases) != 0 {
+		t.Fatal("partial progress was published")
+	}
+	_, _ = stream.Write([]byte(progressSession[25:] + "\n"))
+	if !reflect.DeepEqual(phases, []string{"session"}) {
+		t.Fatal("complete progress was not published before the final response")
+	}
+	_, _ = stream.Write([]byte(strings.ReplaceAll(progressSession, `"session"`, `"totp"`) + "\r\n" + progressSuccess))
+	final, err := stream.finish()
+	if err != nil || string(final) != progressSuccess || !reflect.DeepEqual(phases, []string{"session", "totp"}) {
+		t.Fatalf("invalid fragmented stream: %v %v", phases, err)
+	}
+	callback, err := runtimeResponse(final, runtimeTestRequest(), nil)
+	if err != nil || !strings.Contains(callback, "fixture-code") {
+		t.Fatal("valid final callback was not validated")
+	}
+	r := runtimeProgressFixture(t, "cat >/dev/null\nprintf '%s\\n' '"+progressSession+"' '"+progressSuccess+"'\n")
+	phases = nil
+	callback, err = r.RunWithProgress(context.Background(), runtimeTestRequest(), func(phase string) error { phases = append(phases, phase); return nil })
+	if err != nil || !strings.Contains(callback, "fixture-code") || !reflect.DeepEqual(phases, []string{"session"}) {
+		t.Fatalf("real worker stream failed: %v %v", phases, err)
+	}
+	legacy, _ := runtimeFixture(t, "cat >/dev/null\nprintf '%s\\n' '{' '\"version\":1,' '\"error_code\":\"password_rejected\"' '}'\nexit 1\n")
+	_, err = legacy.RunWithProgress(context.Background(), runtimeTestRequest(), func(string) error { t.Fatal("legacy output emitted progress"); return nil })
+	if err == nil || err.Error() != "credentials_rejected" {
+		t.Fatalf("legacy single JSON compatibility changed: %v", err)
+	}
+}
+
+func TestRuntimeProgressRejectsMalformedAndExcessiveOutput(t *testing.T) {
+	for _, scenario := range []struct{ name, output string }{
+		{"wrong_job", strings.ReplaceAll(progressSession, `"fixture"`, `"other"`)},
+		{"wrong_attempt", strings.ReplaceAll(progressSession, `"attempt":1`, `"attempt":2`)},
+		{"fractional_attempt", strings.ReplaceAll(progressSession, `"attempt":1`, `"attempt":1.1`)},
+		{"unknown_phase", strings.ReplaceAll(progressSession, `"session"`, `"private-password"`)},
+		{"unknown_field", strings.ReplaceAll(progressSession, `"phase":"session"`, `"phase":"session","password":"private-password"`)},
+		{"duplicate_field", strings.ReplaceAll(progressSession, `"phase":"session"`, `"phase":"session","phase":"totp"`)},
+		{"terminal_with_phase", strings.ReplaceAll(progressSuccess, `"attempt":1`, `"attempt":1,"phase":"session"`)},
+		{"wrong_terminal_identity", strings.ReplaceAll(progressSuccess, `"fixture"`, `"other"`)},
+		{"duplicate_final", progressSuccess + "\n" + progressSuccess},
+		{"progress_after_final", progressSuccess + "\n" + progressSession},
+		{"missing_final", progressSession + "\n"},
+		{"progress_limit", strings.Repeat(progressSession+"\n", runtimeProgressLimit+1)},
+		{"line_limit", strings.Repeat(" ", runtimeOutputLimit+1)},
+		{"total_limit", strings.Repeat("\n", runtimeStreamLimit+1)},
+	} {
