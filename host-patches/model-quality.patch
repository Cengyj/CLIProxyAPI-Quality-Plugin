+func TestLoginHealthClassifiesOnlyObservedAuthenticationFailures(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		mutate func(*Auth)
+		status string
+		need   bool
+		auto   bool
+	}{
+		{"unknown", func(a *Auth) {}, "unknown", false, false},
+		{"sign_in", func(a *Auth) { a.RequiresSignIn = true }, "needs_reauth", true, true},
+		{"terminal_unauthorized", func(a *Auth) {
+			a.Status, a.Unavailable = StatusError, true
+			a.LastError = &Error{Code: "unauthorized", HTTPStatus: 401, Message: "secret must not appear"}
+		}, "needs_reauth", true, true},
+		{"invalid_grant", func(a *Auth) {
+			a.Status, a.Unavailable = StatusError, true
+			a.LastError = &Error{Code: "invalid_grant", HTTPStatus: 400}
+			a.RefreshError = cloneError(a.LastError)
+		}, "needs_reauth", true, true},
+		{"model_invalid_grant", func(a *Auth) {
+			a.Status, a.Unavailable = StatusError, true
+			a.LastError = &Error{Code: "invalid_grant", HTTPStatus: 400}
+			a.ModelStates = map[string]*ModelState{"model": {LastError: cloneError(a.LastError)}}
+		}, "unavailable", false, false},
+		{"plain_401_awaits_native_refresh", func(a *Auth) {
+			a.LastError = &Error{Code: "unauthorized", HTTPStatus: 401}
+			a.NextRefreshAfter = time.Now().Add(time.Hour)
+		}, "refresh_pending", false, false},
+		{"model_401_is_not_account_failure", func(a *Auth) {
+			a.LastError = &Error{Code: "unauthorized", HTTPStatus: 401}
+			a.ModelStates = map[string]*ModelState{"model": {LastError: cloneError(a.LastError)}}
+		}, "unknown", false, false},
+		{"forbidden", func(a *Auth) {
+			a.Status, a.Unavailable = StatusError, true
+			a.LastError = &Error{Code: "forbidden", HTTPStatus: 403}
+		}, "unavailable", false, false},
+		{"request_scope_401", func(a *Auth) {
+			a.Status, a.Unavailable = StatusError, true
+			a.LastError = &Error{Code: ErrorCodeRequestScoped, HTTPStatus: 401}
+		}, "unavailable", false, false},
+		{"rate_limit", func(a *Auth) {
+			a.LastError = &Error{Code: "rate_limit_exceeded", HTTPStatus: 429}
+			a.Quota = QuotaState{Exceeded: true, NextRecoverAt: time.Now().Add(time.Hour)}
+		}, "cooldown", false, false},
+		{"network", func(a *Auth) {
+			a.Status, a.Unavailable = StatusError, true
+			a.LastError = &Error{Code: "network_error", HTTPStatus: 502}
+		}, "unavailable", false, false},
+		{"manual_disable", func(a *Auth) { a.Disabled = true }, "disabled", false, false},
+		{"disabled_sign_in", func(a *Auth) { a.Disabled, a.RequiresSignIn = true, true }, "disabled", true, false},
+		{"cooldown_sign_in", func(a *Auth) {
+			a.RequiresSignIn = true
+			a.NextRetryAfter = time.Now().Add(time.Hour)
+		}, "cooldown", true, false},
+		{"pending_native_refresh", func(a *Auth) {
+			a.RequiresSignIn = true
+			a.NextRefreshAfter = time.Now().Add(time.Hour)
+		}, "refresh_pending", true, false},
+		{"unknown_exchange", func(a *Auth) {
+			a.RequiresSignIn = true
+			a.RefreshError = &Error{Code: "refresh_outcome_unknown"}
+		}, "needs_reauth", true, false},
+		{"siwc_failure", func(a *Auth) {
+			a.RequiresSignIn = true
+			a.RejectedSIWCRefreshToken = "private nested token"
+		}, "needs_reauth", true, false},
