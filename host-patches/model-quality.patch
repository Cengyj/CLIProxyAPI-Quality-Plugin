+			return runtimeError("runtime_invalid")
+		}
+		if entry.IsDir() {
+			stat, errInfo := entry.Info()
+			if errInfo != nil || stat.Mode().Perm()&0022 != 0 {
+				return runtimeError("runtime_invalid")
+			}
+			return nil
+		}
