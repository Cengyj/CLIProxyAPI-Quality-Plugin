diff --git a/internal/runtime/executor/quality_admission_test.go b/internal/runtime/executor/quality_admission_test.go
new file mode 100644
index 0000000..8bdaef6
--- /dev/null
+++ b/internal/runtime/executor/quality_admission_test.go
@@ -0,0 +1,25 @@
+package executor
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/httptransport"
+)
+
+func TestQualityAdmissionRecheckedBeforeWebsocketPayloadWrite(t *testing.T) {
+	denied := errors.New("quality pause committed during request preparation")
+	ctx := httptransport.WithAdmission(context.Background(), func() error { return denied })
+	// A connection without a transport must never be used when admission is denied.
+	conn := &websocket.Conn{}
+	for _, session := range []*codexWebsocketSession{nil, {sessionID: "retained-session"}} {
+		if err := writeCodexWebsocketMessage(session, conn, []byte(`{"type":"response.create"}`), ctx); !errors.Is(err, denied) {
+			t.Fatalf("Codex write bypassed admission: %v", err)
+		}
+		if err := writeWebsocketPayloadMessage("xai", session, conn, []byte(`{"type":"response.create"}`), ctx); !errors.Is(err, denied) {
+			t.Fatalf("xAI write bypassed admission: %v", err)
+		}
+	}
+}
