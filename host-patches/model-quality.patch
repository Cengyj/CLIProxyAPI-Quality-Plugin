+func TestReservedLoginSymlinkReplacementDropsCachedIdentity(t *testing.T) {
+	dir, private, alias := reservedLoginFixture(t)
+	if err := os.Remove(alias); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(alias, []byte(`{"type":"codex"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	w := &Watcher{authDir: dir, config: &config.Config{AuthDir: dir}, authQueue: make(chan AuthUpdate, 8)}
+	w.addOrUpdateClient(alias)
+	if w.currentAuths["private-alias.json"] == nil {
+		t.Fatal("normal file was not initially loaded")
+	}
+	if err := os.Remove(alias); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(private, alias); err != nil {
+		t.Fatal(err)
+	}
+	w.handleEvent(fsnotify.Event{Name: alias, Op: fsnotify.Create})
+	if w.currentAuths["private-alias.json"] != nil || len(w.lastAuthHashes) != 0 {
+		t.Fatal("private replacement retained cached identity")
+	}
+	update := w.pendingUpdates["private-alias.json"]
+	if update.Action != AuthUpdateActionDelete || update.IsFileRemoval() {
+		t.Fatalf("unexpected private replacement update: %+v", update)
+	}
+	if _, err := os.Stat(private); err != nil {
+		t.Fatalf("private runtime file changed: %v", err)
+	}
+}
+
+func TestReservedLoginDirectoryWithLiveWatcher(t *testing.T) {
+	dir, private, alias := reservedLoginFixture(t)
+	configPath := filepath.Join(t.TempDir(), "config.yaml")
+	if err := os.WriteFile(configPath, []byte("auth-dir: "+dir+"\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	w, err := NewWatcher(configPath, dir, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.SetConfig(&config.Config{AuthDir: dir})
+	updates := make(chan AuthUpdate, 32)
+	w.SetAuthUpdateQueue(updates)
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(func() {
+		cancel()
+		if err := w.Stop(); err != nil {
+			t.Error(err)
+		}
+	})
+	if err := w.Start(ctx); err != nil {
+		t.Fatal(err)
+	}
+	waitFor := func(id string) {
+		t.Helper()
+		deadline := time.NewTimer(5 * time.Second)
+		defer deadline.Stop()
+		for {
+			select {
+			case update := <-updates:
+				if update.ID != "normal.json" && update.ID != "sentinel.json" {
+					t.Fatalf("private auth emitted by live watcher: %q", update.ID)
+				}
+				if update.ID == id {
+					return
+				}
+			case <-deadline.C:
+				t.Fatalf("live watcher did not emit %s", id)
+			}
+		}
+	}
+	waitFor("normal.json")
+	if err := os.WriteFile(private, []byte(`{"type":"codex","email":"updated@example.test"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(alias); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(private, alias); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "sentinel.json"), []byte(`{"type":"codex"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	waitFor("sentinel.json")
+	// Exercise the exact event after the live watcher has processed a normal file.
+	w.handleEvent(fsnotify.Event{Name: alias, Op: fsnotify.Write})
+	w.clientsMutex.RLock()
+	defer w.clientsMutex.RUnlock()
+	if len(w.currentAuths) != 2 || w.currentAuths["private-alias.json"] != nil {
+		t.Fatal("private runtime file leaked into live watcher state")
+	}
+}
