+	}}
+	s := offlineService(t, opts)
+	account := bindOfflineAccount(t, s)
+	terminalOfflineFailure(t, opts.Manager, account.AuthID)
+	enableOfflineAccountRepair(t, s, account)
+	interactive.Store(true)
+	auto := runDueOfflineAccount(t, s, account.ID)
+	waitLogin(t, s, auto.LastJobID, "interaction_required")
+	accounts, err := s.Accounts()
+	if err != nil || !accounts[0].AttentionRequired || accounts[0].ConsecutiveFailures != 1 {
