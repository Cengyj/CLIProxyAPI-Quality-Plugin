+type metadataRuntimeFixture struct {
+	offlineRuntime
+	capabilityErr error
+	metadataErr   error
+	metadataCalls int
+}
+
+func (r *metadataRuntimeFixture) Capabilities() error { return r.capabilityErr }
+func (r *metadataRuntimeFixture) Metadata() (map[string]string, error) {
+	r.metadataCalls++
+	return map[string]string{"engine": "unverified-fixture"}, r.metadataErr
+}
+
+func TestServiceCapabilitiesReportsVerifiedRuntimeMetadata(t *testing.T) {
+	for _, scenario := range []string{"native", "legacy", "without_metadata", "invalid_bundle", "unavailable", "metadata_error"} {
+		t.Run(scenario, func(t *testing.T) {
+			opts := offlineOptions(t)
+			var expected map[string]string
+			var stub *metadataRuntimeFixture
+			available, reason := true, ""
+			switch scenario {
+			case "native", "invalid_bundle":
+				r, root := nativeRuntimeFixture(t, successScript)
+				opts.Runtime = r
+				if scenario == "native" {
+					expected = map[string]string{"engine": "go_sobek_protocol", "runtime_version": "2.0.0", "schema_version": "2"}
+				} else {
+					if err := os.WriteFile(filepath.Join(root, "bin", "login-runtime"), []byte("changed"), 0700); err != nil {
+						t.Fatal(err)
+					}
+					available, reason = false, "runtime_invalid"
+				}
+			case "legacy":
+				r, _ := runtimeFixture(t, successScript)
+				opts.Runtime = r
+				expected = map[string]string{"engine": "official_browser_forms", "runtime_version": "1.0.0", "schema_version": "1"}
+			case "unavailable", "metadata_error":
+				stub = &metadataRuntimeFixture{}
+				if scenario == "unavailable" {
+					stub.capabilityErr = runtimeError("runtime_unavailable")
+					available, reason = false, "runtime_unavailable"
+				} else {
+					stub.metadataErr = runtimeError("runtime_invalid")
+				}
+				opts.Runtime = stub
+			}
+			s := offlineService(t, opts)
+			capabilities := s.Capabilities()
+			raw, err := Encode(capabilities)
+			if err != nil {
+				t.Fatal(err)
+			}
+			result := ojson.ParseBytes(raw)
+			if !result.Get("available").Bool() || !result.Get("methods.browser.available").Bool() || result.Get("methods.password_totp.available").Bool() != available || result.Get("methods.password_totp.reason").String() != reason {
+				t.Fatal("runtime availability changed the wrong capability or lost its reason")
+			}
+			metadata, exists := capabilities.(map[string]any)["runtime"]
+			if expected == nil {
+				if exists {
+					t.Fatal("capabilities advertised unverified runtime metadata")
+				}
+			} else if !exists || !reflect.DeepEqual(metadata, expected) {
+				t.Fatal("capabilities did not report exactly the verified runtime identity")
+			}
+			if stub != nil {
+				calls := 1
+				if scenario == "unavailable" {
+					calls = 0
+				}
+				if stub.metadataCalls != calls {
+					t.Fatal("runtime metadata was read before its capability verification succeeded")
+				}
+			}
+		})
+	}
+}
