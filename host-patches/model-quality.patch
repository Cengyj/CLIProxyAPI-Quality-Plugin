new file mode 100644
index 0000000..483e830
--- /dev/null
+++ b/sdk/cliproxy/auth/credential_login.go
@@ -0,0 +1,501 @@
+package auth
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/MoeForge/moego/base64"
+	"github.com/MoeForge/moego/ojson"
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/codex"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+)
+
+// LoginPrincipal binds a login to a stable OpenAI account and user, including its workspace.
+// Claims must come from the host's trusted token exchange; parsing is not signature verification.
+type LoginPrincipal struct {
+	AccountID string `json:"account_id"`
+	UserID    string `json:"user_id"`
+	Email     string `json:"email"`
+}
+
+func (p LoginPrincipal) Key() string { return loginHash(p.AccountID, p.UserID) }
+
+// LoginPrincipalFromAuth rejects missing or contradictory token identity claims.
+func LoginPrincipalFromAuth(a *Auth) (LoginPrincipal, error) {
+	var p LoginPrincipal
+	if a == nil || a.Provider != "codex" {
+		return p, errors.New("identity_unverifiable")
+	}
+	var fallbackSub string
+	for _, key := range []string{"id_token", "access_token"} {
+		token := authMetadataString(a, key)
+		parts := strings.Split(token, ".")
+		if len(parts) != 3 {
+			return p, errors.New("identity_unverifiable")
+		}
+		raw, err := base64.RawURLEncoding.DecodeString(parts[1])
+		if err != nil || !ojson.ValidBytes(raw) {
+			return p, errors.New("identity_unverifiable")
+		}
+		claims := ojson.ParseBytes(raw)
+		authInfo := claims.Get("https://api\\.openai\\.com/auth")
+		account := authInfo.Get("chatgpt_account_id").String()
+		user := authInfo.Get("chatgpt_user_id").String()
+		if user == "" {
+			user = authInfo.Get("user_id").String()
+		}
+		email := strings.ToLower(strings.TrimSpace(claims.Get("email").String()))
+		if email == "" {
+			email = strings.ToLower(strings.TrimSpace(claims.Get("https://api\\.openai\\.com/profile.email").String()))
+		}
+		for _, pair := range []struct {
+			dst   *string
+			value string
+		}{{&p.AccountID, account}, {&p.UserID, user}, {&p.Email, email}} {
+			if pair.value == "" {
+				continue
+			}
+			if *pair.dst != "" && *pair.dst != pair.value {
+				return LoginPrincipal{}, errors.New("identity_conflict")
+			}
+			*pair.dst = pair.value
+		}
+		if key == "id_token" {
+			fallbackSub = claims.Get("sub").String()
+		}
+	}
+	if p.UserID == "" {
+		p.UserID = fallbackSub
+	}
+	if p.AccountID == "" || p.UserID == "" {
+		return LoginPrincipal{}, errors.New("identity_unverifiable")
+	}
+	if account := authMetadataString(a, "account_id"); account != "" && account != p.AccountID {
+		return LoginPrincipal{}, errors.New("identity_conflict")
+	}
+	if email := strings.ToLower(authMetadataString(a, "email")); email != "" && p.Email != "" && email != p.Email {
+		return LoginPrincipal{}, errors.New("identity_conflict")
+	}
+	return p, nil
+}
+
+// LoginSnapshot is a sanitized CAS token captured before acquiring new authorization.
+type LoginSnapshot struct {
+	AuthID                string `json:"auth_id"`
+	IdentityVersion       string `json:"identity_version"`
+	RegistrationEpoch     uint64 `json:"registration_epoch"`
+	PolicyFingerprint     string `json:"policy_fingerprint"`
+	Principal             string `json:"principal"`
+	DiskPolicyFingerprint string `json:"disk_policy_fingerprint"`
+}
+
+// LoginCommitRequest contains an in-memory candidate from the host token exchange.
+// Prepare must stop dependent quality work. Adopt synchronizes host registries without
+// calling ordinary Manager credential mutations; the pending fence remains active.
+type LoginCommitRequest struct {
+	CommitID  string
+	Candidate *Auth
+	Expected  LoginSnapshot
+	// ExpectedFailureFingerprint requires unchanged eligible authentication
+	// failure evidence for an automatic reauthorization. Empty means manual.
+	ExpectedFailureFingerprint string
+	// AutoConsentGuard performs an atomic-only consent check before a durable
+	// intent and immediately before writing. It must not acquire locks or call
+	// Manager methods because the credential mutation gate is held.
+	AutoConsentGuard func() error
+	Prepare          func(context.Context, string, string) error
+	Adopt            func(context.Context, *Auth) error
+}
+
+// LoginCommitResult reports durable adoption, independently of credential availability.
+type LoginCommitResult struct {
+	CommitID        string `json:"commit_id"`
+	AuthID          string `json:"auth_id"`
+	IdentityVersion string `json:"identity_version"`
+	Principal       string `json:"principal"`
+	State           string `json:"state"`
+}
+
+// LoginFileStore identifies the standalone, local file store supported by login commits.
+// Remote stores must not implement this capability based on a local cache directory.
+type LoginFileStore interface{ LoginFileStoreRoot() string }
+
+func loginHash(values ...string) string {
+	h := sha256.New()
+	for _, value := range values {
+		_, _ = h.Write([]byte(value))
+		_, _ = h.Write([]byte{0})
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+func (m *Manager) loginRoot() (string, error) {
+	if m == nil || m.HomeEnabled() {
+		return "", errors.New("home_controlled")
+	}
+	m.mu.RLock()
+	store := m.store
+	m.mu.RUnlock()
+	fileStore, ok := store.(LoginFileStore)
+	if !ok {
+		return "", errors.New("unsupported_login_store")
+	}
+	root, err := filepath.EvalSymlinks(fileStore.LoginFileStoreRoot())
+	if err != nil {
+		return "", errors.New("login_auth_directory_unavailable")
+	}
+	root, err = filepath.Abs(root)
+	if err != nil {
+		return "", err
+	}
+	if IsReservedAuthPath(root) {
+		return "", errors.New("unsupported_login_store")
+	}
+	cfg, _ := m.runtimeConfig.Load().(*config.Config)
+	if cfg == nil {
+		return "", errors.New("login_auth_directory_unavailable")
+	}
+	configured, err := filepath.EvalSymlinks(cfg.AuthDir)
+	if err != nil {
+		return "", errors.New("login_auth_directory_unavailable")
+	}
+	configured, err = filepath.Abs(configured)
+	if err != nil || root != configured {
+		return "", errors.New("login_store_directory_conflict")
+	}
+	return root, nil
+}
+
+func (m *Manager) loginTargetPath(a *Auth) (string, error) {
+	root, err := m.loginRoot()
+	if err != nil {
+		return "", err
+	}
+	if a == nil || a.Provider != "codex" || a.AuthKind() != AuthKindOAuth || a.AuthSourceKind() != AuthSourceFile {
+		return "", errors.New("unsupported_login_target")
+	}
+	if IsPluginVirtualAuth(a) || a.Attributes["runtime_only"] == "true" || a.Attributes["source_parent_id"] != "" || a.Attributes["plugin_id"] != "" {
+		return "", errors.New("unsupported_login_target")
+	}
+	path, err := m.codexBindingPath(a)
+	if err != nil || IsReservedAuthPath(path) {
+		return "", errors.New("unsupported_login_target")
+	}
+	rel, err := filepath.Rel(root, path)
+	if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return "", errors.New("unsupported_login_target")
+	}
+	return path, nil
+}
+
+// LoginSnapshot captures both durable identity and explicit operator policies.
+func (m *Manager) LoginSnapshot(id string) (LoginSnapshot, error) {
+	release, err := m.lockAuthMutationContext(context.Background(), id)
+	if err != nil {
+		return LoginSnapshot{}, err
+	}
+	defer release()
+	return m.loginSnapshotLocked(id)
+}
+
+func (m *Manager) loginSnapshotLocked(id string) (LoginSnapshot, error) {
+	a, ok := m.GetByID(id)
+	if !ok {
+		return LoginSnapshot{}, errors.New("credential_deleted")
+	}
+	path, err := m.loginTargetPath(a)
+	if err != nil {
+		return LoginSnapshot{}, err
+	}
+	p, err := LoginPrincipalFromAuth(a)
+	if err != nil {
+		return LoginSnapshot{}, err
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil || !ojson.ValidBytes(raw) {
+		return LoginSnapshot{}, errors.New("login_source_unavailable")
+	}
+	diskMetadata, ok := ojson.ParseBytes(raw).Value().(map[string]any)
+	if !ok || loginGrant(&Auth{Provider: "codex", Metadata: diskMetadata}) != loginGrant(a) {
+		return LoginSnapshot{}, errors.New("login_source_conflict")
+	}
+
+	q := m.quality.Load()
+	if q == nil {
+		return LoginSnapshot{}, errors.New("quality_authority_unavailable")
+	}
+	q.mu.RLock()
+	defer q.mu.RUnlock()
+	identity := q.identities[id]
+	if q.closed || q.fault != nil || identity.Deleted || identity.Version == "" {
+		return LoginSnapshot{}, errors.New("quality_identity_unavailable")
+	}
+	pauses := []string{}
+	for _, pause := range q.actions {
+		if pause.AuthID == id {
+			pauses = append(pauses, loginHash(pause.OwnerPlugin, pause.RuleID, pause.ActionID, pause.IdentityVersion, fmtLoginUint(pause.RuleRevision), fmtLoginUint(pause.ActionRevision)))
+		}
+	}
+	sort.Strings(pauses)
+	globalProxy := ""
+	if cfg, ok := m.runtimeConfig.Load().(*config.Config); ok && cfg != nil {
+		globalProxy = cfg.ProxyURL
+	}
+	policy := loginHash(path, a.Provider, p.Key(), fmtLoginBool(a.Disabled), fmtLoginBool(qualityOperatorDisabled(a)), a.ProxyURL, globalProxy, a.Prefix, strings.Join(pauses, ","), loginDiskPolicy(raw))
+	return LoginSnapshot{AuthID: id, IdentityVersion: identity.Version, RegistrationEpoch: a.RegistrationEpoch, PolicyFingerprint: policy, Principal: p.Key(), DiskPolicyFingerprint: loginDiskPolicy(raw)}, nil
+}
+
+// CommitLoginCandidate persists before publishing and keeps failed adoption fenced.
+func (m *Manager) CommitLoginCandidate(ctx context.Context, req LoginCommitRequest) (LoginCommitResult, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if m == nil || req.Candidate == nil || req.CommitID == "" || len(req.CommitID) > 128 {
+		return LoginCommitResult{}, errors.New("invalid_login_commit")
+	}
+	m.loginCommitMu.Lock()
+	defer m.loginCommitMu.Unlock()
+	candidate := req.Candidate.Clone()
+	principal, err := LoginPrincipalFromAuth(candidate)
+	if err != nil {
+		return LoginCommitResult{}, err
+	}
+	if candidate.ID == "" || authMetadataString(candidate, "refresh_token") == "" {
+		return LoginCommitResult{}, errors.New("invalid_login_candidate")
+	}
+	id := candidate.ID
+	if req.Expected.AuthID != "" && req.Expected.AuthID != id {
+		return LoginCommitResult{}, errors.New("identity_conflict")
+	}
+	if old, found := m.loginIntent(req.CommitID); found {
+		if old.AuthID != id || old.CandidateGrant != loginGrant(candidate) || old.Principal != principal.Key() {
+			return LoginCommitResult{}, errors.New("commit_id_conflict")
+		}
+		return old.result(), nil
+	}
+	root, err := m.loginRoot()
+	if err != nil {
+		return LoginCommitResult{}, err
+	}
+	release, err := m.lockAuthMutationContext(ctx, id)
+	if err != nil {
+		return LoginCommitResult{}, err
+	}
+	defer func() { release() }()
+	var base *Auth
+	var path string
+	isNew := req.Expected.AuthID == ""
+	if isNew {
+		if _, exists := m.GetByID(id); exists {
+			return LoginCommitResult{}, errors.New("credential_exists")
+		}
+		if filepath.Base(id) != id || id == "." || !strings.HasSuffix(id, ".json") || candidate.FileName != id {
+			return LoginCommitResult{}, errors.New("invalid_login_filename")
+		}
+		path = filepath.Join(root, id)
+		if _, err = os.Lstat(path); !os.IsNotExist(err) {
+			return LoginCommitResult{}, errors.New("credential_exists")
+		}
+	} else {
+		snapshot, errSnapshot := m.loginSnapshotLocked(id)
+		if errSnapshot != nil {
+			return LoginCommitResult{}, errSnapshot
+		}
+		if snapshot != req.Expected || snapshot.Principal != principal.Key() {
+			return LoginCommitResult{}, errors.New("login_snapshot_conflict")
+		}
+		base, _ = m.GetByID(id)
+		path, err = m.loginTargetPath(base)
+		if err != nil {
+			return LoginCommitResult{}, err
+		}
+	}
+	if !isNew && loginGrant(base) == loginGrant(candidate) {
+		return LoginCommitResult{}, errors.New("login_candidate_unchanged")
+	}
+	if req.ExpectedFailureFingerprint != "" {
+		if isNew {
+			return LoginCommitResult{}, errors.New("policy_changed")
+		}
+		if err = m.checkAutomaticLoginHealthLocked(id, "", req.ExpectedFailureFingerprint); err != nil {
+			return LoginCommitResult{}, err
+		}
+	}
+	if req.AutoConsentGuard != nil && req.AutoConsentGuard() != nil {
+		return LoginCommitResult{}, errors.New("automation_disabled")
+	}
+	// Serialize imports and reauth commits and reject aliases of the same principal.
+	for _, a := range m.List() {
+		if !isNew || a.ID == id || a.Provider != "codex" {
+			continue
+		}
+		existing, errPrincipal := LoginPrincipalFromAuth(a)
+		if errPrincipal == nil && existing.Key() == principal.Key() {
+			return LoginCommitResult{}, errors.New("duplicate_identity")
+		}
+		// Incomplete legacy claims cannot justify creating an alias that could
+		// bypass a restriction on the same known account/workspace.
+		if errPrincipal != nil && authMetadataString(a, "account_id") == principal.AccountID {
+			return LoginCommitResult{}, errors.New("identity_unverifiable")
+		}
+	}
+	q := m.quality.Load()
+	if q == nil {
+		return LoginCommitResult{}, errors.New("quality_authority_unavailable")
+	}
+	q.mu.RLock()
+	duplicatePending := false
+	for _, pending := range q.loginCommits {
+		if pending.pending() && pending.AuthID != id && pending.Principal == principal.Key() {
+			duplicatePending = true
+		}
+	}
+	q.mu.RUnlock()
+	if duplicatePending {
+		return LoginCommitResult{}, errors.New("duplicate_identity")
+	}
+	intent := loginCommitIntent{CommitID: req.CommitID, AuthID: id, Principal: principal.Key(), Path: path, IsNew: isNew, OldIdentity: req.Expected.IdentityVersion, NextIdentity: uuid.NewString(), CandidateGrant: loginGrant(candidate), OldGrant: loginGrant(base), Policy: req.Expected, State: "committing", CreatedAt: time.Now().UTC()}
+	if err = m.loginSaveIntent(intent); err != nil {
+		return LoginCommitResult{}, err
+	}
+	release()
+	release = func() {}
+	if req.Prepare != nil {
+		if err = req.Prepare(ctx, id, req.Expected.IdentityVersion); err != nil {
+			return m.loginAbort(intent, "login_prepare_failed")
+		}
+	} else if !isNew {
+		return m.loginAbort(intent, "login_prepare_required")
+	}
+	release, err = m.lockAuthMutationWithPersistCancel(ctx, id, nil)
+	if err != nil {
+		return m.loginAbort(intent, "login_cancelled")
+	}
+	if !isNew {
+		snapshot, errSnapshot := m.loginSnapshotLocked(id)
+		if errSnapshot != nil || snapshot != req.Expected {
+			return m.loginAbort(intent, "login_snapshot_conflict")
+		}
+		base, _ = m.GetByID(id)
+	}
+	if err = m.checkAutomaticLoginHealthLocked(id, req.CommitID, req.ExpectedFailureFingerprint); err != nil {
+		return m.loginAbort(intent, "policy_changed")
+	}
+	var disk map[string]any
+	saved := false
+	consentRevoked := false
+	err = codex.WithFileLock(path, func() error {
+		if errCtx := ctx.Err(); errCtx != nil {
+			return errCtx
+		}
+		raw, errRead := os.ReadFile(path)
+		if isNew {
+			if !os.IsNotExist(errRead) {
+				return errors.New("login_source_conflict")
+			}
+			raw = []byte(`{}`)
+		} else {
+			if errRead != nil || !ojson.ValidBytes(raw) {
+				return errors.New("login_source_conflict")
+			}
+			checked, errPath := m.loginTargetPath(base)
+			if errPath != nil || checked != path {
+				return errors.New("login_source_conflict")
+			}
+			diskMetadata, ok := ojson.ParseBytes(raw).Value().(map[string]any)
+			if !ok {
+				return errors.New("login_source_conflict")
+			}
+			oldDisk := &Auth{Provider: "codex", Metadata: diskMetadata}
+			if loginGrant(oldDisk) != loginGrant(base) || loginDiskPolicy(raw) != req.Expected.DiskPolicyFingerprint {
+				return errors.New("login_source_conflict")
+			}
+		}
+		doc := ojson.NewDoc(raw)
+		for _, key := range loginCredentialKeys {
+			value, exists := candidate.Metadata[key]
+			if !exists {
+				if errDelete := doc.Delete(key); errDelete != nil {
+					return errDelete
+				}
+				continue
+			}
+			if errSet := doc.Set(key, value); errSet != nil {
+				return errSet
+			}
+		}
+		if errSet := doc.Set("type", "codex"); errSet != nil {
+			return errSet
+		}
+		if isNew {
+			if errSet := doc.Set("disabled", true); errSet != nil {
+				return errSet
+			}
+		}
+		output := doc.Bytes()
+		parsed, ok := ojson.ParseBytes(output).Value().(map[string]any)
+		if !ok {
+			return errors.New("invalid_login_candidate")
+		}
+		disk = parsed
+		writer := m.loginWriteFile
+		if writer == nil {
+			writer = writeLoginFileAtomic
+		}
+		if req.AutoConsentGuard != nil && req.AutoConsentGuard() != nil {
+			consentRevoked = true
+			return errors.New("automation_disabled")
+		}
+		renamed, errWrite := writer(path, output, isNew)
+		saved = renamed
+		return errWrite
+	})
+	if err != nil {
+		if !saved {
+			if consentRevoked {
+				return m.loginAbort(intent, "automation_disabled")
+			}
+			return m.loginAbort(intent, "login_persist_failed")
+		}
+		intent.State = "commit_unknown"
+		_ = m.loginSaveIntent(intent)
+		return intent.result(), errors.New("login_persist_unknown")
+	}
+	intent.State = "saved_not_adopted"
+	if err = m.loginSaveIntent(intent); err != nil {
+		return intent.result(), err
+	}
+	committed, err := m.loginPublish(intent, disk)
+	if err != nil {
+		return intent.result(), err
+	}
+	release()
+	release = func() {}
+	m.loginNotify(ctx, committed, isNew)
+	if req.Adopt != nil {
+		if err = req.Adopt(ctx, committed.Clone()); err != nil {
+			return intent.result(), errors.New("login_adoption_failed")
+		}
+	}
+	intent.State = "committed"
+	if err = m.loginSaveIntent(intent); err != nil {
+		intent.State = "saved_not_adopted"
+		return intent.result(), err
+	}
+	return intent.result(), nil
+}
+
+func loginGrant(a *Auth) string {
+	if a == nil {
+		return ""
+	}
+	return a.Provider + ":" + AuthGrantFingerprint(a)
+}
diff --git a/sdk/cliproxy/auth/credential_login_guard.go b/sdk/cliproxy/auth/credential_login_guard.go
new file mode 100644
index 0000000..1480f07
--- /dev/null
+++ b/sdk/cliproxy/auth/credential_login_guard.go
@@ -0,0 +1,117 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+)
+
+// WithLoginFileMutation serializes a direct management file write with login
+// commits. The callback may only perform file/store I/O and manager reads; it
+// must not call manager mutations or Load while these credential gates are held.
+func (m *Manager) WithLoginFileMutation(ctx context.Context, path string, write func() error) error {
+	if m == nil || m.quality.Load() == nil {
+		return write()
+	}
+	absolute, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	ids := map[string]bool{filepath.Base(absolute): true}
+	if root, errRoot := m.loginRoot(); errRoot == nil {
+		if relative, errRel := filepath.Rel(root, absolute); errRel == nil && !strings.HasPrefix(relative, "..") {
+			ids[relative] = true
+		}
+	}
+	for _, a := range m.List() {
+		candidate := authAttribute(a, "path")
+		if candidate == "" {
+			candidate = authAttribute(a, "source")
+		}
+		if candidate == "" {
+			candidate = a.FileName
+		}
+		if candidate != "" {
+			if resolved, errPath := filepath.Abs(candidate); errPath == nil && resolved == absolute {
+				ids[a.ID] = true
+			}
+		}
+	}
+	q := m.quality.Load()
+	if q != nil {
+		q.mu.RLock()
+		for _, intent := range q.loginCommits {
+			if intent.Path == absolute && intent.pending() {
+				ids[intent.AuthID] = true
+			}
+		}
+		q.mu.RUnlock()
+	}
+	ordered := make([]string, 0, len(ids))
+	for id := range ids {
+		ordered = append(ordered, id)
+	}
+	sort.Strings(ordered)
+	releases := []func(){}
+	defer func() {
+		for i := len(releases) - 1; i >= 0; i-- {
+			releases[i]()
+		}
+	}()
+	for _, id := range ordered {
+		release, errLock := m.lockAuthMutationContext(ctx, id)
+		if errLock != nil {
+			return errLock
+		}
+		releases = append(releases, release)
+	}
+	return write()
+}
+
+// LoginCapability reports whether the durable standalone commit authority is ready.
+func (m *Manager) LoginCapability() error {
+	if _, err := m.loginRoot(); err != nil {
+		return err
+	}
+	q := m.quality.Load()
+	if q == nil {
+		return errors.New("quality_authority_unavailable")
+	}
+	q.mu.RLock()
+	defer q.mu.RUnlock()
+	if q.closed || q.fault != nil {
+		return errors.New("quality_authority_unavailable")
+	}
+	return nil
+}
+
+// SyncLoginRegistryState projects existing restrictions into the new local model
+// catalog. It never changes auth/model cooldown state or drops historical models.
+func (m *Manager) SyncLoginRegistryState(id string, epoch uint64) error {
+	release, err := m.lockAuthMutationWithPersistCancel(context.Background(), id, nil)
+	if err != nil {
+		return err
+	}
+	defer release()
+	a, ok := m.GetByID(id)
+	if !ok || a.RegistrationEpoch != epoch {
+		return errors.New("login_adoption_conflict")
+	}
+	global := registry.GetGlobalRegistry()
+	models, registryEpoch := global.GetModelsAndEpochForClient(id)
+	projections := make([]registry.ClientModelProjection, 0, len(models))
+	now := time.Now()
+	for _, model := range models {
+		if model != nil {
+			projections = append(projections, m.clientModelProjectionForAuth(a, model.ID, now))
+		}
+	}
+	global.ApplyClientModelProjections(id, registryEpoch, a.Generation, projections)
+	m.RefreshSchedulerEntry(id)
+	return nil
+}
diff --git a/sdk/cliproxy/auth/credential_login_health.go b/sdk/cliproxy/auth/credential_login_health.go
new file mode 100644
index 0000000..94c1dcd
--- /dev/null
+++ b/sdk/cliproxy/auth/credential_login_health.go
@@ -0,0 +1,178 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"time"
+)
+
+// LoginHealth reports observed local CPA state; it never probes an upstream.
+// EffectiveAvailable describes current admission only, not account validity.
+type LoginHealth struct {
+	AuthID             string        `json:"auth_id"`
+	Exists             bool          `json:"exists"`
+	Status             string        `json:"status"`
+	Reason             string        `json:"reason,omitempty"`
+	AuthFailureReason  string        `json:"auth_failure_reason,omitempty"`
+	RequiresReauth     bool          `json:"requires_reauth"`
+	Fingerprint        string        `json:"fingerprint,omitempty"`
+	FailureObservedAt  time.Time     `json:"failure_observed_at,omitempty"`
+	ManualDisabled     bool          `json:"manual_disabled"`
+	QualityPaused      bool          `json:"quality_paused"`
+	Cooldown           bool          `json:"cooldown"`
+	EffectiveAvailable bool          `json:"effective_available"`
+	CanUpdate          bool          `json:"can_update"`
+	AutoEligible       bool          `json:"auto_eligible"`
+	IdentityVersion    string        `json:"identity_version,omitempty"`
+	Principal          string        `json:"principal,omitempty"`
+	Snapshot           LoginSnapshot `json:"-"`
+}
+
+// LoginHealth serializes its snapshot with credential writes and quality policy
+// changes. Runtime error observations may be absent after restart; that means
+// unknown health, not evidence that an upstream account is healthy.
+func (m *Manager) LoginHealth(id string) (LoginHealth, error) {
+	if m == nil {
+		return LoginHealth{}, errors.New("quality_authority_unavailable")
+	}
+	if id == "" || len(id) > 8192 {
+		return LoginHealth{}, errors.New("invalid_request")
+	}
+	release, err := m.lockAuthMutationWithPersistCancel(context.Background(), id, nil)
+	if err != nil {
+		return LoginHealth{}, err
+	}
+	defer release()
+	return m.loginHealthLocked(id, "", time.Now()), nil
+}
+
+// loginHealthLocked requires the credential mutation gate. A commit may ignore
+// only its own durable fence when rechecking evidence before the file write.
+func (m *Manager) loginHealthLocked(id, ownCommit string, now time.Time) LoginHealth {
+	h := LoginHealth{AuthID: id, Status: "missing", Reason: "credential_deleted"}
+	a, exists := m.GetByID(id)
+	if !exists || a == nil {
+		return h
+	}
+	h.Exists = true
+	h.ManualDisabled = qualityOperatorDisabled(a)
+	h.Cooldown = loginHealthCooldown(a, now)
+	h.AuthFailureReason = loginHealthFailure(a)
+	h.RequiresReauth = h.AuthFailureReason != ""
+	if h.RequiresReauth {
+		grant := a.AdoptedGrantHash
+		if grant == "" {
+			grant = AuthGrantFingerprint(a)
+		}
+		// Exclude generations and modification times: repeated observations and
+		// unrelated quota/status updates must not renew an automatic retry budget.
+		h.Fingerprint = loginHash("login-health-v1", id, grant, "authentication_required")
+		// UpdatedAt can change for unrelated reasons and is not a failure time.
+		h.FailureObservedAt = a.RenewalEventAt
+	}
+	q := m.quality.Load()
+	pending := false
+	if q == nil {
+		h.Status, h.Reason, h.CanUpdate = "unknown", "quality_authority_unavailable", false
+		return h
+	}
+	q.mu.RLock()
+	for _, pause := range q.actions {
+		if pause.AuthID == id {
+			h.QualityPaused = true
+			break
+		}
+	}
+	for commitID, commit := range q.loginCommits {
+		if commit.AuthID == id && commit.pending() && commitID != ownCommit {
+			pending = true
+			break
+		}
+	}
+	q.mu.RUnlock()
+	snapshot, err := m.loginSnapshotLocked(id)
+	if err != nil {
+		h.Status, h.Reason = "unknown", loginHealthSafeReason(err)
+		return h
+	}
+	h.Snapshot = snapshot
+	h.IdentityVersion, h.Principal = snapshot.IdentityVersion, snapshot.Principal
+	h.CanUpdate = true
+	h.Status, h.Reason = "unknown", "no_auth_failure_observed"
+	switch {
+	case pending:
+		h.Status, h.Reason, h.CanUpdate = "pending", "credential_login_pending", false
+	case h.QualityPaused:
+		h.Status, h.Reason = "paused", "quality_paused"
+	case h.ManualDisabled:
+		h.Status, h.Reason = "disabled", "manual_disabled"
+	case h.Cooldown:
+		h.Status, h.Reason = "cooldown", "native_cooldown"
+	case a.NextRefreshAfter.After(now):
+		h.Status, h.Reason = "refresh_pending", "native_refresh_pending"
+	case h.RequiresReauth:
+		h.Status, h.Reason = "needs_reauth", h.AuthFailureReason
+		h.AutoEligible = h.AuthFailureReason != "refresh_outcome_unknown" && h.AuthFailureReason != "siwc_sign_in_required"
+	case a.Unavailable:
+		h.Status, h.Reason = "unavailable", "native_unavailable"
+	default:
+		h.EffectiveAvailable = true
+	}
+	return h
+}
+
+func loginHealthCooldown(a *Auth, now time.Time) bool {
+	if a.NextRetryAfter.After(now) || a.Quota.NextRecoverAt.After(now) ||
+		(a.Quota.Exceeded && a.Quota.NextRecoverAt.IsZero()) ||
+		a.forceCooldownUntil.After(now) || a.credQuotaForceUntil.After(now) {
+		return true
+	}
+	for _, state := range a.ModelStates {
+		if isModelStateActiveCooldown(state, now) {
+			return true
+		}
+	}
+	return false
+}
+
+func loginHealthFailure(a *Auth) string {
+	if a.RequiresSignIn {
+		if a.RefreshError != nil && a.RefreshError.Code == "refresh_outcome_unknown" {
+			return "refresh_outcome_unknown"
+		}
+		if a.RejectedSIWCRefreshToken != "" && a.RejectedRefreshToken == "" {
+			return "siwc_sign_in_required"
+		}
+		return "requires_sign_in"
+	}
+	// LastError is also populated by model-scoped failures. Only CPA's
+	// terminal auth-level condition is evidence for automatic reauthorization.
+	if hasUnauthorizedAuthFailure(a) && !shouldSkipCredentialCooldown(a.LastError) {
+		return "unauthorized"
+	}
+	if (a.RefreshError != nil && isInvalidGrantResultError(a.RefreshError) || hasDisabledInvalidGrantFailure(a)) &&
+		a.NextRefreshAfter.IsZero() {
+		return "invalid_grant"
+	}
+	return ""
+}
+
+func loginHealthSafeReason(err error) string {
+	switch err.Error() {
+	case "home_controlled", "unsupported_login_target", "unsupported_login_store", "identity_unverifiable", "identity_conflict", "quality_authority_unavailable", "quality_identity_unavailable", "login_source_conflict", "login_source_unavailable":
+		return err.Error()
+	default:
+		return "login_target_unavailable"
+	}
+}
+
+func (m *Manager) checkAutomaticLoginHealthLocked(id, ownCommit, expected string) error {
+	if expected == "" {
+		return nil
+	}
+	h := m.loginHealthLocked(id, ownCommit, time.Now())
+	if !h.AutoEligible || h.Fingerprint != expected {
+		return errors.New("policy_changed")
+	}
+	return nil
+}
diff --git a/sdk/cliproxy/auth/credential_login_health_test.go b/sdk/cliproxy/auth/credential_login_health_test.go
new file mode 100644
index 0000000..ca04e97
--- /dev/null
+++ b/sdk/cliproxy/auth/credential_login_health_test.go
@@ -0,0 +1,276 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
