+func TestNativeRuntimeEnforcesStreamIdentityAndLimits(t *testing.T) {
+	for _, scenario := range []struct{ name, script, code string }{
+		{"wrong_identity", "printf '%s\\n' '" + strings.ReplaceAll(progressSuccess, `"fixture"`, `"other"`) + "'\n", "runtime_protocol_error"},
+		{"stdout_limit", "head -c 65537 /dev/zero\n", "runtime_protocol_error"},
+		{"stderr_limit", "head -c 65537 /dev/zero >&2\n", "runtime_protocol_error"},
+		{"error_without_identity", "printf '%s\\n' '{\"version\":1,\"error_code\":\"password_rejected\"}'\n", "runtime_protocol_error"},
+		{"fixed_error", "printf '%s\\n' '{\"version\":1,\"job_id\":\"fixture\",\"attempt\":1,\"error_code\":\"password_rejected\",\"error_stage\":\"password\",\"error_reason\":\"upstream_rejected\"}'\nexit 1\n", "credentials_rejected"},
+		{"runtime_start_error", "printf '%s\\n' '{\"version\":1,\"job_id\":\"fixture\",\"attempt\":1,\"error_code\":\"runtime_unavailable\",\"error_stage\":\"runtime_start\"}'\nexit 1\n", "runtime_unavailable"},
+		{"duplicate_final", "printf '%s\\n' '" + progressSuccess + "' '" + progressSuccess + "'\n", "runtime_protocol_error"},
