+}
+
+func TestQualityReleaseScopeRejectsClosedInstanceAndCancelledRequest(t *testing.T) {
+	for _, name := range []string{"closed_instance", "cancelled_request"} {
+		t.Run(name, func(t *testing.T) {
+			h := New()
+			instance := &hostCallbackInstance{}
+			ctx := withHostCallbackIdentity(context.Background(), "model-quality", instance)
+			requestCtx, cancel := context.WithCancel(ctx)
+			defer cancel()
+			action := coreauth.QualityPause{RuleID: "rule", ActionID: "action", ActionRevision: 1}
+			scoped := withManualQualityReleaseScope(requestCtx, "model-quality", pluginapi.ManagementRequest{
+				Method: "POST", Path: "/v8/management/plugins/model-quality/actions/release",
+				Body: []byte(`{"rule_id":"rule","action_id":"action","action_revision":1}`),
