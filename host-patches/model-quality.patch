 // executor that further configures its helper's transport must apply Decorate
 // once, after its own protocol/pool policy is complete.
 func WithoutDecorator(ctx context.Context) context.Context {
-	return WithDecorator(ctx, nil)
+	return context.WithValue(WithDecorator(ctx, nil), decorationSuppressedKey{}, true)
 }
 
 // InheritDecorator copies a decorator from fallback into ctx when ctx does not
@@ -41,6 +41,11 @@ func InheritDecorator(ctx, fallback context.Context) context.Context {
 	if fallback == nil {
 		return ctx
 	}
+	if _, hasCheck := ctx.Value(admissionKey{}).(func() error); !hasCheck {
+		if check, ok := fallback.Value(admissionKey{}).(func() error); ok {
+			ctx = WithAdmission(ctx, check)
+		}
+	}
 	if _, ok := ctx.Value(decoratorKey{}).(Decorator); ok {
 		return ctx
 	}
@@ -53,7 +58,8 @@ func InheritDecorator(ctx, fallback context.Context) context.Context {
 // Decorate applies a context decorator AFTER transport selection. With no
 // decorator, the exact original client is returned. Only the client value is
 // copied; the original selected transport/pool and all client policy survive.
-func Decorate(ctx context.Context, client *http.Client) *http.Client {
+func Decorate(ctx context.Context, client *http.Client) (result *http.Client) {
+	defer func() { result = decorateAdmission(ctx, result) }()
 	if ctx == nil || client == nil {
 		return client
 	}
