+		out.arguments = []string{filepath.Join(out.root, "worker.mjs")}
+		out.progress = version == "1.2.0" || version == "1.2.1" || version == "1.2.2"
+		required = []string{"bin/node", "worker.mjs", "core.mjs", "totp.mjs", "process-scope.mjs", "package.json", "package-lock.json", "node_modules/playwright-core/package.json"}
