+func TestReservedLoginFilesNeverSynthesizeAuths(t *testing.T) {
+	dir := t.TempDir()
+	privateDir := filepath.Join(dir, ".credential-login", "runtime")
+	if err := os.MkdirAll(privateDir, 0700); err != nil {
+		t.Fatal(err)
