+	"time"
+
+	"github.com/MoeForge/moego/base64"
+	"github.com/MoeForge/moego/ojson"
+	internalconfig "github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	sdkauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/auth"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestCredentialLoginAdoptionDoesNotRewriteAuthOrClearCooldown(t *testing.T) {
+	root := t.TempDir()
+	store := sdkauth.NewFileTokenStore()
+	store.SetBaseDir(root)
+	manager := coreauth.NewManager(store, nil, nil)
+	cfg := &internalconfig.Config{AuthDir: root}
+	manager.SetConfigSnapshot(cfg)
+	if err := manager.OpenQualityState(filepath.Join(root, "quality.db")); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = manager.CloseQualityState() })
+	claims := ojson.NewDoc(nil)
+	_ = claims.Set("https://api\\.openai\\.com/auth", map[string]string{"chatgpt_account_id": "offline-account", "chatgpt_user_id": "offline-user"})
+	_ = claims.Set("email", "offline@example.test")
+	token := "e30." + base64.RawURLEncoding.EncodeToString(claims.Bytes()) + ".offline"
+	candidate := &coreauth.Auth{ID: "login-adopt.json", FileName: "login-adopt.json", Provider: "codex", Metadata: map[string]any{"type": "codex", "access_token": token, "id_token": token, "refresh_token": "offline-refresh", "account_id": "offline-account", "email": "offline@example.test", "plan_type": "plus"}}
+	service := &Service{cfg: cfg, coreManager: manager}
+	var adoptedEpoch uint64
+	result, err := manager.CommitLoginCandidate(context.Background(), coreauth.LoginCommitRequest{CommitID: "import-adopt", Candidate: candidate, Adopt: func(ctx context.Context, a *coreauth.Auth) error {
+		adoptedEpoch = a.RegistrationEpoch
+		if !manager.LoginPending(a.ID) {
+			t.Error("adoption missing fence")
+		}
+		return service.credentialLoginAdoptHook()(ctx, a)
+	}})
+	if err != nil || result.State != "committed" {
+		t.Fatalf("adopt failed %+v %v", result, err)
+	}
+	imported, _ := manager.GetByID(candidate.ID)
+	if !imported.Disabled || imported.RegistrationEpoch != adoptedEpoch || imported.InferenceVerified {
+		t.Fatal("adoption replaced credential or enabled inference")
+	}
+	if len(GlobalModelRegistry().GetModelsForClient(candidate.ID)) != 0 {
+		t.Fatal("disabled import registered runnable models")
+	}
+	// A reauthorization may be enabled but cooling; the registry must reflect the
+	// same restriction while the old, no-longer-catalogued model state survives.
+	active, _, err := manager.Modify(context.Background(), candidate.ID, adoptedEpoch, func(a *coreauth.Auth) error { a.Disabled = false; a.Status = coreauth.StatusActive; return nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	snapshot, err := manager.LoginSnapshot(candidate.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	active.Unavailable = true
+	active.Quota = coreauth.QuotaState{Exceeded: true, NextRecoverAt: time.Now().Add(time.Hour)}
+	active.ModelStates = map[string]*coreauth.ModelState{"historical-model": {Unavailable: true, NextRetryAfter: time.Now().Add(time.Hour)}}
+	if _, err = manager.Update(context.Background(), active); err != nil {
+		t.Fatal(err)
+	}
+	candidate.Metadata["refresh_token"] = "offline-next-refresh"
+	result, err = manager.CommitLoginCandidate(context.Background(), coreauth.LoginCommitRequest{CommitID: "reauth-adopt", Candidate: candidate, Expected: snapshot, Prepare: func(context.Context, string, string) error { return nil }, Adopt: service.credentialLoginAdoptHook()})
+	if err != nil || result.State != "committed" {
+		t.Fatalf("reauth adopt failed %+v %v", result, err)
+	}
+	got, _ := manager.GetByID(candidate.ID)
+	if !got.Quota.Exceeded || !got.Unavailable || got.ModelStates["historical-model"] == nil {
+		t.Fatal("model registration cleared preserved restrictions")
+	}
+	if len(GlobalModelRegistry().GetModelsForClient(candidate.ID)) == 0 {
+		t.Fatal("enabled reauth failed local catalog registration")
+	}
+	t.Cleanup(func() { GlobalModelRegistry().UnregisterClient(candidate.ID) })
+}
